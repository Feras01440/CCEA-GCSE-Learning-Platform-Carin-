  "examinerRules": [
    { "id": "sci.leaflet.ar-from-leaflet", "text": "Take every relative atomic mass from the leaflet's Periodic Table (Cl = 35.5, Cu = 64, Fe = 56); Mr is the sum, with bracketed groups multiplied out (Mg(NO3)2 = 24 + 2 x (14 + 48) = 148). A wrong Ar loses the Mr mark but later steps are carried forward.", "source": "Summer 2025 C1 H Chief Examiner report Q6(a) (bracket errors in Mg(NO3)2), Q6(b)(i) (Ar of iron not doubled); packs/science/exam-true/mark-language.json sci.chem.data-leaflet" },
    { "id": "sci.leaflet.ions-for-formulae", "text": "Formulae of salts come from the ion table: balance the charges (Cu2+ with 2 OH- gives Cu(OH)2; NH4+ with SO4 2- gives (NH4)2SO4). Simple ions not in the table follow the group number: Group 1 +1, Group 2 +2, Group 3 +3, Group 6 -2, Group 7 -1.", "source": "research 03 section 7.3 (Summer 2025 C1 F: formulae of salts wrong when the leaflet was not used); Summer 2023 C1 F/H Q1(a)(iii) (ion with a double negative charge)" },
    { "id": "sci.leaflet.solubility-for-precipitates", "text": "Use the solubility rules to predict precipitates and to choose a preparation route: an insoluble salt (lead iodide, barium sulfate, most carbonates) forms by precipitation; a soluble salt by acid + base/carbonate/metal and crystallisation.", "source": "leaflet solubility table; spec C1 section 1.8 (salts) via data/spec/double-award-science.json" },
    { "id": "sci.leaflet.not-a-formula-sheet", "text": "The leaflet gives no acids, no covalent molecules, no reactivity series and no equations: H2SO4, HNO3, CH4, NH3, the diatomic elements (H2, O2, N2, Cl2, Br2, I2) and the reactivity series must be recalled.", "source": "leaflet contents (absence); Summer 2025 C2 F Chief Examiner report (diatomic elements forgotten); packs/science/exam-true/physics-equations.json chemistryRecallEquations" }
  ]
