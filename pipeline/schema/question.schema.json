{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "title": "Question",
  "$ref": "#/$defs/Question",
  "$defs": {
    "Question": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/QuestionId"
        },
        "topic": {
          "$ref": "#/$defs/TopicId"
        },
        "specRefs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecRef"
          }
        },
        "paper": {
          "$ref": "#/$defs/PaperContext"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "style": {
          "type": "string",
          "enum": [
            "practice",
            "exam-style"
          ]
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty"
        },
        "ao": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AO[1-9]$"
          }
        },
        "commandWords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "emphasis": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": "object",
          "properties": {
            "setting": {
              "type": "string",
              "minLength": 1
            },
            "original": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "setting",
            "original"
          ],
          "additionalProperties": false
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FigureSpec"
          }
        },
        "parts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "totalMarks": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeAllowanceSec": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "skeleton": {
          "type": "string",
          "minLength": 1
        },
        "methodLock": {
          "type": "object",
          "properties": {
            "instruction": {
              "type": "string",
              "minLength": 1
            },
            "requiredMethod": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "#/$defs/ExaminerSource"
            }
          },
          "required": [
            "instruction",
            "requiredMethod",
            "evidence"
          ],
          "additionalProperties": false
        },
        "examinerSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExaminerSource"
          }
        },
        "solutionProgram": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "$ref": "#/$defs/VerificationRef"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "topic",
        "specRefs",
        "paper",
        "tier",
        "style",
        "difficulty",
        "ao",
        "commandWords",
        "emphasis",
        "context",
        "figures",
        "parts",
        "totalMarks",
        "timeAllowanceSec",
        "skeleton",
        "examinerSources",
        "verification",
        "version"
      ],
      "additionalProperties": false,
      "description": "Original exam-style or practice question with a CCEA-language mark scheme"
    },
    "QuestionId": {
      "type": "string",
      "pattern": "^q\\.[a-z0-9][a-z0-9.-]*$"
    },
    "TopicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9]+\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Teachable-topic id \"<subject>.<unit>.<slug>\", e.g. \"maths.m4.histograms\""
    },
    "SpecRef": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,4}(-[A-Za-z0-9.]+){1,3}$",
      "description": "Learning-outcome statement id from data/spec/*.json"
    },
    "PaperContext": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "pattern": "^[A-Z]{0,3}[0-9]{1,2}$"
        },
        "paper": {
          "type": "number",
          "enum": [
            1,
            2
          ]
        },
        "calculator": {
          "type": "boolean"
        },
        "bookletB": {
          "type": "boolean"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "unit",
        "calculator",
        "resources"
      ],
      "additionalProperties": false,
      "description": "Which paper the item imitates: unit, paper 1/2, calculator, Booklet B, resources allowed"
    },
    "Tier": {
      "type": "string",
      "enum": [
        "F",
        "H",
        "both",
        "untiered"
      ]
    },
    "Difficulty": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "1 routine … 5 A*/A discriminator"
    },
    "FigureSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svg-gen"
            },
            "generator": {
              "type": "string",
              "enum": [
                "histogram",
                "cf-curve",
                "box-plot",
                "bar",
                "pie",
                "scatter",
                "table",
                "number-line",
                "axes"
              ]
            },
            "data": {},
            "options": {}
          },
          "required": [
            "kind",
            "generator",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "jsxgraph"
            },
            "script": {
              "type": "string",
              "minLength": 1
            },
            "static": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "script",
            "static"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mafs"
            },
            "component": {
              "type": "string",
              "minLength": 1
            },
            "props": {}
          },
          "required": [
            "kind",
            "component",
            "props"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svg"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "photo"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "licence": {
              "type": "string",
              "minLength": 1
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "src",
            "alt",
            "licence",
            "credit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "apparatus"
            },
            "parts": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "style": {
              "type": "string",
              "const": "ccea-2d"
            }
          },
          "required": [
            "kind",
            "parts",
            "style"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Part": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(main|[a-z]{1,2}(\\([ivx]{1,4}\\))?)$"
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "answer": {
          "$ref": "#/$defs/AnswerSpec"
        },
        "scheme": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarkPoint"
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workedSolution": {
          "type": "string",
          "minLength": 1
        },
        "commonErrors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommonError"
          }
        },
        "requiresWorking": {
          "type": "boolean"
        },
        "followThrough": {
          "type": "object",
          "properties": {
            "fromPart": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "enum": [
                "use-candidate-value",
                "use-candidate-diagram"
              ]
            }
          },
          "required": [
            "fromPart",
            "rule"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "stem",
        "marks",
        "answer",
        "scheme",
        "hints",
        "workedSolution",
        "commonErrors",
        "requiresWorking"
      ],
      "additionalProperties": false
    },
    "AnswerSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "numeric"
            },
            "value": {
              "type": "number"
            },
            "tolerance": {
              "$ref": "#/$defs/Tolerance"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unitRequired": {
              "type": "boolean"
            },
            "acceptForms": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "decimal",
                  "fraction",
                  "mixed",
                  "surd",
                  "pi",
                  "percent",
                  "standardForm",
                  "ratio"
                ]
              }
            },
            "mustBeSimplified": {
              "type": "boolean"
            },
            "moneyFormat": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value",
            "tolerance",
            "unitRequired",
            "acceptForms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "algebraic"
            },
            "latex": {
              "type": "string",
              "minLength": 1
            },
            "equivalence": {
              "type": "string",
              "enum": [
                "identical",
                "equivalent",
                "simplifiedOnly"
              ]
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "domain": {
              "type": "string"
            },
            "form": {
              "$ref": "#/$defs/AlgebraForm"
            },
            "tolerance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mustBeFactorised": {
              "type": "boolean"
            },
            "mustBeExpanded": {
              "type": "boolean"
            },
            "keepInequalitySign": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "latex",
            "equivalence",
            "variables"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcq"
            },
            "options": {
              "minItems": 2,
              "type": "array",
              "items": {
                "$ref": "#/$defs/McqOption"
              }
            },
            "shuffle": {
              "type": "boolean"
            },
            "multi": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "options",
            "shuffle"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "accepted": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "keyWords": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "any": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "marks": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reject": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "any",
                  "marks"
                ],
                "additionalProperties": false
              }
            },
            "listingRule": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "accepted",
            "keyWords",
            "listingRule"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text-long"
            },
            "rubricId": {
              "type": "string",
              "minLength": 1
            },
            "bands": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "band": {
                    "type": "string",
                    "minLength": 1
                  },
                  "marks": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "descriptor": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "band",
                  "marks",
                  "descriptor"
                ],
                "additionalProperties": false
              }
            },
            "indicativeContent": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "point": {
                    "type": "string",
                    "minLength": 1
                  },
                  "keyWords": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "point",
                  "keyWords"
                ],
                "additionalProperties": false
              }
            },
            "selfMark": {
              "type": "boolean",
              "const": true
            },
            "aiMark": {
              "type": "boolean"
            },
            "minWords": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "rubricId",
            "bands",
            "indicativeContent",
            "selfMark"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "graph"
            },
            "expect": {
              "$ref": "#/$defs/GraphExpectation"
            }
          },
          "required": [
            "kind",
            "expect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "drawing"
            },
            "rubric": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "selfMark": {
              "type": "boolean",
              "const": true
            },
            "aiMark": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "rubric",
            "selfMark"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "table"
            },
            "cells": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "col": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "value": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "tolerance": {
                    "$ref": "#/$defs/Tolerance"
                  }
                },
                "required": [
                  "row",
                  "col",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "cells"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "matrix"
            },
            "rows": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cols": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "entries": {
              "minItems": 1,
              "type": "array",
              "items": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "tolerance": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "absolute"
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "rows",
            "cols",
            "entries"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "equation"
            },
            "kindOf": {
              "type": "string",
              "enum": [
                "word",
                "symbol",
                "ionic",
                "half",
                "nuclear",
                "physics"
              ]
            },
            "balancedLatex": {
              "type": "string",
              "minLength": 1
            },
            "stateSymbolsRequired": {
              "type": "boolean"
            },
            "acceptMultiples": {
              "type": "boolean"
            },
            "registryId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "kindOf",
            "balancedLatex",
            "stateSymbolsRequired",
            "acceptMultiples"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "steps"
            },
            "expectedOrder": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowSkips": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "kind",
            "expectedOrder",
            "allowSkips"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "label"
            },
            "targets": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accepted": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "position": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down",
                      "left",
                      "right",
                      "normal",
                      "along"
                    ]
                  }
                },
                "required": [
                  "id",
                  "accepted"
                ],
                "additionalProperties": false
              }
            },
            "bank": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "targets",
            "bank"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "order"
            },
            "items": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "correctOrder": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "required": [
            "kind",
            "items",
            "correctOrder"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "annotation"
            },
            "spans": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "to": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "from",
                  "to",
                  "tag"
                ],
                "additionalProperties": false
              }
            },
            "tags": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "minCorrect": {
              "type": "integer",
