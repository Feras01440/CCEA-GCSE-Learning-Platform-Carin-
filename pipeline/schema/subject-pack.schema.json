{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subject-pack.schema.json",
  "title": "SubjectPack",
  "$ref": "#/$defs/SubjectPack",
  "$defs": {
    "SubjectPack": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "$ref": "#/$defs/SubjectId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "cceaQualificationId": {
          "type": "string",
          "minLength": 1
        },
        "subjectCode": {
          "type": "string",
          "minLength": 1
        },
        "gradeScale": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "units": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z]{0,3}[0-9]{1,2}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "$ref": "#/$defs/Tier"
              },
              "weighting": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "umsMax": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "umsScale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "papers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minutes": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "marks": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "calculator": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "resources": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "name",
                    "minutes",
                    "marks",
                    "calculator",
                    "resources"
                  ],
                  "additionalProperties": false
                }
              },
              "prerequisiteUnits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{0,3}[0-9]{1,2}$"
                }
              },
              "series": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "November",
                    "March",
                    "Summer"
                  ]
                }
              }
            },
            "required": [
              "code",
              "title",
              "tier",
              "weighting",
              "umsMax",
              "umsScale",
              "papers",
              "prerequisiteUnits",
              "series"
            ],
            "additionalProperties": false
          }
        },
        "strands": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "markLanguage": {
          "$ref": "#/$defs/MarkLanguageProfile"
        },
        "itemTypes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemTypeId"
          }
        },
        "answerKinds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnswerKind"
          }
        },
        "commandWordsFile": {
          "type": "string",
          "minLength": 1
        },
        "tariffsFile": {
          "type": "string",
          "minLength": 1
        },
        "formulaSheetsFile": {
          "type": "string",
          "minLength": 1
        },
        "methodLocksFile": {
          "type": "string",
          "minLength": 1
        },
        "qwcBandsFile": {
          "type": "string",
          "minLength": 1
        },
        "rubricsFile": {
          "type": "string",
          "minLength": 1
        },
        "externalProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "licenceNote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "label",
              "licenceNote"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "title",
        "cceaQualificationId",
        "subjectCode",
        "gradeScale",
        "units",
        "strands",
        "markLanguage",
        "itemTypes",
        "answerKinds",
        "commandWordsFile",
        "tariffsFile",
        "externalProviders"
      ],
      "additionalProperties": false,
      "description": "packs/<subject>/pack.json — the qualification as data: units, papers, tiers, UMS, strands, mark language, item types"
    },
    "SubjectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Subject pack id: \"maths\" | \"further-maths\" | \"science\" | \"english-language\" | \"english-literature\" | another kebab-case id"
    },
    "Tier": {
      "type": "string",
      "enum": [
        "F",
        "H",
        "both",
        "untiered"
      ]
    },
    "MarkLanguageProfile": {
      "type": "object",
      "properties": {
        "codes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}$"
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "dependsOnMethod": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "meaning"
            ],
            "additionalProperties": false
          }
        },
        "followThrough": {
          "type": "boolean"
        },
        "positiveMarking": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "feedbackTemplates": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "codes",
        "followThrough",
        "positiveMarking",
        "rules",
        "feedbackTemplates"
      ],
      "additionalProperties": false,
      "description": "The subject's mark codes (M/A/MA, M/W/MW, P/QWC, L), follow-through and positive-marking flags, marking rules in our words"
    },
    "ItemTypeId": {
      "type": "string",
      "enum": [
        "note",
        "we",
        "dx",
        "q",
        "ftm",
        "rp",
        "ins",
        "prac",
        "eq",
        "qwc",
        "set",
        "mock",
        "ew",
        "ann"
      ]
    },
    "AnswerKind": {
      "type": "string",
      "enum": [
        "numeric",
        "algebraic",
        "mcq",
        "text",
        "text-long",
        "graph",
        "drawing",
        "table",
        "matrix",
        "equation",
        "steps",
        "label",
        "order",
        "annotation"
      ]
    }
  }
}
