{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "note-frontmatter.schema.json",
  "title": "NoteFrontmatter",
  "$ref": "#/$defs/NoteFrontmatter",
  "$defs": {
    "NoteFrontmatter": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NoteId"
        },
        "topic": {
          "$ref": "#/$defs/TopicId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/SubjectId"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{0,3}[0-9]{1,2}$"
            },
            {
              "type": "string",
              "const": "practicals"
            }
          ]
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "specRefs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecRef"
          }
        },
        "calculator": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "P1-no/P2-yes"
            }
          ]
        },
        "formulaSheet": {
          "type": "object",
          "properties": {
            "given": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mustKnow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "given",
            "mustKnow"
          ],
          "additionalProperties": false
        },
        "notOnThisSpec": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hardness": {
          "$ref": "#/$defs/Hardness"
        },
        "examinerFlagged": {
          "type": "boolean"
        },
        "externalRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalRef"
          }
        },
        "sheet": {
          "type": "object",
          "properties": {
            "mustBeAbleTo": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "howExamined": {
              "type": "string",
              "minLength": 1
            },
            "traps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "mustBeAbleTo",
            "howExamined",
            "traps"
          ],
          "additionalProperties": false
        },
        "verification": {
          "$ref": "#/$defs/VerificationRef"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "updated": {
          "$ref": "#/$defs/IsoDateLike"
        }
      },
      "required": [
        "id",
        "topic",
        "title",
        "subject",
        "unit",
        "tier",
        "specRefs",
        "calculator",
        "formulaSheet",
        "notOnThisSpec",
        "hardness",
        "examinerFlagged",
        "externalRefs",
        "sheet",
        "verification",
        "version",
        "updated"
      ],
      "additionalProperties": false,
      "description": "Frontmatter of note.mdx: the Sheet (must-be-able-to, how examined, traps), formula-sheet split, scope limits"
    },
    "NoteId": {
      "type": "string",
      "pattern": "^note\\.[a-z0-9][a-z0-9.-]*$"
    },
    "TopicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9]+\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Teachable-topic id \"<subject>.<unit>.<slug>\", e.g. \"maths.m4.histograms\""
    },
    "SubjectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Subject pack id: \"maths\" | \"further-maths\" | \"science\" | \"english-language\" | \"english-literature\" | another kebab-case id"
    },
    "Tier": {
      "type": "string",
      "enum": [
        "F",
        "H",
        "both",
        "untiered"
      ]
    },
    "SpecRef": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,4}(-[A-Za-z0-9.]+){1,3}$",
      "description": "Learning-outcome statement id from data/spec/*.json"
    },
    "Hardness": {
      "type": "string",
      "enum": [
        "L",
        "S",
        "H"
      ],
      "description": "Bundle size: L lite, S standard, H hard (examiner-flagged)"
    },
    "ExternalRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "corbettmaths"
            },
            "videos": {
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "playlistId": {
              "type": "string",
              "minLength": 1
            },
            "practiceUrl": {
              "type": "string",
              "format": "uri"
            },
            "textbookUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "kind",
            "videos"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bitesize"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "articleId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "youtube"
            },
            "videoId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{6,}$"
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "promptId": {
                    "$ref": "#/$defs/RetrievalPromptId"
                  }
                },
                "required": [
                  "at",
                  "promptId"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "videoId",
            "channel",
            "credit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ccea-doc"
            },
            "docType": {
              "type": "string",
              "enum": [
                "spec",
                "teacher-guidance",
                "factfile",
                "glossary",
                "practical-manual",
                "qa-booklet",
                "data-leaflet",
                "cer",
                "pastpaper",
                "markscheme"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "page": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "asOf": {
              "$ref": "#/$defs/IsoDateLike"
            }
          },
          "required": [
            "kind",
            "docType",
            "url",
            "asOf"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "phet"
            },
            "sim": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "licence": {
              "type": "string",
              "enum": [
                "CC BY 4.0 (pre-2026-03-29)",
                "CC BY-NC 4.0"
              ]
            },
            "attribution": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "sim",
            "url",
            "licence",
            "attribution"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "geogebra"
            },
            "materialId": {
              "type": "string",
              "minLength": 1
            },
            "attribution": {
              "type": "string",
              "const": "Made with GeoGebra®"
            }
          },
          "required": [
            "kind",
            "materialId",
            "attribution"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pastpaper-question"
            },
            "paperId": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "paperId",
            "question",
            "page"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Outbound link to Corbettmaths, Bitesize, YouTube, a CCEA document, PhET, GeoGebra or a past-paper question (metadata only)"
    },
    "RetrievalPromptId": {
      "type": "string",
      "pattern": "^rp\\.[a-z0-9][a-z0-9.-]*$"
    },
    "IsoDateLike": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "string",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d))|(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?)$"
        }
      ],
      "description": "ISO 8601 date (2026-09-05) or date-time (2026-09-05T10:00:00Z)"
    },
    "VerificationRef": {
      "type": "string",
      "pattern": "^ver\\.[a-z0-9][a-z0-9.-]*$",
      "description": "Id of the item's VerificationLog"
    }
  }
}
