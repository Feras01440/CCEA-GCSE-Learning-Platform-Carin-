{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "note-blocks.schema.json",
  "title": "NoteBlocks",
  "$ref": "#/$defs/NoteBlocks",
  "$defs": {
    "NoteBlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NoteBlock"
      },
      "description": "note.blocks.json: the lesson in blocks (headings, prose, callouts, figures, See it, gates, prompts)"
    },
    "NoteBlock": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "hero"
                },
                "lede": {
                  "type": "string"
                },
                "can": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "minutes": {
                  "type": "number"
                },
                "short": {
                  "type": "string"
                },
                "generated": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "lede",
                "can",
                "minutes"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "pause"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "p"
                },
                "md": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "md"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "h"
                },
                "text": {
                  "type": "string"
                },
                "role": {
                  "$ref": "#/$defs/HeadingRole"
                }
              },
              "required": [
                "type",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "gate"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "blank",
                    "choice",
                    "number"
                  ]
                },
                "prompt": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "answer": {
                  "type": "string"
                },
                "explain": {
                  "type": "string"
                },
                "twin": {
                  "$ref": "#/$defs/GateTwin"
                },
                "optionNotes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/GateOptionNote"
                  }
                }
              },
              "required": [
                "type",
                "id",
                "kind",
                "prompt",
                "answer",
                "explain"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "callout"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "spec",
                    "mustknow",
                    "notonspec",
                    "examiner",
                    "why"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "md": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "kind",
                "md"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "figure"
                },
                "alt": {
                  "type": "string"
                },
                "svg": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "alt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "photo"
                },
                "src": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "credit": {
                  "type": "string"
                },
                "licence": {
                  "type": "string"
                },
                "licenceUrl": {
                  "type": "string"
                },
                "sourceUrl": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "src",
                "alt",
                "credit",
                "licence"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "video"
                },
                "videoId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "channel": {
                  "type": "string"
                },
                "start": {
                  "type": "number"
                },
                "end": {
                  "type": "number"
                },
                "why": {
                  "type": "string"
                },
                "corbettmathsNumber": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "videoId",
                "title",
                "channel"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "sim"
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "phet",
                    "geogebra"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "attribution": {
                  "type": "string"
                },
                "licence": {
                  "type": "string"
                },
                "task": {
                  "type": "string"
                },
                "height": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "provider",
                "url",
                "title",
                "attribution",
                "licence"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "prompt"
                },
                "promptId": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "promptId"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "anyOf": [
            {
              "$ref": "#/$defs/SeeBlockInline"
            },
            {
              "$ref": "#/$defs/SeeBlockReference"
            }
          ]
        }
      ],
      "description": "One block of note.blocks.json"
    },
    "HeadingRole": {
      "type": "string",
      "enum": [
        "idea",
        "why",
        "variant",
        "see",
        "twists",
        "further",
        "derivation",
        "recap",
        "pointer"
      ],
      "description": "What a section does in the lesson; a heading with role `see` continues the section above it"
    },
    "GateTwin": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "pattern": "\\S"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": "string",
          "pattern": "\\S"
        },
        "explain": {
          "type": "string",
          "pattern": "\\S"
        },
        "optionNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateOptionNote"
          }
        }
      },
      "required": [
        "prompt",
        "answer",
        "explain"
      ],
      "additionalProperties": false,
      "description": "The same question on new numbers, asked once before the recap when the gate was missed; never recorded"
    },
    "GateOptionNote": {
      "type": "object",
      "properties": {
        "option": {
          "type": "string",
          "pattern": "\\S"
        },
        "why": {
          "type": "string",
          "pattern": "\\S"
        },
        "misconception": {
          "$ref": "#/$defs/MisconceptionId"
        }
      },
      "required": [
        "option",
        "why"
      ],
      "additionalProperties": false,
      "description": "A choice gate's note on one wrong option: why it is wrong, shown when she picks it"
    },
    "MisconceptionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "SeeBlockInline": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "see"
        },
        "stem": {
          "type": "string",
          "pattern": "\\S"
        },
        "figure": {
          "$ref": "#/$defs/FigureSpec"
        },
        "steps": {
          "minItems": 2,
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkedExampleStep"
          }
        },
        "finalAnswer": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/SeeKind"
        },
        "workedExample": {
          "not": {}
        }
      },
      "required": [
        "type",
        "stem",
        "steps"
      ],
      "additionalProperties": false,
      "description": "A See it: the example's stem and two to six worked steps, each with its reason and the mark it earns"
    },
    "FigureSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svg-gen"
            },
            "generator": {
              "type": "string",
              "enum": [
                "histogram",
                "cf-curve",
                "box-plot",
                "bar",
                "pie",
                "scatter",
                "table",
                "number-line",
                "axes"
              ]
            },
            "data": {},
            "options": {}
          },
          "required": [
            "kind",
            "generator",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "jsxgraph"
            },
            "script": {
              "type": "string",
              "minLength": 1
            },
            "static": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "script",
            "static"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mafs"
            },
            "component": {
              "type": "string",
              "minLength": 1
            },
            "props": {}
          },
          "required": [
            "kind",
            "component",
            "props"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svg"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "photo"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "licence": {
              "type": "string",
              "minLength": 1
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "src",
            "alt",
            "licence",
            "credit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "apparatus"
            },
            "parts": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "style": {
              "type": "string",
              "const": "ccea-2d"
            }
          },
          "required": [
            "kind",
            "parts",
            "style"
          ],
          "additionalProperties": false
        }
      ]
    },
    "WorkedExampleStep": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "working": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "whyMenu": {
          "type": "object",
          "properties": {
            "options": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "correct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "explain": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "options",
            "correct",
            "explain"
          ],
          "additionalProperties": false
        },
        "earns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}\\d?$"
          }
        },
        "input": {
          "$ref": "#/$defs/AnswerSpec"
        }
      },
      "required": [
        "n",
        "working",
        "decision"
      ],
      "additionalProperties": false
    },
    "AnswerSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "numeric"
            },
            "value": {
              "type": "number"
            },
            "tolerance": {
              "$ref": "#/$defs/Tolerance"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unitRequired": {
              "type": "boolean"
            },
            "acceptForms": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "decimal",
                  "fraction",
                  "mixed",
                  "surd",
                  "pi",
                  "percent",
                  "standardForm",
                  "ratio"
                ]
              }
            },
            "mustBeSimplified": {
              "type": "boolean"
            },
            "moneyFormat": {
              "type": "boolean"
            },
            "formTask": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value",
            "tolerance",
            "unitRequired",
            "acceptForms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "algebraic"
            },
            "latex": {
              "type": "string",
              "minLength": 1
            },
            "equivalence": {
              "type": "string",
              "enum": [
                "identical",
                "equivalent",
                "simplifiedOnly"
              ]
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "domain": {
              "type": "string"
            },
            "form": {
              "$ref": "#/$defs/AlgebraForm"
            },
            "tolerance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mustBeFactorised": {
              "type": "boolean"
            },
            "mustBeExpanded": {
              "type": "boolean"
            },
            "keepInequalitySign": {
              "type": "boolean"
            },
            "formTask": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "latex",
            "equivalence",
            "variables"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcq"
            },
            "options": {
              "minItems": 2,
              "type": "array",
              "items": {
                "$ref": "#/$defs/McqOption"
              }
            },
            "shuffle": {
              "type": "boolean"
            },
            "multi": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "options",
            "shuffle"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "accepted": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "keyWords": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "any": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "marks": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reject": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "any",
                  "marks"
                ],
                "additionalProperties": false
              }
            },
            "listingRule": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "accepted",
            "keyWords",
            "listingRule"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text-long"
            },
            "rubricId": {
              "type": "string",
              "minLength": 1
            },
            "bands": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "band": {
                    "type": "string",
                    "minLength": 1
                  },
                  "marks": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "descriptor": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "band",
                  "marks",
                  "descriptor"
                ],
                "additionalProperties": false
              }
            },
            "indicativeContent": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "point": {
                    "type": "string",
                    "minLength": 1
                  },
                  "keyWords": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "point",
                  "keyWords"
                ],
                "additionalProperties": false
              }
            },
            "selfMark": {
              "type": "boolean",
              "const": true
            },
            "aiMark": {
              "type": "boolean"
            },
            "minWords": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "rubricId",
            "bands",
            "indicativeContent",
            "selfMark"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "graph"
            },
            "expect": {
              "$ref": "#/$defs/GraphExpectation"
            }
          },
          "required": [
            "kind",
            "expect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "drawing"
            },
            "rubric": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "selfMark": {
              "type": "boolean",
              "const": true
            },
            "aiMark": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "rubric",
            "selfMark"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "table"
            },
            "cells": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "col": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "value": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "tolerance": {
                    "$ref": "#/$defs/Tolerance"
                  }
                },
                "required": [
                  "row",
                  "col",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "cells"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "matrix"
            },
            "rows": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cols": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "entries": {
              "minItems": 1,
              "type": "array",
              "items": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "tolerance": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "absolute"
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "rows",
            "cols",
            "entries"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "equation"
            },
            "kindOf": {
              "type": "string",
              "enum": [
                "word",
                "symbol",
