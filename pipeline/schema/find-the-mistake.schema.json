{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "find-the-mistake.schema.json",
  "title": "FindTheMistake",
  "$ref": "#/$defs/FindTheMistake",
  "$defs": {
    "FindTheMistake": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/FindTheMistakeId"
        },
        "topic": {
          "$ref": "#/$defs/TopicId"
        },
        "specRefs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecRef"
          }
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "studentWorking": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mistakeLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "misconception": {
          "$ref": "#/$defs/MisconceptionId"
        },
        "whatWentWrong": {
          "type": "string",
          "minLength": 1
        },
        "correction": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "marksEarnedAsWritten": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}\\d?$"
          }
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/ExaminerSource"
        }
      },
      "required": [
        "id",
        "topic",
        "specRefs",
        "stem",
        "studentWorking",
        "mistakeLine",
        "misconception",
        "whatWentWrong",
        "correction",
        "marksEarnedAsWritten",
        "feedback",
        "source"
      ],
      "additionalProperties": false,
      "description": "Plausible wrong working seeded from an examiner report: locate, name, fix"
    },
    "FindTheMistakeId": {
      "type": "string",
      "pattern": "^ftm\\.[a-z0-9][a-z0-9.-]*$"
    },
    "TopicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9]+\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Teachable-topic id \"<subject>.<unit>.<slug>\", e.g. \"maths.m4.histograms\""
    },
    "SpecRef": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,4}(-[A-Za-z0-9.]+){1,3}$",
      "description": "Learning-outcome statement id from data/spec/*.json"
    },
    "MisconceptionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "ExaminerSource": {
      "type": "string",
      "pattern": "^ccea-cer:[a-z][a-z0-9-]*:\\d{4}-(?:summer|november|march|january):[A-Za-z0-9]+:Q\\d{1,2}(?:[a-z]|\\([a-z]\\))?(?:\\([ivx]{1,4}\\))?$",
      "description": "Chief Examiner report citation: ccea-cer:<subject>:<yyyy>-<series>:<unit>:Q<n>"
    }
  }
}
