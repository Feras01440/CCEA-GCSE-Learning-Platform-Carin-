{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrieval-prompt.schema.json",
  "title": "RetrievalPrompt",
  "$ref": "#/$defs/RetrievalPrompt",
  "$defs": {
    "RetrievalPrompt": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RetrievalPromptId"
        },
        "topic": {
          "$ref": "#/$defs/TopicId"
        },
        "specRefs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecRef"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "qa",
            "cloze",
            "formula",
            "definition",
            "procedure",
            "trap",
            "label-diagram",
            "novel-example",
            "quotation"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "keyWords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "image": {
          "$ref": "#/$defs/FigureSpec"
        },
        "examUnit": {
          "type": "string",
          "pattern": "^[A-Z]{0,3}[0-9]{1,2}$"
        },
        "difficultyPrior": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "id",
        "topic",
        "specRefs",
        "kind",
        "prompt",
        "answer"
      ],
      "additionalProperties": false,
      "description": "Atomic retrieval prompt scheduled by FSRS towards the unit's paper date"
    },
    "RetrievalPromptId": {
      "type": "string",
      "pattern": "^rp\\.[a-z0-9][a-z0-9.-]*$"
    },
    "TopicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9]+\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Teachable-topic id \"<subject>.<unit>.<slug>\", e.g. \"maths.m4.histograms\""
    },
    "SpecRef": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,4}(-[A-Za-z0-9.]+){1,3}$",
      "description": "Learning-outcome statement id from data/spec/*.json"
    },
    "FigureSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svg-gen"
            },
            "generator": {
              "type": "string",
              "enum": [
                "histogram",
                "cf-curve",
                "box-plot",
                "bar",
                "pie",
                "scatter",
                "table",
                "number-line",
                "axes"
              ]
            },
            "data": {},
            "options": {}
          },
          "required": [
            "kind",
            "generator",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "jsxgraph"
            },
            "script": {
              "type": "string",
              "minLength": 1
            },
            "static": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "script",
            "static"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mafs"
            },
            "component": {
              "type": "string",
              "minLength": 1
            },
            "props": {}
          },
          "required": [
            "kind",
            "component",
            "props"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "svg"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "photo"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "licence": {
              "type": "string",
              "minLength": 1
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "src",
            "alt",
            "licence",
            "credit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "apparatus"
            },
            "parts": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "style": {
              "type": "string",
              "const": "ccea-2d"
            }
          },
          "required": [
            "kind",
            "parts",
            "style"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
