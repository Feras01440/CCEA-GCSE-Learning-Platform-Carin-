{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3017"
      ],
      "port": 3017
    },
    {
      "name": "web2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "autoPort": true
    },
    {
      "name": "export",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-export.mjs",
        "3200"
      ],
      "port": 3200
    }
  ]
}
