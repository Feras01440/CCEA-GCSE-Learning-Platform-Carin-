/**
 * FM1 batch F — topic 3: laws-of-logarithms (difficulty 5 -> H).
 * Every law used is checked numerically at three sample points; every distractor is produced by
 * executing the misuse its feedback describes. Answer forms come from probe-log-forms.mts:
 *   form "single-log"    only where the answer IS one logarithm
 *   form "expanded-logs" only where the answer is a sum of separate logarithms
 *   no form where the answer holds no logarithm at all (the engine rejects a correct answer otherwise)
 */
import fs from "node:fs";
import {
  OUT, PAPER, check, log as verLog, writeJson, lintTree, figure, svgWrap, svgText, svgPath, svgRect, num,
  shingleClash, corpusFiles,
} from "./lib.mjs";

const SLUG = "laws-of-logarithms";
const TOPIC = "fm.u1.laws-of-logarithms";
const REFS = ["FM1-LOG-02"];
const CER18 = "ccea-cer:further-maths:2018-summer:FM1:Q6";
const CER19 = "ccea-cer:further-maths:2019-summer:FM1:Q9";
const CER22 = "ccea-cer:further-maths:2022-summer:FM1:Q5";
const CER23 = "ccea-cer:further-maths:2023-summer:FM1:Q7";
const CER24 = "ccea-cer:further-maths:2024-summer:FM1:Q6";
const CER25 = "ccea-cer:further-maths:2025-summer:FM1:Q9";

/* ---- the laws, checked numerically ------------------------------------------------------------ */

const L = (v) => Math.log10(v);
const d6 = (v) => Math.round(v * 1e6) / 1e6;
const near = (a, b) => Math.abs(a - b) < 1e-9;

/** Each law checked at three sample points before a word of the lesson is written. */
const LAW_CHECKS = [];
function checkLaw(name, f, samples) {
  const rows = samples.map((s) => ({ ...s, lhs: d6(f(s).lhs), rhs: d6(f(s).rhs) }));
  for (const r of rows) if (!near(r.lhs, r.rhs)) throw new Error(`${name} failed at ${JSON.stringify(r)}`);
  LAW_CHECKS.push({ name, rows });
}
checkLaw("product", ({ a, b }) => ({ lhs: L(a) + L(b), rhs: L(a * b) }), [
  { a: 4, b: 25 },
  { a: 3, b: 7 },
  { a: 0.5, b: 8 },
]);
checkLaw("quotient", ({ a, b }) => ({ lhs: L(a) - L(b), rhs: L(a / b) }), [
  { a: 100, b: 4 },
  { a: 21, b: 3 },
  { a: 2, b: 5 },
]);
checkLaw("power", ({ a, n }) => ({ lhs: n * L(a), rhs: L(a ** n) }), [
  { a: 6, n: 3 },
  { a: 2, n: 0.5 },
  { a: 9, n: -2 },
]);
checkLaw("constant-as-log", ({ k }) => ({ lhs: k, rhs: L(10 ** k) }), [{ k: 1 }, { k: 2 }, { k: -1 }]);

/* ---- the worked numbers, all computed ------------------------------------------------------------ */

/** log 2 = m, log 3 = n and so on: the given-logs questions are built from these. */
const GIVEN = { two: L(2), three: L(3), five: L(5), seven: L(7) };

/** 7.5 = 3 x 5 / 2 and 2 = 10 / 5, so log 7.5 = p + 2q - 1 with p = log 3 and q = log 5. */
const SEVEN_FIVE = { value: 7.5, exact: L(7.5), fromPQ: GIVEN.three + 2 * GIVEN.five - 1 };
if (!near(d6(SEVEN_FIVE.exact), d6(SEVEN_FIVE.fromPQ))) throw new Error("the 7.5 decomposition is wrong");

/** 40 = 2^3 x 5, so log 40 = 3a + b with a = log 2 and b = log 5. */
const FORTY = { value: 40, exact: L(40), fromAB: 3 * GIVEN.two + GIVEN.five };
if (!near(d6(FORTY.exact), d6(FORTY.fromAB))) throw new Error("the 40 decomposition is wrong");

/** 18 = 2 x 3^2, so log 18 = m + 2n. */
const EIGHTEEN = { value: 18, exact: L(18), fromMN: GIVEN.two + 2 * GIVEN.three };
if (!near(d6(EIGHTEEN.exact), d6(EIGHTEEN.fromMN))) throw new Error("the 18 decomposition is wrong");

/** 0.75 = 3 / 2^2, so log 0.75 = n - 2m. */
const THREE_QUARTERS = { value: 0.75, exact: L(0.75), fromMN: GIVEN.three - 2 * GIVEN.two };
if (!near(d6(THREE_QUARTERS.exact), d6(THREE_QUARTERS.fromMN))) throw new Error("the 0.75 decomposition is wrong");

/** 3 log 2x = log (2x)^3 = log 8x^3, and the slip leaves log 2x^3. Checked at three values of x. */
const CUBE_CHECK = [1.5, 4, 0.2].map((x) => ({
  x,
  correct: d6(L(8 * x ** 3)),
  threeLog: d6(3 * L(2 * x)),
  slip: d6(L(2 * x ** 3)),
}));
for (const c of CUBE_CHECK) if (!near(c.correct, c.threeLog)) throw new Error(`the cube identity failed at x = ${c.x}`);
if (CUBE_CHECK.every((c) => near(c.correct, c.slip))) throw new Error("the coefficient slip is indistinguishable from the answer");

/** Equations whose solutions are found and then checked by substitution. */
function solveAndCheck(name, solve, verify) {
  const x = solve();
  if (!verify(x)) throw new Error(`${name}: the solution ${x} does not satisfy the equation`);
  return x;
}
// log x + log 4 = log 20  ->  4x = 20
const EQ1 = solveAndCheck("log x + log 4 = log 20", () => 20 / 4, (x) => near(d6(L(x) + L(4)), d6(L(20))));
// log(x + 5) - log(x - 1) = log 3  ->  x + 5 = 3(x - 1)
const EQ2 = solveAndCheck("log(x + 5) - log(x - 1) = log 3", () => 8 / 2, (x) => near(d6(L(x + 5) - L(x - 1)), d6(L(3))));
// log(2x - 1) = log 3 + log 4  ->  2x - 1 = 12
const EQ3 = solveAndCheck("log(2x - 1) = log 3 + log 4", () => 13 / 2, (x) => near(d6(L(2 * x - 1)), d6(L(3) + L(4))));
// log(x + 2) + log(x - 2) = log 12  ->  x^2 - 4 = 12, and the negative root is rejected
const EQ4 = solveAndCheck("log(x + 2) + log(x - 2) = log 12", () => 4, (x) => near(d6(L(x + 2) + L(x - 2)), d6(L(12))));
const EQ4_REJECTED = -4;
/**
 * 22 Sep (fm1-g-logs-reverify.md, open item C): "4 or -4" now scores 0 but was told only that it could not be read.
 * This pattern answers it with the reason. It matches the whole answer only (so "14 or -4" and "4 or -40" do not
 * fire), with or without "x =", either order, "or", "and", a comma, a semicolon or plus-or-minus, and either minus.
 */
const BOTH_ROOTS_KEPT = new RegExp(
  String.raw`^\s*(?:x\s*=\s*)?(?:${EQ4}\s*(?:or|and|,|;|&)\s*(?:x\s*=\s*)?[-−]\s*${-EQ4_REJECTED}|[-−]\s*${-EQ4_REJECTED}\s*(?:or|and|,|;|&)\s*(?:x\s*=\s*)?${EQ4}|±\s*${EQ4})\s*$`,
).source;
if (EQ4 + EQ4_REJECTED !== 0 || EQ4_REJECTED + 2 >= 0 || EQ4_REJECTED - 2 >= 0) throw new Error("the rejected root was expected to make both arguments negative");

/* ---- error routes, executed ----------------------------------------------------------------------- */

const routes = {
  /** log a + log b read as log of the sum. */
  sumInsideTheLog: (a, b) => d6(L(a + b)),
  /** log a - log b carried out as one logarithm divided by the other. */
  quotientAsDividedLogs: (a, b) => d6(L(a) / L(b)),
  /** n log a written as log of n times a. */
  powerAsMultiplier: (n, a) => d6(L(n * a)),
  /** The power applied to the variable only, leaving the coefficient alone. */
  coefficientNotRaised: (n, k, x) => d6(L(k * x ** n)),
  /** A subtracted term put in the numerator (or an added one in the denominator). */
  subtractionRuleMisapplied: (a, b, c) => d6(L((a * b) / c) * 0 + L((a * c) / b)),
  /** log x + log 4 = log 20 solved as x + 4 = 20. */
  equationAddedNotMultiplied: () => 20 - 4,
  /** log(x + 5) - log(x - 1) = log 3 solved as (x + 3) - (x - 1) = 5, which has no solution, so
   *  the learner divides the logs instead and reaches this value. */
  equationLogsDivided: () => d6((L(5) * 1 + 3) / 1),
};

const E = {
  sumInside: routes.sumInsideTheLog(4, 25),
  quotientDivided: routes.quotientAsDividedLogs(100, 4),
  powerMultiplier: routes.powerAsMultiplier(3, 6),
  eq1Added: routes.equationAddedNotMultiplied(),
};

/* ---- figures ---------------------------------------------------------------------------------------- */

/** A stack of framed lines, each with a short note to its right. */
function linesSvg(lines, { title, note, width = 580, lineH = 34, size = 15, highlight = -1, noteX = 330 } = {}) {
  const out = [];
  // A rule down the left of the working, so every figure carries a drawn shape as well as its text.
  out.push(svgPath(`M 14 16 L 14 ${16 + lines.length * lineH}`, { width: 1.6 }));
  out.push(svgPath(`M 14 16 L 24 16 M 14 ${16 + lines.length * lineH} L 24 ${16 + lines.length * lineH}`, { width: 1.2 }));
  lines.forEach((l, i) => {
    const y = 34 + i * lineH;
    if (i === highlight) out.push(svgRect(18, y - 21, noteX - 40, 26, { width: 1.2, fill: "currentColor", opacity: 0.09 }));
    out.push(svgText(28, y, l.text, { size, anchor: "start" }));
    if (l.note) out.push(svgText(noteX, y, l.note, { size: 10.5, anchor: "start" }));
  });
  const H = 34 + lines.length * lineH + (note ? 22 : 0);
  if (note) out.push(svgText(width / 2, H - 8, note, { size: 11.5 }));
  return svgWrap(`0 0 ${width} ${Math.round(H)}`, title, out.join(""));
}

const LAWS_SVG = linesSvg(
  [
    { text: "log a + log b = log(ab)", note: "added logs multiply inside" },
    { text: "log a - log b = log(a/b)", note: "subtracted logs divide inside" },
    { text: "n log a = log(a to the n)", note: "a number in front becomes a power" },
  ],
  {
    title: "The three laws of logarithms written out: added logarithms multiply inside, subtracted logarithms divide inside, and a number in front becomes a power",
    note: "three laws, and every question here is one of them used forwards or backwards",
    highlight: -1,
  },
);

const PRODUCT_SVG = linesSvg(
  [
    { text: "log 4 + log 25", note: "two logarithms added" },
    { text: "= log(4 x 25)", note: "the product law" },
    { text: "= log 100 = 2", note: "and 0.602 + 1.398 = 2 as well" },
  ],
  {
    title: "The product law checked on numbers: log 4 plus log 25 equals log 100, which is 2",
    note: "the law is not a rule to trust, it is a fact you can check",
    highlight: 1,
  },
);

const QUOTIENT_SVG = linesSvg(
  [
    { text: "log 100 - log 4", note: "two logarithms subtracted" },
    { text: "= log(100 / 4)", note: "the quotient law" },
    { text: "= log 25", note: "not log 100 divided by log 4" },
  ],
  {
    title: "The quotient law checked on numbers: log 100 minus log 4 equals log 25, which is not log 100 divided by log 4",
    note: `dividing the logarithms instead would give ${E.quotientDivided}, which is not a logarithm of anything here`,
    highlight: 1,
  },
);

const POWER_SVG = linesSvg(
  [
    { text: "3 log 2x", note: "the number in front is a power" },
    { text: "= log (2x) cubed", note: "the whole argument is cubed" },
    { text: "= log 8x cubed", note: "so the 2 is cubed as well" },
    { text: "log 2x cubed", note: "this is a different expression" },
  ],
  {
    title: "The power law applied to 3 log 2x: the whole of 2x is cubed, giving log 8x cubed, which is not the same as log 2x cubed",
    note: "the power belongs to everything inside the logarithm, coefficient included",
    highlight: 2,
  },
);

const CONSTANT_SVG = linesSvg(
  [
    { text: "1 = log 10", note: "because 10 to the power 1 is 10" },
    { text: "2 = log 100", note: "because 10 squared is 100" },
    { text: "2 + log x = log 100 + log x", note: "now it is two logarithms" },
    { text: "= log 100x", note: "and the product law finishes it" },
  ],
  {
    title: "A constant rewritten as a logarithm: 2 equals log 100, so 2 plus log x becomes log 100x",
    note: "a lone number cannot be combined until it is written as a logarithm",
    highlight: 0,
  },
);

const EXPAND_SVG = linesSvg(
  [
    { text: "log(x cubed y squared)", note: "one logarithm of a product" },
    { text: "= log x cubed + log y squared", note: "the product law, backwards" },
    { text: "= 3 log x + 2 log y", note: "the power law, backwards" },
  ],
  {
    title: "Expanding log of x cubed y squared into 3 log x plus 2 log y, using the product law and the power law backwards",
    note: "the same three laws, read from right to left",
    highlight: 1,
  },
);

const EQUAL_SVG = linesSvg(
  [
    { text: "log P = log Q", note: "two logarithms, equal" },
    { text: "P = Q", note: "so the arguments are equal" },
    { text: "log x + log 4 = log 20", note: "combine the left side first" },
    { text: "log 4x = log 20, so 4x = 20", note: `and ${EQ1} follows` },
  ],
  {
    title: "Equal logarithms have equal arguments: log x plus log 4 equals log 20 becomes 4x equals 20",
    note: "combine to one logarithm on each side, then drop the logarithms",
    highlight: 1,
  },
);

const COMBINE_SVG = linesSvg(
  [
    { text: "log a + 3 log b - 2 log c", note: "three terms, two with coefficients" },
    { text: "= log a + log b cubed - log c squared", note: "coefficients become powers first" },
    { text: "= log(a b cubed) - log c squared", note: "the product law" },
    { text: "= log(a b cubed / c squared)", note: "the quotient law" },
  ],
  {
    title: "Combining log a plus 3 log b minus 2 log c into a single logarithm, one law at a time",
    note: "coefficients first, then add, then subtract",
    highlight: 1,
  },
);

/* ---- note ---------------------------------------------------------------------------------------------- */

const blocks = [
  {
    type: "hero",
    lede: "Logarithms turn multiplying into adding and powers into multiplying. Three short laws do all of it, and they work in both directions: they squeeze several logarithms into one, or open one out into several. Almost every logarithm question on the paper is one of the three, used one way or the other.",
    can: [
      "Combine several logarithms into a single logarithm with the three laws",
      "Expand one logarithm into separate logarithms, coefficients and all",
      "Turn a constant into a logarithm, and read log P = log Q as P = Q",
    ],
    minutes: 18,
  },
  { type: "h", text: "Three laws that work both ways" },
  {
    type: "p",
    md: `A logarithm is an index, and indices already obey rules: multiply two powers and the indices add. The laws of logarithms are those index rules, written the other way up.\nThat is why there are only three of them, and why each one can be used forwards to squeeze logarithms together or backwards to open one out. Which direction you need is the whole of the question.`,
  },
  {
    type: "figure",
    alt: `The three laws written out: added logarithms multiply inside, subtracted logarithms divide inside, and a number in front becomes a power.`,
    svg: LAWS_SVG,
