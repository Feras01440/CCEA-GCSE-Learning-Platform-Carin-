// verification
// ---------------------------------------------------------------------------

const COMMON = {
  "scope-tier":
    "FM1 is untiered and calculator-allowed. Every curve is a sum of integer powers of x, so the differentiation stays inside FM1-DIF-01, and the second sub-item of FM1-DIF-02 is the one this topic teaches. No question needs a product, quotient or chain rule, a fractional index, or a vertical tangent (every tangent gradient used is non-zero, so every normal exists).",
  "formula-sheet":
    "The Unit 1 sheet gives only the differentiation rule (fs.fm1.differentiation). The negative reciprocal is must-know and is listed as mk.fm1.tangent-normal in packs/further-maths/exam-true/formula-sheets.json; y - y1 = m(x - x1) is must-know as well. The note says which is which.",
  "command-words":
    "Find and Write down are the command words (typicalTariff 2-3-5 and 1-1-2 in packs/further-maths/exam-true/command-words.json); the entry for Find records the trap that a normal needs the tangent gradient first and then the negative reciprocal. The stems keep the shape and the vocabulary of the phrasings read in the papers (an instruction to find an equation, a named point, a stated gradient, a parallel line) while every eight-word run is our own: an 8-word shingle scan of all four bundles against the 61 text files of the private corpus (scratchpad/fm1-batch-d/shingle.mjs) returns nothing.",
  "copy-shingle":
    "Compared by hand against the FM1 papers and mark schemes read for this batch (Summer 2019 Q11, Summer 2022 Q8, Summer 2023 Q10, Summer 2024 Q9, Summer 2025 Q13) and the Chief Examiner reports for those series. Every curve, coefficient, point, name and sentence here is new, and no eight-word sequence is shared with any paper, scheme or report.",
  "style-lint":
    "British English, second person, calm; no exclamation marks; the banned verdict word is never used about a learner's answer. Every maths segment opens and closes inside one line and holds no prose words, checked by lintDollars before the files were written. The note has 8 gates, 9 inline SVG figures drawn from computed values and one embeddable video from data/links/media-map.json followed immediately by a gate; every teaching stretch is inside the 120-word limit of lesson template v2.",
};

const NUMERIC_DETAIL = `Every gradient, point and line is computed in exact rational arithmetic (calc.mjs / tanlib.mjs) and each line was checked at three sample points against the curve and its derivative. Worked examples: tangent ${linePlain(T.we1.line)} at ${pointPlain(fr(4), T.we1.y0)}; normal ${linePlain(T.we2.line)} at ${pointPlain(fr(1), T.we2.y0)}; the tangent ${linePlain(T.we3.line)} meets the cubic again at ${pointPlain(MEET.we3.x, MEET.we3.y)}. Exam-style: normal ${linePlain(T.exA.line)}; a = ${fplain(EXB_A)} with tangent ${linePlain(EXB_T.line)} and normal ${linePlain(EXB_N.line)}; tangent ${linePlain(T.exC.line)} with A at ${pointPlain(EXC_A.x, EXC_A.y)}; tangent ${linePlain(EXD_T)} with Q at ${pointPlain(EXD_Q.x, EXD_Q.y)}. assertTerminating() refuses any coordinate whose decimal does not terminate, because the marker rejects a rounded pair.`;

const ERROR_DETAIL =
  "Every distractor is the output of a named route executed on the item's own numbers: normalRoutes.notReciprocated (-m), normalRoutes.signNotFlipped (1/m), normalRoutes.unchanged (m), constantSlip (c found by adding mx1), the y taken from the given line, the line set equal to the curve, solveDerivEquals with 0 instead of the stated gradient, and the polynomial routes powerNotReduced, negPowerSignKept and indexMovedUp from calc.mjs. assertDistinctErrors() refuses any route that reaches the part's own answer or another route's value, and verify-published.mjs re-executes every route against the published JSON.";

const verification = [
  verLog(`note.fm.u1.${SLUG}`, {
    ...COMMON,
    schema: "Validated against the Zod NoteFrontmatter and the NoteBlock union by pipeline/build-content.mts; the hero block is first, gate ids are unique and every prompt block names a prompt in this bundle.",
    tariff: "The sheet's howExamined records the tariffs read from the papers: 7 marks for a normal on its own (Summer 2023 Q10), 4 + 3 + 2 across a gradient condition, a tangent and a normal (Summer 2024 Q9), 4 + 3 for a tangent and a point from a normal gradient (Summer 2022 Q8), 5 + 3 for a stated tangent gradient and a perpendicular point (Summer 2025 Q13).",
    "maths-numeric": NUMERIC_DETAIL,
    "examiner-alignment":
      "The note's four examiner callouts carry the Summer 2019 Q11, Summer 2024 Q9, Summer 2025 Q13 and Summer 2023 Q10 / Summer 2022 Q8 findings. Gates g2 to g4 build the tangent, g5 and g7 work the negative reciprocal in both directions, g8 is the second intersection.",
  }),
  verLog(we01.id, {
    ...COMMON,
    schema: "Steps numbered 1..5 in order; both faded versions name only steps after the ones shown; the twin carries its own algebraic spec.",
    tariff: "Five steps carrying MW1, M1, W1, M2 and W2, the 3-to-4 mark shape of a tangent part (Summer 2024 Q9(ii), Summer 2022 Q8(i)).",
    "maths-numeric": `y = ${plain(K.we1)} has derivative ${plain(deriv(K.we1))}, gradient ${fplain(T.we1.m)} at x = 4 and point ${pointPlain(fr(4), T.we1.y0)}, giving ${linePlain(T.we1.line)}; the twin gives ${linePlain(T.we1Twin.line)}. Both lines were checked through the point of contact.`,
    "maths-symbolic": "The twin's line was fed to the app's own engine as y = mx + c, as a rearrangement and with the decimal constant; all were accepted because the spec uses equivalence 'equivalent' with no form demanded.",
    "examiner-alignment": "Step 3 is the height-from-the-curve step the Summer 2024 Q9 report shows candidates taking from the given line; step 5 is the constant the Summer 2023 Q10 report names.",
  }),
  verLog(we02.id, {
    ...COMMON,
    schema: "Steps numbered 1..5 in order; both faded versions name only steps after the ones shown.",
    tariff: "Five steps carrying MW1, M1, W1, M2 and W2, the shape of the 7-mark normal in Summer 2023 Q10 compressed to its five decisions.",
    "maths-numeric": `y = ${plain(K.we2)} has derivative ${plain(deriv(K.we2))}, tangent gradient ${fplain(T.we2.m)} at x = 1, normal gradient ${fplain(T.we2.g)} and point ${pointPlain(fr(1), T.we2.y0)}, giving ${linePlain(T.we2.line)}; the twin gives ${linePlain(T.we2Twin.line)}.`,
    "examiner-alignment": "Step 1 is the negative power the Summer 2019 Q11 report singles out; step 3 is the negative reciprocal CCEA credits on its own.",
  }),
  verLog(we03.id, {
    ...COMMON,
    schema: "Steps numbered 1..6 in order; both faded versions name only steps after the ones shown.",
    tariff: "Six steps carrying MW1, W1, M1, W2, M2 and W3, which is the 4-mark 'meets again' part built on a 3-mark tangent.",
    "maths-numeric": `The tangent to ${plain(K.we3)} at x = 1 is ${linePlain(T.we3.line)}; meetsAgain() gives the second point ${pointPlain(MEET.we3.x, MEET.we3.y)} from the repeated-root factorisation, and substituting it into both the curve and the tangent gives the same y. The twin gives ${pointPlain(MEET.we3Twin.x, MEET.we3Twin.y)}.`,
    "examiner-alignment": "Exercises the finding that candidates set the line equal to the curve in the wrong place (Summer 2024 Q9): here that is exactly the right move, and step 3 says why.",
  }),
  verLog(dxPre.id, {
    ...COMMON,
    schema: "Four items, one correct option each, a misconception on every distractor; when is pre.",
    "maths-numeric": "Each stem is a prerequisite fact recomputed by the generator: the perpendicular gradient of a named line, the line through a given point, the derivative of the worked example's curve and its value at x = 4.",
    "examiner-alignment": "The four prerequisites are the four places the reports show the method failing: the reciprocal, the constant, the differentiation and the height.",
  }),
  verLog(dxPost.id, {
    ...COMMON,
    schema: "Eight items, one correct option each, a named misconception on every distractor; when is post.",
    "maths-numeric": "Every option is the output of a route executed on the item's own numbers (normalRoutes.notReciprocated, normalRoutes.signNotFlipped, constantSlip, perp) or of the correct computation. No distractor is typed.",
    "examiner-alignment": "q1, q3, q5 and q7 exercise the negative reciprocal in both directions (Summer 2019 Q11, Summer 2024 Q9); q2 the height from the curve (Summer 2024 Q9); q4 the constant (Summer 2023 Q10); q6 the parallel condition (Summer 2024 Q9); q8 the second intersection.",
  }),
  ...allQuestions.map((q) =>
    verLog(q.id, {
      ...COMMON,
      schema: "Part ids, skeleton, scheme totals and mark totals are machine-checked by pipeline/build-content.mts against the Zod TopicBundle.",
      tariff:
        q.style === "exam-style"
          ? "Tariffs taken from the papers read: 7 for a normal on its own (Summer 2023 Q10), 4 + 3 + 2 for a gradient condition with a tangent and a normal (Summer 2024 Q9), 4 + 3 for a tangent and a point from a normal gradient (Summer 2022 Q8), 5 + 3 for a stated tangent gradient and a perpendicular point (Summer 2025 Q13). FM1 perPart median is 3 and p90 is 6, and only the single-part normal reaches 7, as the paper does."
          : "1 mark for the negative reciprocal alone, 2 for a gradient, 3 for a tangent equation and 4 for a full normal, matching the per-part tariffs in Summer 2022 Q8, Summer 2024 Q9 and the Find typicalTariff in command-words.json.",
      "maths-numeric": NUMERIC_DETAIL,
      "maths-symbolic":
        "Line answers are algebraic specs with equivalence 'equivalent'; where the stem says 'in the form y = mx + c' the spec adds form 'y=mx+c', and only there, because the Summer 2023 scheme accepts the rearranged form as well. Coordinate answers are algebraic tuples, which the engine marks as pairs: the bracketed, assignment and decimal spellings were all fed to the app's own marker and accepted, and a crossed pair was rejected.",
      "examiner-alignment": ERROR_DETAIL,
    }),
  ),
  ...[ftm01, ftm02, ftm03].map((f) =>
    verLog(f.id, {
      ...COMMON,
      schema: "mistakeLine names a line that exists; the misconception is in the registry; every correction line is generated from the correct route.",
      "maths-numeric": `The wrong lines are the outputs of normalRoutes.notReciprocated, normalRoutes.signNotFlipped and the y-from-the-line route executed on the item's own curve; the corrected lines are ${linePlain(T.p6.line)}, ${linePlain(T.p9.line)} and ${linePlain(EXB_T.line)}.`,
      "examiner-alignment": "Seeded from the three findings the reports name for this topic: the normal's gradient not reciprocated (Summer 2019 Q11), the sign not changed (Summer 2024 Q9), and the height taken from the given line rather than the curve (Summer 2024 Q9).",
    }),
  ),
  ...prompts.map((p) =>
    verLog(p.id, {
      ...COMMON,
      schema: "Kind, prompt, answer and key words validated against the Zod RetrievalPrompt.",
      "maths-numeric": "Each answer states a rule the generator also uses in the items, so the prompts and the questions cannot drift apart.",
      "examiner-alignment": "The ten prompts cover the four steps, the negative reciprocal in both directions, the height from the curve, the parallel condition, the rewrite of a negative power, the follow-through mark and the second intersection.",
    }),
  ),
];

// ---------------------------------------------------------------------------
// bundle
// ---------------------------------------------------------------------------

const HOW_EXAMINED =
  "Unit 1 is one two-hour calculator paper of 100 marks, sat every Summer. Tangents and normals are a late-paper discriminator and appear almost every year: Summer 2019 Q11 (a normal on a curve with a negative power), Summer 2022 Q8 (a 4-mark tangent then a 3-mark point from a stated normal gradient), Summer 2023 Q10 (a single 7-mark normal), Summer 2024 Q9 (4 + 3 + 2: an unknown coefficient from a parallel line, then the tangent, then the normal) and Summer 2025 Q13 (5 + 3: a stated tangent gradient, then a point whose tangent is perpendicular). Schemes run MW1 for dy/dx, M1 for the substitution, W1 for the tangent gradient, W1 for the negative reciprocal, M1 for the point and W1 for the finished equation; the reciprocal mark is given on follow-through even when the gradient before it is wrong.";

const bundle = {
  $schema: "../../../../../pipeline/schema/topic-bundle.schema.json",
  topic: {
    id: TOPIC,
    slug: SLUG,
    title: "Equations of tangents and normals",
    subject: "further-maths",
    unit: "FM1",
    tier: "untiered",
    strand: "Calculus",
    statementIds: SPEC,
    prerequisites: ["fm.u1.gradient-at-a-point", "fm.u1.differentiation-integer-powers"],
    order: 32,
    hardness: "H",
    difficulty: 4,
    examinerFlagged: true,
    examinerSources: [src("2019-summer", 11), src("2022-summer", 8), src("2023-summer", 10), src("2024-summer", 9), src("2025-summer", 13)],
    examWeightHint: HOW_EXAMINED,
    mustMemorise: [
      "Tangent gradient m = dy/dx at the point; normal gradient = −1/m",
      "y − y₁ = m(x − x₁), with the point taken from the curve",
      "Parallel to a line means dy/dx equals that line's gradient",
      "Perpendicular to a line means dy/dx is that line's negative reciprocal",
      "A tangent touches at a repeated root, so (x − x₁)² divides out when it meets the curve again",
    ],
    onFormulaSheet: ["If y = axⁿ then dy/dx = naxⁿ⁻¹ (Unit 1 formula sheet, page 2)"],
    notOnThisSpec: [
      "Tangents and normals to trigonometric, exponential or logarithmic curves, which are not on this specification",
      "Vertical tangents and the normal at a stationary point, which would need an undefined gradient",
      "Parametric or implicit differentiation",
      "The distance from a point to a line, or the length of a normal chord",
    ],
    externalRefs: [
      { kind: "youtube", videoId: "fPElVHyk_XI", channel: "P McAleavey", credit: "Differentiation Tangents and Normals - CCEA GCSE Further Mathematics, P McAleavey (embeddable id verified in data/links/media-map.json)" },
      { kind: "youtube", videoId: "N_FM6aON2z8", channel: "corbettmaths", credit: "Equation of a Tangent to a Curve, corbettmaths (embeddable id verified in data/links/media-map.json)" },
      PHET,
      CCEA_DOC,
    ],
    keywords: ["tangent", "normal", "perpendicular", "negative reciprocal", "equation of line", "point of contact"],
  },
  note: {
    id: `note.fm.u1.${SLUG}`,
    topic: TOPIC,
    title: "Equations of tangents and normals",
    subject: "further-maths",
    unit: "FM1",
    tier: "untiered",
    specRefs: SPEC,
    calculator: true,
    formulaSheet: {
      given: FORMULA_GIVEN,
      mustKnow: [
        "Normal gradient = −1 ÷ tangent gradient",
        "y − y₁ = m(x − x₁)",
        "Perpendicular gradients multiply to −1",
        "The point of contact is taken from the curve",
      ],
    },
    notOnThisSpec: [
      "Tangents to trigonometric, exponential or logarithmic curves",
      "Vertical tangents, and normals at stationary points",
      "Parametric or implicit differentiation",
      "Distances and lengths along a normal",
    ],
    hardness: "H",
    examinerFlagged: true,
    externalRefs: [
      { kind: "youtube", videoId: "fPElVHyk_XI", channel: "P McAleavey", credit: "Differentiation Tangents and Normals - CCEA GCSE Further Mathematics, P McAleavey (embeddable id verified in data/links/media-map.json)" },
      PHET,
      CCEA_DOC,
    ],
    sheet: {
      mustBeAbleTo: [
        "Differentiate the curve and substitute to get the tangent's gradient at a named point",
        "Take the y-coordinate of the point of contact from the curve",
        "Assemble y − y₁ = m(x − x₁) and tidy it to y = mx + c",
        "Turn a tangent gradient into a normal gradient by taking the negative reciprocal",
        "Work the negative reciprocal backwards when the normal's gradient is the thing given",
        "Read 'parallel to' as dy/dx equal to that gradient, and 'perpendicular to' as its negative reciprocal",
        "Handle a curve containing a negative power, rewriting it before differentiating",
        "Find where a tangent meets its curve again, using the repeated root",
        "Answer in the form asked: an equation, or coordinates",
      ],
      howExamined: HOW_EXAMINED,
      traps: [
        "Changing the sign of the tangent gradient without turning it over (Summer 2019 FM1 Q11)",
        "Turning it over without changing the sign (Summer 2024 FM1 Q9)",
        "Setting the line equal to the curve instead of differentiating (Summer 2024 FM1 Q9)",
        "Using the given line's gradient where the perpendicular one belonged (Summer 2024 FM1 Q9)",
        "Solving dy/dx = 0 out of habit when a gradient was stated (Summer 2025 FM1 Q13)",
        "Stopping at the perpendicular gradient, or giving a line equation where coordinates were asked (Summer 2025 FM1 Q13)",
        "An arithmetic slip in the gradient at a negative x, or in the constant (Summer 2023 FM1 Q10)",
        "Failing to differentiate a term with a negative power, even after doing it earlier in the same paper (Summer 2019 FM1 Q11)",
        "Reading the gradient off a coefficient as though the curve were y = mx + c (Summer 2019 FM1 Q11)",
        // 22 Sep (FM1 finisher, lead's decision 2): the 2022 source had no trap. From the report: few candidates
        // could write the tangent's gradient from the normal's, so most could not start the part.
        "Given the normal's gradient, not turning it into the tangent's gradient first, so the rest cannot start: a normal gradient of 1/8 means a tangent gradient of −8 (Summer 2022 FM1 Q8)",
      ],
    },
    verification: `ver.note.fm.u1.${SLUG}`,
    version: 1,
    updated: UPDATED,
  },
  workedExamples: [we01, we02, we03],
  diagnostics: [dxPre, dxPost],
  questions: allQuestions,
  findTheMistake: [ftm01, ftm02, ftm03],
  prompts,
  insight,
  verification,
};

recapCard(blocks);
const droppedCallouts = pointerPanel(blocks, String.raw`A late-paper discriminator: **7 marks** for a normal on its own, or **4 + 3 + 2** across a tangent, a normal and a gradient condition. The first mark is $\frac{dy}{dx}$; a further mark is given just for writing the normal's gradient as the negative reciprocal of your own, even when that gradient is wrong, so write that line whatever else has happened. The last mark is the finished equation.`);
assertTrapsCoverPanel(droppedCallouts, bundle.note.sheet, "gen-tangents.mjs");
assertLogs(bundle);
assertDistinctErrors(bundle);
emit(SLUG, bundle, blocks);
