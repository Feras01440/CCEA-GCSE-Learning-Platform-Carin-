        { id: "b", text: `$${latex(route("constantKept", K.we1))}$`, correct: false, misconception: "fm.calc.constant-term-kept", feedback: "The constant differentiates to zero, so it should not appear in the gradient rule." },
        { id: "c", text: `$${latex(route("coefficientNotMultiplied", K.we1))}$`, correct: false, misconception: "fm.calc.coefficient-not-multiplied", feedback: "The powers stepped down correctly. Each coefficient is multiplied by its own power as well." },
