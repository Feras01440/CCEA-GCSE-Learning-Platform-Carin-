/**
 * fm.u1.tangents-and-normals — the H bundle for FM1-DIF-02 (tangents and normals).
 * Every gradient, point, line and distractor is computed exactly in calc.mjs / tanlib.mjs.
 */
import fs from "node:fs";
import path from "node:path";
import { M, dataFigure, tableSvg } from "./lib.mjs";
import {
  P, deriv, latex, plain, route, graphSvg, moveSvg, atNum,
  fr, fadd, fsub, fmul, fdiv, fneg, finv, fval, at, flatex, fplain,
  lineLatex, linePlain, lineThrough, pointLatex, pointPlain, assertTerminating,
} from "./calc.mjs";
import { tangent, normal, perp, normalRoutes, constantSlip, meetsAgain, solveDerivEquals } from "./tanlib.mjs";
import { AT, UPDATED, PAPER, FORMULA_GIVEN, CCEA_DOC, PHET, src, verLog, emit, assertLogs, assertDistinctErrors, timeFor, OUT , pointerPanel, assertTrapsCoverPanel, recapCard} from "./shared.mjs";

const SLUG = "tangents-and-normals";
const TOPIC = "fm.u1.tangents-and-normals";
const SPEC = ["FM1-DIF-02"];
const id = (kind, n) => `${kind}.fm.u1.${SLUG}.${n}`;

// ---------------------------------------------------------------------------
// curves
// ---------------------------------------------------------------------------

const K = {
  we1: P([[1, 2], [-6, 1], [11, 0]]),
  we1Twin: P([[1, 2], [2, 1], [-5, 0]]),
  we2: P([[2, 1], [-3, -1]]),
  we2Twin: P([[3, 1], [4, -1]]),
  we3: P([[1, 3], [-12, 1]]),
  we3Twin: P([[1, 3], [-3, 1]]),
  p1: P([[1, 2], [5, 1]]),
  p2: P([[1, 2]]),
  p3: P([[1, 2], [-2, 1], [4, 0]]),
  p5: P([[3, 2], [-1, 1]]),
  p6: P([[1, 2], [-8, 1], [3, 0]]),
  p7: P([[1, 3], [2, 1]]),
  p8: P([[8, -1]]),
  p9: P([[2, 1], [-12, -1]]),
  p10: P([[1, 2], [-3, 1], [4, 0]]),
  p11: P([[2, 2], [-1, 1], [3, 0]]),
  p12: P([[1, 3], [-4, 1]]),
  exA: P([[1, 3], [2, 2], [-4, 1], [1, 0]]),
  exC: P([[1, 2], [-2, 1], [5, 0]]),
  exD: P([[2, 2], [-3, 1], [1, 0]]),
};

const T = {
  we1: tangent(K.we1, fr(4)),
  we1Twin: tangent(K.we1Twin, fr(1)),
  we2: normal(K.we2, fr(1)),
  we2Twin: normal(K.we2Twin, fr(2)),
  we3: tangent(K.we3, fr(1)),
  we3Twin: tangent(K.we3Twin, fr(2)),
  p1: tangent(K.p1, fr(1)),
  p2: tangent(K.p2, fr(3)),
  p3: tangent(K.p3, fr(2)),
  p5: normal(K.p5, fr(1)),
  p6: normal(K.p6, fr(5)),
  p7: normal(K.p7, fr(1)),
  p8: tangent(K.p8, fr(2)),
  p9: normal(K.p9, fr(2)),
  p12: tangent(K.p12, fr(-1)),
  exA: normal(K.exA, fr(-1)),
  exC: tangent(K.exC, fr(4)),
};
const MEET = { we3: meetsAgain(K.we3, fr(1)), we3Twin: meetsAgain(K.we3Twin, fr(2)), p12: meetsAgain(K.p12, fr(-1)) };

// p10: the point where the tangent gradient is 5
const P10_X = solveDerivEquals(K.p10, fr(5))[0];
const P10_P = { x: P10_X, y: at(K.p10, P10_X) };
const P10_ZERO_X = solveDerivEquals(K.p10, fr(0))[0];
const P10_ZERO = { x: P10_ZERO_X, y: at(K.p10, P10_ZERO_X) };
// p11: the point where the NORMAL gradient is -1/7, so the tangent gradient is 7
const P11_G = fr(-1, 5);
const P11_M = perp(P11_G);
const P11_X = solveDerivEquals(K.p11, P11_M)[0];
const P11_P = { x: P11_X, y: at(K.p11, P11_X) };
/*
 * 22 Sep (FM1 finisher, lead's decision 2): q0011's worked line printed "y = 8 - 2 + 3 = 6", the curve's terms at
 * x = 2, while A has x = 1.5. The line is now the substitution itself, each term computed from the curve at A's x
 * and the terms asserted to add to A's y.
 */
if (JSON.stringify(K.p11) !== JSON.stringify(P([[2, 2], [-1, 1], [3, 0]]))) throw new Error("q0011: the substitution line below is written for y = 2x^2 - x + 3");
const P11_TERMS = K.p11.map((t) => at([t], P11_P.x));   // exact, term by term: 2x^2, -x, 3 at A's x
const P11_SUM = P11_TERMS.reduce((s, v) => fadd(s, v), fr(0));
if (P11_SUM.n !== P11_P.y.n || P11_SUM.d !== P11_P.y.d) throw new Error("q0011: the terms do not add to A's y");
const P11_SIGNED = P11_TERMS.map((v, i) => (i === 0 ? fplain(v) : v.n < 0 ? `- ${fplain(fneg(v))}` : `+ ${fplain(v)}`)).join(" ");
const P11_SUBST = `y = 2(${fplain(P11_P.x)})^{2} - ${fplain(P11_P.x)} + 3 = ${P11_SIGNED} = ${fplain(P11_P.y)}`;
const P11_WRONG_M = normalRoutes.notReciprocated(P11_G); // uses -g as the tangent gradient
const P11_WRONG_X = solveDerivEquals(K.p11, P11_WRONG_M)[0];
const P11_WRONG = { x: P11_WRONG_X, y: at(K.p11, P11_WRONG_X) };
const P11_FLIP_M = normalRoutes.signNotFlipped(P11_G);
const P11_FLIP_X = solveDerivEquals(K.p11, P11_FLIP_M)[0];
const P11_FLIP = { x: P11_FLIP_X, y: at(K.p11, P11_FLIP_X) };

// exam B: y = 3 + a/x^2, tangent at x = -2 parallel to y = 2x - 7
const EXB = {
  base: 3,
  x0: fr(-2),
  lineM: fr(2),
  lineC: fr(-7),
};
/** dy/dx of 3 + a x^-2 at x0 is -2a/x0^3, so a = m x0^3 / (-2). */
const exbA = (m) => fdiv(fmul(m, fmul(EXB.x0, fmul(EXB.x0, EXB.x0))), fr(-2));
const EXB_A = exbA(EXB.lineM);                                   // 8
const EXB_CURVE = P([[EXB.base, 0], [EXB_A.n, -2]]);
const EXB_T = tangent(EXB_CURVE, EXB.x0);
const EXB_N = normal(EXB_CURVE, EXB.x0);
/** Route: the index is not stepped down, so dy/dx is read as -2a/x^2 and a comes out differently. */
const EXB_A_POWERKEPT = fdiv(fmul(EXB.lineM, fmul(EXB.x0, EXB.x0)), fr(-2));
/** Route: the sign of the derivative is lost, giving +2a/x^3. */
const EXB_A_SIGNKEPT = fneg(EXB_A);
/** Route: the line is set equal to the curve instead of differentiating. */
const EXB_A_EQUATED = (() => {
  const rhs = fadd(fmul(EXB.lineM, EXB.x0), EXB.lineC);          // the line's y at x0
  return fmul(fsub(rhs, fr(EXB.base)), fmul(EXB.x0, EXB.x0));    // a = (y - 3) x0^2
})();

// exam C(b): the normal at A has gradient 1/8
const EXC_G = fr(1, 8);
const EXC_M = perp(EXC_G);
const EXC_X = solveDerivEquals(K.exC, EXC_M)[0];
const EXC_A = { x: EXC_X, y: at(K.exC, EXC_X) };
const EXC_FLIP_X = solveDerivEquals(K.exC, normalRoutes.signNotFlipped(EXC_G))[0];
const EXC_FLIP = { x: EXC_FLIP_X, y: at(K.exC, EXC_FLIP_X) };
const EXC_ZERO_X = solveDerivEquals(K.exC, fr(0))[0];
const EXC_ZERO = { x: EXC_ZERO_X, y: at(K.exC, EXC_ZERO_X) };
const EXC_A_TANGENT = lineThrough(EXC_M, EXC_A.x, EXC_A.y);

// exam D: tangent gradient 5 at P; Q has the perpendicular tangent
const EXD_M = fr(5);
const EXD_X = solveDerivEquals(K.exD, EXD_M)[0];
const EXD_P = { x: EXD_X, y: at(K.exD, EXD_X) };
const EXD_T = lineThrough(EXD_M, EXD_P.x, EXD_P.y);
const EXD_QM = perp(EXD_M);
const EXD_QX = solveDerivEquals(K.exD, EXD_QM)[0];
const EXD_Q = { x: EXD_QX, y: at(K.exD, EXD_QX) };
const EXD_Q_TANGENT = lineThrough(EXD_QM, EXD_Q.x, EXD_Q.y);
const EXD_NOTRECIP_X = solveDerivEquals(K.exD, normalRoutes.notReciprocated(EXD_M))[0];
const EXD_NOTRECIP = { x: EXD_NOTRECIP_X, y: at(K.exD, EXD_NOTRECIP_X) };
const EXD_FLIP_X = solveDerivEquals(K.exD, normalRoutes.signNotFlipped(EXD_M))[0];
const EXD_FLIP = { x: EXD_FLIP_X, y: at(K.exD, EXD_FLIP_X) };
const EXD_ZERO_X = solveDerivEquals(K.exD, fr(0))[0];
const EXD_ZERO = { x: EXD_ZERO_X, y: at(K.exD, EXD_ZERO_X) };

for (const [name, p] of Object.entries({
  P10_P, P10_ZERO, P11_P, P11_WRONG, P11_FLIP, EXC_A, EXC_FLIP, EXC_ZERO,
  EXD_P, EXD_Q, EXD_NOTRECIP, EXD_FLIP, EXD_ZERO,
  meet3: MEET.we3, meet3t: MEET.we3Twin, meet12: MEET.p12,
})) {
  assertTerminating(name, p.x, p.y);
}

// ---------------------------------------------------------------------------
// answers and errors
// ---------------------------------------------------------------------------

const ansNum = (f) => ({
  kind: "numeric",
  value: fval(f),
  tolerance: { type: "absolute", value: 0.0005 },
  unitRequired: false,
  acceptForms: ["decimal", "fraction"],
});
const ansLine = (L, demandForm = false) => ({
  kind: "algebraic",
  latex: lineLatex(L),
  equivalence: "equivalent",
  variables: ["x", "y"],
  ...(demandForm ? { form: "y=mx+c" } : {}),
});
const ansPoint = (p) => ({ kind: "algebraic", latex: pointLatex(p.x, p.y), equivalence: "equivalent", variables: ["x", "y"] });
const ansPoly = (terms) => ({ kind: "algebraic", latex: latex(terms), equivalence: "equivalent", variables: ["x"] });

const errNum = (misconception, f, feedback, marks, source) => ({
  misconception, pattern: { kind: "numeric", value: fval(f) }, feedback, marksTypicallyEarned: marks, ...(source ? { source } : {}),
});
const errAlg = (misconception, latexText, feedback, marks, source) => ({
  misconception, pattern: { kind: "algebraic", latex: latexText }, feedback, marksTypicallyEarned: marks, ...(source ? { source } : {}),
});

/**
 * The constant-slip common error, with the quantity AND the direction of the mistake computed.
 * c is y1 - m x1, so the slip adds m x1 where it should take it away. When m x1 is itself negative
 * the learner sees the magnitude being taken away where it should be added, and the sentence has to
 * say so: naming the verb by hand is how the fm1-d-1 pre-read found three of these back to front.
 */
function constantSlipError(m, x0, y0, lead, marks, source) {
  const q = fmul(m, x0);
  const mag = fr(Math.abs(q.n), q.d);
  const correct = fsub(y0, q);
  const verb = q.n > 0 ? "added instead of taken away" : "taken away instead of added";
  return errAlg(
    "fm.calc.tangent-constant-slip",
    lineLatex(constantSlip(m, x0, y0)),
    `${lead} In the last line ${M(flatex(mag))} was ${verb}, so the constant should be ${M(flatex(correct))}.`,
    marks,
    source,
  );
}

// ---------------------------------------------------------------------------
// figures
// ---------------------------------------------------------------------------

const asFn = (poly) => (x) => atNum(poly, x);
const lineFn = (L) => (x) => fval(L.m) * x + fval(L.c);

const heroSvg = graphSvg({
  title: "A parabola with the tangent and the normal both drawn at the point (4, 3), meeting there at a right angle",
  width: 560,
  height: 360,
  xMin: 0.6,
  xMax: 7.4,
  yMin: -2,
  yMax: 11,
  xStep: 1,
  yStep: 2,
  curves: [
    { f: asFn(K.we1), width: 2 },
    { f: lineFn(T.we1.line), dash: true, width: 1.4, label: "tangent", labelAt: 6.4 },
    { f: lineFn(normal(K.we1, fr(4)).line), dash: true, width: 1.4, label: "normal", labelAt: 1.6 },
  ],
  points: [{ x: 4, y: 3, label: pointPlain(T.we1.y0 && fr(4), T.we1.y0), dx: 8, dy: 18 }],
  caption: "one point, two lines, at right angles to each other",
});

const stepsSvg = moveSvg({
  title: "The four steps that produce the equation of a tangent",
  heading: "four steps, and the first two are the ones worth marks",
  rows: [
    { left: "1. differentiate the curve", right: "gives the gradient rule" },
    { left: "2. substitute the x of the point", right: "gives m, a number" },
    { left: "3. substitute the same x into the CURVE", right: "gives the y of the point" },
    { left: "4. put m, x and y into y - y1 = m(x - x1)", right: "gives the equation" },
  ],
  caption: "the normal repeats all four, with -1/m in place of m at step 4",
});

const pointSvg = graphSvg({
  title: "The parabola with dashed lines from the point (4, 3) to each axis, showing where the coordinates come from",
  width: 560,
  height: 320,
  xMin: 0.6,
  xMax: 7.4,
  yMin: -1,
  yMax: 11,
  xStep: 1,
  yStep: 2,
  curves: [{ f: asFn(K.we1), width: 2 }],
  drops: [{ x: 4, y: 3 }],
  hLines: [{ at: 3, label: "y = 3 from the curve" }],
  points: [{ x: 4, y: 3, label: pointPlain(fr(4), T.we1.y0), dx: 8, dy: -10 }],
  caption: "the height belongs to the curve, never to the derivative",
});

const we1Svg = graphSvg({
  title: "The worked example: the parabola with its tangent drawn at the point (4, 3) and the tangent's equation labelled",
  width: 560,
  height: 340,
  xMin: 1.4,
  xMax: 7.4,
  yMin: -3,
  yMax: 11,
  xStep: 1,
  yStep: 2,
  curves: [
    { f: asFn(K.we1), width: 2 },
    { f: lineFn(T.we1.line), dash: true, width: 1.4, label: linePlain(T.we1.line), labelAt: 6.2 },
  ],
  points: [{ x: 4, y: 3, label: pointPlain(fr(4), T.we1.y0), dx: 10, dy: 16 }],
  caption: "the tangent touches, and keeps going",
});

const perpSvg = moveSvg({
  title: "A table of tangent gradients beside the matching normal gradients",
  heading: "turn it over, then change the sign",
  rows: [
    { left: `tangent ${fplain(fr(2))}   normal ${fplain(perp(fr(2)))}`, right: "2 x -0.5 = -1" },
    { left: `tangent ${fplain(fr(5))}   normal ${fplain(perp(fr(5)))}`, right: "5 x -0.2 = -1" },
    { left: `tangent ${fplain(fr(-4))}   normal ${fplain(perp(fr(-4)))}`, right: "-4 x 0.25 = -1" },
    { left: `tangent ${fplain(fr(-1, 3))}   normal ${fplain(perp(fr(-1, 3)))}`, right: "a fraction turns into a whole number" },
  ],
  caption: "the two gradients always multiply to -1",
});

const we2Svg = graphSvg({
  title: "The curve y = 2x - 3 over x with its normal drawn at the point (1, -1)",
  width: 560,
  height: 340,
  xMin: 0.2,
  xMax: 4.4,
  yMin: -6,
  yMax: 8,
  xStep: 1,
  yStep: 2,
  curves: [
    { f: asFn(K.we2), width: 2 },
    { f: lineFn(T.we2.line), dash: true, width: 1.4, label: linePlain(T.we2.line), labelAt: 3.3 },
  ],
  points: [{ x: 1, y: -1, label: pointPlain(fr(1), T.we2.y0), dx: 10, dy: -10 }],
  caption: "a negative power in the curve changes nothing about the method",
});

const givenSvg = graphSvg({
  title: "A curve with a tangent drawn parallel to a given straight line, both lines marked with the same gradient",
  width: 560,
  height: 330,
  xMin: -4.2,
  xMax: -0.4,
  yMin: 0,
  yMax: 14,
  xStep: 1,
  yStep: 2,
  curves: [
    { f: asFn(EXB_CURVE), width: 2 },
    { f: lineFn(EXB_T.line), dash: true, width: 1.4, label: "tangent", labelAt: -1.1 },
    { f: lineFn({ m: EXB.lineM, c: fadd(EXB.lineC, fr(14)) }), dash: true, width: 1.2, opacity: 0.8, label: "the given line", labelAt: -3.1 },
  ],
  points: [{ x: fval(EXB.x0), y: fval(EXB_T.y0), label: "P", dx: 8, dy: -10 }],
  caption: "parallel means the same gradient, so dy/dx is set equal to it",
});

const meetSvg = graphSvg({
  title: "A cubic with the tangent drawn at x = 1, touching there and crossing the curve again further left",
  width: 560,
  height: 360,
  xMin: -3.4,
  xMax: 3.4,
  yMin: -20,
  yMax: 22,
  xStep: 1,
  yStep: 5,
  curves: [
    { f: asFn(K.we3), width: 2 },
    { f: lineFn(T.we3.line), dash: true, width: 1.4, label: linePlain(T.we3.line), labelAt: 2.4, labelBelow: true },
  ],
  points: [
    { x: 1, y: fval(T.we3.y0), label: `touches at ${pointPlain(fr(1), T.we3.y0)}`, dx: 8, dy: 18 },
    { x: fval(MEET.we3.x), y: fval(MEET.we3.y), label: `crosses at ${pointPlain(MEET.we3.x, MEET.we3.y)}`, dx: 8, dy: -10 },
  ],
  caption: "a tangent to a cubic usually meets it once more",
});

/** The same tangent and cubic with the second crossing marked but not named: the example finds it. */
const meetPlainSvg = graphSvg({
  title: "A cubic with its tangent drawn, touching at one point and crossing the curve at another",
  width: 560,
  height: 360,
  xMin: -3.4,
  xMax: 3.4,
  yMin: -20,
  yMax: 22,
  xStep: 1,
  yStep: 5,
  curves: [
    { f: asFn(K.we3), width: 2 },
    { f: lineFn(T.we3.line), dash: true, width: 1.4 },
  ],
  points: [
    { x: 1, y: fval(T.we3.y0), label: "touches here", dx: 8, dy: 18 },
    { x: fval(MEET.we3.x), y: fval(MEET.we3.y), label: "crosses here", dx: 8, dy: -10 },
  ],
  caption: "a tangent to a cubic usually meets it once more",
});

const schemeSvg = tableSvg({
  title: "Where the marks fall in a normal question",
  heading: "a 7-mark normal, mark by mark",
  columns: ["line you write", "code", "worth"],
  rows: [
    ["dy/dx = ...", "MW", "1"],
    ["substitute the x of P", "M", "1"],
    ["the tangent gradient, a number", "W", "1"],
    ["normal gradient = -1 / m", "W", "1"],
    ["the y of P, from the curve", "M", "1"],
    ["c from y - y1 = m(x - x1)", "M", "1"],
    ["the finished equation", "W", "1"],
  ],
  caption: "the first two lines are available before any arithmetic can go wrong",
  width: 560,
  colWidths: [300, 130, 100],
});

// ---------------------------------------------------------------------------
// note
// ---------------------------------------------------------------------------

const blocks = [
  {
    type: "hero",
    lede: "A tangent touches a curve and travels in exactly the direction the curve is going. A normal cuts across it at a right angle. Both are straight lines, so both have an equation, and the only new idea is where their gradients come from.",
    can: [
      "Find the equation of the tangent to a curve at a named point, in four steps",
      "Turn a tangent gradient into a normal gradient by taking the negative reciprocal",
      "Use a gradient the question gives you, instead of setting dy/dx to zero",
    ],
    minutes: 19,
  },
  { type: "h", text: "Touching, and crossing at a right angle" },
  {
    type: "p",
    md: "Rest a ruler against a curve so that it just touches: that is the **tangent**. Stand a second ruler upright against the first at the same place: that is the **normal**.\nBoth are ordinary straight lines with an equation $y = mx + c$. Everything in this topic is about finding their two numbers, $m$ and $c$.",
  },
  {
    type: "figure",
    alt: "A parabola drawn on axes with two dashed straight lines through the point (4, 3): one touching the curve, labelled tangent, and one crossing it at right angles, labelled normal.",
    svg: heroSvg,
    caption: "The tangent goes the way the curve goes. The normal cuts across it at $90^{\\circ}$.",
  },
  {
    type: "gate",
    id: "g1",
    kind: "choice",
    prompt: "One tap to start. Which of the two lines in the picture just touches the curve?",
    options: ["The tangent", "The normal", "Both of them"],
    answer: "The tangent",
    explain: "The tangent touches and travels with the curve. The normal is at right angles to it, so it cuts straight through.",
  },
  { type: "h", text: "1. Four steps, and only one of them is new" },
  {
    type: "p",
    md: `To write ${M("y - y_{1} = m(x - x_{1})")} you need a gradient and a point. Differentiating supplies the gradient; the curve supplies the point.\n**Differentiate**, because the derivative is the gradient rule. **Substitute** the ${M("x")} of the point, because you want the gradient there and nowhere else. **Find ${M("y")} from the curve**. **Put all three into the line formula**.`,
  },
  {
    type: "figure",
    alt: "A four-row card listing the steps: differentiate the curve, substitute the x of the point, substitute the same x into the curve, and put m, x and y into the straight-line formula.",
    svg: stepsSvg,
    caption: "The normal repeats the same four steps with $-\\frac{1}{m}$ in place of $m$.",
  },
  {
    type: "gate",
    id: "g2",
    kind: "number",
    prompt: `The curve is $y = ${latex(K.we1)}$, so $\\frac{dy}{dx} = ${latex(deriv(K.we1))}$. What is the gradient of the tangent at $x = 4$?`,
    answer: fplain(T.we1.m),
    explain: `$2(4) - 6 = ${fplain(T.we1.m)}$. That number is the $m$ of the tangent, and everything else is built on it.`,
  },
  { type: "h", text: "2. The point of contact sits on the curve" },
  {
    type: "p",
    md: `The tangent and the curve share exactly one point, so its ${M("y")} can be found from either — but only the curve is safe. Substituting into ${M("\\frac{dy}{dx}")} gives the gradient a second time, not the height.\nWhen a straight line is also mentioned in the question, its ${M("y")} is a third number again. Take the height from the curve, every time.`,
  },
  {
    type: "figure",
    alt: "The parabola with a dashed vertical line from the point (4, 3) down to the x-axis and a dashed horizontal line across to the y-axis, showing that the height 3 is read from the curve.",
    svg: pointSvg,
    caption: "$x = 4$ goes into the curve, and $y = 3$ comes back out.",
  },
  {
    type: "callout",
    kind: "why",
    title: "Why the point matters as much as the gradient",
    md: `A gradient alone names a whole family of parallel lines. The point is what picks one of them out, and ${M("c")} is where that choice is recorded. Two questions with the same curve and different points have the same ${M("m")} pattern and completely different answers.`,
  },
  {
    type: "gate",
    id: "g3",
    kind: "number",
    prompt: `Same curve, $y = ${latex(K.we1)}$. What is $y$ when $x = 4$?`,
    answer: fplain(T.we1.y0),
    explain: `$16 - 24 + 11 = ${fplain(T.we1.y0)}$. Substituting 4 into the derivative instead would have given ${M(fplain(T.we1.m))}, which is the gradient.`,
  },
  { type: "h", text: "3. A worked tangent, start to finish" },
  {
    type: "p",
    md: `Find the equation of the tangent to ${M(latex(K.we1, { lhs: "y" }))} at the point where ${M("x = 4")}.\n**Step 1.** ${M(latex(deriv(K.we1), { lhs: "\\frac{dy}{dx}" }))}.\n**Step 2.** At ${M("x = 4")}, ${M(`m = ${fplain(T.we1.m)}`)}.\n**Step 3.** From the curve, ${M(`y = ${fplain(T.we1.y0)}`)}, so the point is ${M(pointLatex(fr(4), T.we1.y0))}.\n**Step 4.** ${M(`y - ${fplain(T.we1.y0)} = ${fplain(T.we1.m)}(x - 4)`)}, which tidies to ${M(lineLatex(T.we1.line))}.`,
  },
  {
    type: "figure",
    alt: "The parabola with its tangent drawn as a dashed line touching at the point (4, 3), the tangent labelled with its equation.",
    svg: we1Svg,
    caption: `The finished tangent, $${lineLatex(T.we1.line)}$, touching at $${pointLatex(fr(4), T.we1.y0)}$.`,
  },
  {
    type: "gate",
    id: "g4",
    kind: "blank",
    prompt: `Finish step 4: $y - ${fplain(T.we1.y0)} = ${fplain(T.we1.m)}(x - 4)$ tidies to $y = ${fplain(T.we1.m)}x + \\square$. The missing constant is ___`,
    answer: fplain(T.we1.line.c),
    explain: `Expanding gives ${M(`y - ${fplain(T.we1.y0)} = ${fplain(T.we1.m)}x - 8`)}, so ${M(lineLatex(T.we1.line))}. Adding the 3 to the other side instead is the slip the examiners call the constant.`,
  },
  { type: "h", text: "4. The normal: turn it over, change the sign" },
  {
    type: "p",
    md: `Perpendicular gradients multiply to ${M("-1")}, so the normal's gradient is ${M("-\\frac{1}{m}")}. Two moves again: **turn the fraction over**, then **change the sign**. Doing only one of them is the single commonest loss in this topic.\nA tangent gradient of ${M("5")} gives a normal gradient of ${M("-\\frac{1}{5}")}; a tangent gradient of ${M("-4")} gives ${M("\\frac{1}{4}")}, positive, because the sign changed.`,
  },
  {
    type: "figure",
    alt: "A four-row table pairing tangent gradients 2, 5, minus 4 and minus one third with the normal gradients minus 0.5, minus 0.2, 0.25 and 3, each row showing the product minus one.",
    svg: perpSvg,
    caption: "Both moves, every time: the product of the two gradients is always $-1$.",
  },
  {
    type: "gate",
    id: "g5",
    kind: "number",
    prompt: "The tangent to a curve at $A$ has gradient $5$. What is the gradient of the normal at $A$?",
    answer: `${fplain(perp(fr(5)))} | ${perp(fr(5)).n}/${perp(fr(5)).d}`,
    explain: `Turn 5 over to get $\\frac{1}{5}$, then change the sign: $${flatex(perp(fr(5)))}$. Answering $-5$ means the sign changed but the fraction never turned over.`,
  },
  { type: "h", text: "5. A worked normal, with a negative power" },
  {
    type: "p",
    md: `Find the equation of the normal to ${M(latex(K.we2, { lhs: "y" }))} at the point where ${M("x = 1")}.\n**Step 1.** ${M(latex(deriv(K.we2), { lhs: "\\frac{dy}{dx}" }))}, so at ${M("x = 1")} the tangent gradient is ${M(fplain(T.we2.m))}.\n**Step 2.** The normal gradient is ${M(flatex(T.we2.g))}.\n**Step 3.** From the curve, ${M(`y = ${fplain(T.we2.y0)}`)}.\n**Step 4.** ${M(lineLatex(T.we2.line))}.`,
  },
  {
    type: "figure",
    alt: "The curve y = 2x minus 3 over x drawn on axes with its normal at the point (1, minus 1) shown as a dashed line sloping gently downwards.",
    svg: we2Svg,
    caption: `The normal at $${pointLatex(fr(1), T.we2.y0)}$ is $${lineLatex(T.we2.line)}$.`,
  },
  {
    type: "gate",
    id: "g6",
    kind: "choice",
    prompt: `The normal has gradient $${flatex(T.we2.g)}$ and passes through $${pointLatex(fr(1), T.we2.y0)}$. Which equation is it?`,
    options: [`$${lineLatex(T.we2.line)}$`, `$${lineLatex(constantSlip(T.we2.g, fr(1), T.we2.y0))}$`, `$${lineLatex(lineThrough(T.we2.m, fr(1), T.we2.y0))}$`],
    answer: `$${lineLatex(T.we2.line)}$`,
    explain: `Substituting gives ${M(`${fplain(T.we2.y0)} = ${flatex(T.we2.g)}(1) + c`)}, so ${M(`c = ${flatex(T.we2.line.c)}`)}. The third option is the tangent, not the normal.`,
  },
  { type: "h", text: "6. When the gradient is handed to you" },
  {
    type: "p",
    md: `Questions often give the gradient instead of the point. *Parallel to ${M("y = 3x - 4")}* means ${M("\\frac{dy}{dx} = 3")}. *The gradient of the normal is ${M("\\frac{1}{2}")}* means ${M("\\frac{dy}{dx} = -2")}.\nEither way you solve an equation rather than evaluate one. Setting ${M("\\frac{dy}{dx} = 0")} out of habit answers a different question and earns nothing here.`,
  },
  {
    type: "figure",
    alt: "A curve with a dashed tangent drawn parallel to a second dashed straight line, the point of contact marked P.",
    svg: givenSvg,
    caption: "Parallel lines share a gradient, so the given line's gradient becomes the value of $\\frac{dy}{dx}$.",
  },
  {
    type: "video",
    videoId: "fPElVHyk_XI",
    title: "Differentiation Tangents and Normals - CCEA GCSE Further Mathematics",
    channel: "P McAleavey",
    why: "A Northern Ireland teacher running the whole method against this specification, tangent then normal.",
  },
  {
    type: "gate",
    id: "g7",
    kind: "number",
    prompt: "The normal to a curve at $B$ has gradient $\\frac{1}{2}$. What is $\\frac{dy}{dx}$ at $B$?",
    answer: `${fplain(perp(fr(1, 2)))}`,
    explain: `The tangent gradient is the negative reciprocal of the normal's: turn $\\frac{1}{2}$ over to get 2, then change the sign. Answering $\\frac{1}{2}$ or $-\\frac{1}{2}$ means one of the two moves was skipped.`,
  },
  { type: "h", text: "7. Where the tangent meets the curve again" },
  {
    type: "p",
    md: `A tangent to a cubic touches at one point and usually crosses somewhere else. To find where, set the tangent equal to the curve and solve.\nThe point of contact is always a **repeated** root, so if you know it you can divide it out twice, and what is left gives the other crossing straight away.`,
  },
  {
    type: "figure",
    alt: "A cubic curve with a dashed tangent that touches it on the right and crosses it again on the left, both points marked with their coordinates.",
    svg: meetSvg,
    caption: `The tangent at $${pointLatex(fr(1), T.we3.y0)}$ meets the curve again at $${pointLatex(MEET.we3.x, MEET.we3.y)}$.`,
  },
  {
    type: "gate",
    id: "g8",
    kind: "number",
    prompt: `Setting $${latex(K.we3)} = ${lineLatex(T.we3.line).replace("y = ", "")}$ gives $x^{3} - 3x + 2 = 0$, which factorises as $(x - 1)^{2}(x + 2) = 0$. At what value of $x$ does the tangent cross the curve?`,
    answer: fplain(MEET.we3.x),
    explain: `The repeated factor $(x - 1)^{2}$ is the touching point, so the crossing is at ${M(`x = ${fplain(MEET.we3.x)}`)}, where ${M(`y = ${fplain(MEET.we3.y)}`)}.`,
  },
  {
    type: "callout",
    kind: "mustknow",
    title: "You can now",
    md: "Differentiate, substitute, and write the gradient of a tangent as a number.\nTake the $y$ of the point from the curve and nowhere else.\nAssemble $y - y_{1} = m(x - x_{1})$ and tidy it to $y = mx + c$.\nTurn a tangent gradient over and change its sign to get the normal.\nRead a given gradient as an equation for $\\frac{dy}{dx}$, and find where a tangent meets the curve again.",
  },
  { type: "h", text: "In the exam" },
  {
    type: "p",
    md: "Unit 1 is one two-hour calculator paper of 100 marks. This topic is a late-paper discriminator: **7 marks** for a normal on its own, or **4 + 3 + 2** across tangent, normal and a gradient condition.\nThe wording is *Find the equation of the tangent to this curve where $x = \\ldots$* and *Find the equation of the normal at the point $P$*. The first mark is for $\\frac{dy}{dx}$, and a further mark is given simply for knowing that the normal's gradient is the negative reciprocal, even when the tangent gradient before it is wrong. So write that line down whatever else has happened.",
  },
  {
    type: "figure",
    alt: "A seven-row table listing the lines of a normal question against their mark codes: the derivative, the substitution, the tangent gradient, the negative reciprocal, the y-coordinate, the constant and the finished equation.",
    svg: schemeSvg,
    caption: "Seven lines, seven marks, and the first two need no arithmetic.",
  },
  {
    type: "callout",
