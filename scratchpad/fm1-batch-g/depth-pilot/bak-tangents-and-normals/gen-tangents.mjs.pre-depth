      stem: `If $y = ${latex(K.we1)}$, what is $y$ when $x = 4$?`,
      skill: "Substitute into a quadratic",
      options: [
        { id: "a", text: `$${fplain(T.we1.y0)}$`, correct: true, feedback: "$16 - 24 + 11 = 3$. This is the height of the point, and it comes from the curve." },
        { id: "b", text: `$${fplain(T.we1.m)}$`, correct: false, misconception: "fm.calc.y-from-line-not-curve", feedback: "That is what the derivative gives at $x = 4$, so it is the gradient rather than the height." },
        { id: "c", text: "$51$", correct: false, misconception: "fm.calc.tangent-constant-slip", feedback: "The middle term was added instead of subtracted: $16 - 24 + 11$, not $16 + 24 + 11$." },
      ],
      secondsExpected: 25,
      confidence: true,
      hypercorrectionQueue: true,
    },
  ],
};

const dxPost = {
  id: `dx.fm.u1.${SLUG}.post`,
  topic: TOPIC,
  specRefs: SPEC,
  when: "post",
  items: [
    {
      id: "q1",
      stem: `A curve has $\\frac{dy}{dx} = ${latex(deriv(K.p5))}$. What is the gradient of the **tangent** at the point where $x = 1$?`,
      skill: "Read a tangent gradient from the derivative",
      options: [
        { id: "a", text: `$${fplain(T.p5.m)}$`, correct: true, feedback: "$6(1) - 1 = 5$. The tangent shares the curve's gradient at the point of contact." },
        { id: "b", text: `$${flatex(T.p5.g)}$`, correct: false, misconception: "fm.calc.normal-gradient-not-reciprocated", feedback: "That is the gradient of the normal. The tangent's gradient is the derivative itself, with no reciprocal taken." },
        { id: "c", text: "$-5$", correct: false, misconception: "fm.calc.normal-gradient-not-reciprocated", feedback: "The sign has been changed for no reason. Substituting 1 gives a positive 5." },
      ],
      secondsExpected: 30,
      confidence: true,
      hypercorrectionQueue: true,
    },
    {
      id: "q2",
      stem: "Where does the $y$-coordinate of the point of contact come from?",
      skill: "Identify which expression gives the height",
      options: [
        { id: "a", text: "From the equation of the curve", correct: true, feedback: "The point sits on the curve, so substituting its $x$ into the curve gives its height." },
        { id: "b", text: "From $\\frac{dy}{dx}$", correct: false, misconception: "fm.calc.y-from-line-not-curve", feedback: "The derivative gives the gradient a second time. The height only comes from the curve." },
        { id: "c", text: "From any straight line named in the question", correct: false, misconception: "fm.calc.y-from-line-not-curve", feedback: "A line mentioned in the question usually passes somewhere else entirely. Take the height from the curve." },
      ],
      secondsExpected: 25,
      confidence: true,
      hypercorrectionQueue: true,
    },
    {
      id: "q3",
      stem: "The tangent to a curve at $P$ has gradient $5$. What is the gradient of the normal at $P$?",
      skill: "Form a negative reciprocal",
      options: [
        { id: "a", text: `$${flatex(perp(fr(5)))}$`, correct: true, feedback: "Turn it over, change the sign. $5 \\times -\\frac{1}{5} = -1$, which is what perpendicular means." },
        { id: "b", text: `$${flatex(normalRoutes.notReciprocated(fr(5)))}$`, correct: false, misconception: "fm.calc.normal-gradient-not-reciprocated", feedback: "The sign changed but the number never turned over. $5 \\times -5$ is $-25$, not $-1$." },
        { id: "c", text: `$${flatex(normalRoutes.signNotFlipped(fr(5)))}$`, correct: false, misconception: "fm.calc.normal-sign-not-flipped", feedback: "The number turned over but kept its sign. $5 \\times \\frac{1}{5}$ is $1$, not $-1$." },
      ],
      secondsExpected: 30,
      confidence: true,
      hypercorrectionQueue: true,
    },
    {
      id: "q4",
      stem: `A tangent has gradient $${fplain(T.we1.m)}$ and touches at $${pointLatex(fr(4), T.we1.y0)}$. What is its equation?`,
      skill: "Assemble the line from a gradient and a point",
      options: [
        { id: "a", text: `$${lineLatex(T.we1.line)}$`, correct: true, feedback: "$3 = 2(4) + c$ gives $c = -5$." },
        { id: "b", text: `$${lineLatex(constantSlip(T.we1.m, fr(4), T.we1.y0))}$`, correct: false, misconception: "fm.calc.tangent-constant-slip", feedback: "The $8$ was added instead of taken away. From $3 = 8 + c$, $c$ is $-5$." },
        { id: "c", text: "$y = 4x + 3$", correct: false, misconception: "fm.calc.tangent-constant-slip", feedback: "The coordinates have been used as the gradient and the intercept. The gradient is the number you found from $\\frac{dy}{dx}$." },
      ],
      secondsExpected: 35,
      confidence: true,
      hypercorrectionQueue: true,
    },
    {
      id: "q5",
      stem: `A curve has $\\frac{dy}{dx} = ${latex(deriv(K.p7))}$. What is the gradient of the **normal** at the point where $x = 1$?`,
      skill: "Combine a substitution with a negative reciprocal",
      options: [
        { id: "a", text: `$${flatex(T.p7.g)}$`, correct: true, feedback: "The tangent gradient is $3 + 2 = 5$, so the normal's is $-\\frac{1}{5}$." },
        { id: "b", text: `$${fplain(T.p7.m)}$`, correct: false, misconception: "fm.calc.normal-gradient-not-reciprocated", feedback: "That is the tangent's gradient. The normal is perpendicular to it, so it still needs the negative reciprocal." },
        { id: "c", text: `$${flatex(normalRoutes.signNotFlipped(T.p7.m))}$`, correct: false, misconception: "fm.calc.normal-sign-not-flipped", feedback: "The number turned over but the sign did not change." },
      ],
      secondsExpected: 40,
      confidence: true,
      hypercorrectionQueue: true,
    },
    {
      id: "q6",
      stem: "The tangent to a curve at $P$ is **parallel** to the line $y = 3x - 4$. Which equation do you solve to find $P$?",
      skill: "Turn a parallel condition into an equation",
      options: [
        { id: "a", text: "$\\frac{dy}{dx} = 3$", correct: true, feedback: "Parallel lines have equal gradients, so the derivative is set equal to the line's gradient." },
        { id: "b", text: "$\\frac{dy}{dx} = 0$", correct: false, misconception: "fm.calc.default-to-derivative-zero", feedback: "Zero belongs there only when the question asks for a flat or stationary point. Here a gradient was given." },
        { id: "c", text: `$\\frac{dy}{dx} = ${flatex(perp(fr(3)))}$`, correct: false, misconception: "fm.calc.normal-sign-not-flipped", feedback: "That is the perpendicular gradient. Parallel means the same gradient, not the negative reciprocal." },
      ],
      secondsExpected: 35,
      confidence: true,
      hypercorrectionQueue: true,
    },
    {
      id: "q7",
      stem: "The normal to a curve at $A$ has gradient $\\frac{1}{2}$. What is $\\frac{dy}{dx}$ at $A$?",
      skill: "Work backwards from a normal gradient",
      options: [
        { id: "a", text: `$${fplain(perp(fr(1, 2)))}$`, correct: true, feedback: "The relationship works both ways: the tangent gradient is the negative reciprocal of the normal's." },
        { id: "b", text: `$${flatex(fr(1, 2))}$`, correct: false, misconception: "fm.calc.normal-gradient-not-reciprocated", feedback: "That is the normal's own gradient copied across. The tangent is perpendicular to it." },
        { id: "c", text: `$${flatex(fr(-1, 2))}$`, correct: false, misconception: "fm.calc.normal-sign-not-flipped", feedback: "The sign changed but the fraction never turned over. $\\frac{1}{2} \\times -\\frac{1}{2}$ is not $-1$." },
      ],
      secondsExpected: 35,
      confidence: true,
      hypercorrectionQueue: true,
    },
    {
      id: "q8",
      stem: "To find where a tangent meets its curve a second time, what do you do?",
      skill: "Choose the method for a second intersection",
      options: [
        { id: "a", text: "Set the tangent's equation equal to the curve's and solve", correct: true, feedback: "Both graphs share a $y$ wherever they meet, so that single equation finds every crossing, the point of contact included." },
        { id: "b", text: "Set $\\frac{dy}{dx} = 0$ and solve", correct: false, misconception: "fm.calc.default-to-derivative-zero", feedback: "That finds where the curve is flat, which is a different question entirely." },
        { id: "c", text: "Set the curve equal to zero and solve", correct: false, misconception: "fm.calc.equate-line-and-curve-instead-of-differentiate", feedback: "That finds where the curve meets the $x$-axis. The tangent is the other graph in this question." },
      ],
      secondsExpected: 30,
      confidence: true,
      hypercorrectionQueue: true,
    },
  ],
};

// ---------------------------------------------------------------------------
// questions
// ---------------------------------------------------------------------------

const single = (n, o) => ({
  id: id("q", n),
  topic: TOPIC,
  specRefs: SPEC,
  tier: "untiered",
  paper: PAPER,
  style: o.style ?? "practice",
  difficulty: o.difficulty ?? 3,
  ao: o.ao ?? ["AO1", "AO2"],
  commandWords: o.commandWords ?? ["Find"],
  emphasis: o.emphasis ?? [],
  context: { setting: o.setting, original: true },
  figures: o.figures ?? [],
  parts: [{ id: "main", stem: o.stem, marks: o.marks, answer: o.answer, scheme: o.scheme, hints: o.hints, workedSolution: o.worked, commonErrors: o.errors, requiresWorking: true }],
  totalMarks: o.marks,
  timeAllowanceSec: timeFor(o.marks),
  skeleton: `(main)${o.verb ?? "find"}${o.marks}`,
  examinerSources: o.sources ?? [],
  ...(o.program ? { solutionProgram: o.program } : {}),
  verification: `ver.${id("q", n)}`,
  version: 1,
});

const tangentScheme = (t, { normalStep = false } = {}) => {
  const s = [
    MWs(1, 1, `${M(latex(deriv(normalStep ? t.curve : t.curve), { lhs: "\\frac{dy}{dx}" }))}`),
  ];
  return s;
};

const questions = [];

questions.push(
  single("0001", {
    difficulty: 2,
    setting: "The tangent gradient on its own, as the opening part of a longer question",
    stem: `A curve has the equation ${M(latex(K.p1, { lhs: "y" }))}\nFind the gradient of the tangent to this curve at the point where ${M("x = 1")}.`,
    marks: 2,
    answer: ansNum(T.p1.m),
    scheme: [MWs(1, 1, `${M(latex(deriv(K.p1), { lhs: "\\frac{dy}{dx}" }))}`), Ws(1, 1, `${M(fplain(T.p1.m))}`, { ft: true })],
    hints: ["Differentiate first.", "The tangent's gradient is the curve's gradient at the point of contact."],
    worked: `${M(latex(deriv(K.p1), { lhs: "\\frac{dy}{dx}" }))}.\nAt ${M("x = 1")}: ${M(`2(1) + 5 = ${fplain(T.p1.m)}`)}.\nSo the tangent has gradient ${M(fplain(T.p1.m))}.`,
    errors: [
      errNum("fm.calc.normal-gradient-not-reciprocated", perp(T.p1.m), "That is the gradient of the normal. The tangent's gradient is the derivative itself, with no reciprocal and no sign change.", 1, src("2019-summer", 11)),
      errNum("fm.calc.gradient-read-as-coefficient", fr(5), "That is the coefficient of $x$ in the curve, read as though the graph were a straight line. A curve's gradient always comes from $\\frac{dy}{dx}$.", 0, src("2019-summer", 11)),
    ],
    sources: [src("2019-summer", 11)],
    program: `d/dx ${plain(K.p1)} = ${plain(deriv(K.p1))}; at x = 1 -> ${fplain(T.p1.m)}`,
  }),
);

questions.push(
  single("0002", {
    difficulty: 2,
    setting: "The simplest possible tangent, so the four steps can be seen whole",
    emphasis: ["in the form $y = mx + c$"],
    stem: `A curve has the equation ${M(latex(K.p2, { lhs: "y" }))}\nFind the equation of the tangent to this curve at the point where ${M("x = 3")}.\nGive your answer in the form ${M("y = mx + c")}.`,
    marks: 3,
    answer: ansLine(T.p2.line, true),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p2), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p2.m)}`)}`),
      Ms(1, 1, `the point ${M(pointLatex(fr(3), T.p2.y0))} and a substitution into ${M("y - y_{1} = m(x - x_{1})")}`),
      Ws(1, 1, `${M(lineLatex(T.p2.line))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["Differentiate, then substitute 3.", "Find the height from the curve.", "Then use $y - y_{1} = m(x - x_{1})$."],
    worked: `${M(latex(deriv(K.p2), { lhs: "\\frac{dy}{dx}" }))}, so at ${M("x = 3")} the gradient is ${M(fplain(T.p2.m))}.\nFrom the curve, ${M(`y = ${fplain(T.p2.y0)}`)}.\n${M(`y - ${fplain(T.p2.y0)} = ${fplain(T.p2.m)}(x - 3)`)}, so ${M(lineLatex(T.p2.line))}.`,
    errors: [
      constantSlipError(T.p2.m, fr(3), T.p2.y0, "The gradient and the point are both right, so most of the method is secure.", 2, src("2023-summer", 10)),
      errAlg("fm.calc.y-from-line-not-curve", lineLatex(lineThrough(T.p2.m, fr(3), T.p2.m)), "The gradient is right. The height of the point was taken as the gradient rather than from the curve; substituting 3 into $y = x^{2}$ gives 9.", 1, src("2024-summer", 9)),
    ],
    sources: [src("2023-summer", 10)],
    program: `tangent to ${plain(K.p2)} at x = 3 -> ${linePlain(T.p2.line)}`,
  }),
);

questions.push(
