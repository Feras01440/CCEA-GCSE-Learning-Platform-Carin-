      stem: `At the point ${M("A")} on this curve the normal has gradient ${M(flatex(EXC_G))}.\nFind the coordinates of ${M("A")}.`,
      marks: 3,
      answer: ansPoint(EXC_A),
      scheme: [
        Ws(1, 1, `the tangent gradient ${M(fplain(EXC_M))}`),
        Ms(1, 1, `setting ${M(`${latex(deriv(K.exC))} = ${fplain(EXC_M)}`)}`),
        Ws(2, 1, `${M(pointLatex(EXC_A.x, EXC_A.y))}`, { dependsOn: ["M1"], ft: true }),
      ],
      hints: ["Work the negative reciprocal backwards to get the tangent's gradient.", "Set $\\frac{dy}{dx}$ equal to it.", "Then find $y$ from the curve and write the coordinates."],
      workedSolution: `The normal has gradient ${M(flatex(EXC_G))}, so the tangent has gradient ${M(fplain(EXC_M))}.\n${M(`2x - 2 = ${fplain(EXC_M)}`)} gives ${M(`x = ${fplain(EXC_A.x)}`)}.\nFrom the curve, ${M(`y = 9 + 6 + 5 = ${fplain(EXC_A.y)}`)}.\nSo ${M("A")} is ${M(pointLatex(EXC_A.x, EXC_A.y))}.`,
      commonErrors: [
        errAlg("fm.calc.normal-sign-not-flipped", pointLatex(EXC_FLIP.x, EXC_FLIP.y), "The reciprocal was taken but the sign was left alone, so the tangent gradient came out positive. Perpendicular gradients multiply to $-1$.", 1, src("2024-summer", 9)),
        errAlg("fm.calc.default-to-derivative-zero", pointLatex(EXC_ZERO.x, EXC_ZERO.y), "That is the point where the curve is flat. A gradient was stated here, so $\\frac{dy}{dx}$ is set equal to it rather than to zero.", 1, src("2025-summer", 13)),
        errAlg("fm.calc.answers-equation-not-coordinates", lineLatex(EXC_A_TANGENT), "That is the equation of the tangent at $A$, and the gradient inside it is right. The question asked for the coordinates of $A$, so give the pair.", 2, src("2025-summer", 13)),
      ],
      requiresWorking: true,
    },
  ],
  totalMarks: 7,
  timeAllowanceSec: timeFor(7),
  skeleton: "(a)find4|(b)find3",
  examinerSources: [src("2022-summer", 8), src("2024-summer", 9)],
  solutionProgram: `tangent ${linePlain(T.exC.line)}; perp(${fplain(EXC_G)}) = ${fplain(EXC_M)} -> A ${pointPlain(EXC_A.x, EXC_A.y)}`,
  verification: `ver.${id("q", "0015")}`,
  version: 1,
};

const exD = {
  id: id("q", "0016"),
  topic: TOPIC,
  specRefs: SPEC,
  tier: "untiered",
  paper: PAPER,
  style: "exam-style",
  difficulty: 5,
  ao: ["AO1", "AO2", "AO3"],
  commandWords: ["Find"],
  emphasis: ["is equal to", "is perpendicular to"],
  context: { setting: "A stated tangent gradient, then a second point whose tangent is perpendicular to the first", original: true },
  figures: [],
  parts: [
    {
      id: "a",
      stem: `A curve has the equation ${M(latex(K.exD, { lhs: "y" }))}\nAt the point ${M("P")} the gradient of the tangent to this curve is equal to ${M(fplain(EXD_M))}.\nFind the equation of the tangent to this curve at ${M("P")}.`,
      marks: 5,
      answer: ansLine(EXD_T),
      scheme: [
        MWs(1, 1, `${M(latex(deriv(K.exD), { lhs: "\\frac{dy}{dx}" }))}`),
        Ms(1, 1, `setting ${M(`${latex(deriv(K.exD))} = ${fplain(EXD_M)}`)}`),
        Ws(1, 1, `${M(`x = ${fplain(EXD_P.x)}`)}`, { dependsOn: ["M1"], ft: true }),
        Ws(2, 1, `${M(`y = ${fplain(EXD_P.y)}`)} from the curve`, { ft: true }),
        Ws(3, 1, `${M(lineLatex(EXD_T))}`, { ft: true }),
      ],
      hints: [
        "The gradient is given, so $\\frac{dy}{dx}$ goes equal to it.",
        "Solve for $x$, then find $y$ from the curve.",
        "Finally assemble $y - y_{1} = m(x - x_{1})$.",
      ],
      workedSolution: `${M(latex(deriv(K.exD), { lhs: "\\frac{dy}{dx}" }))}.\nSet it equal to the stated gradient: ${M(`4x - 3 = ${fplain(EXD_M)}`)}, so ${M(`x = ${fplain(EXD_P.x)}`)}.\nFrom the curve, ${M(`y = 8 - 6 + 1 = ${fplain(EXD_P.y)}`)}, so ${M("P")} is ${M(pointLatex(EXD_P.x, EXD_P.y))}.\n${M(`${fplain(EXD_P.y)} = ${fplain(EXD_M)}(${fplain(EXD_P.x)}) + c`)} gives ${M(`c = ${fplain(EXD_T.c)}`)}, so ${M(lineLatex(EXD_T))}.`,
      commonErrors: [
        errAlg("fm.calc.default-to-derivative-zero", lineLatex(lineThrough(fr(0), EXD_ZERO.x, EXD_ZERO.y)), "The derivative was set equal to zero out of habit, which finds the flat point instead. The question stated a gradient of 5, so that is what $\\frac{dy}{dx}$ equals.", 1, src("2025-summer", 13)),
        constantSlipError(EXD_M, EXD_P.x, EXD_P.y, "Gradient and point are both right, so four marks stand.", 4, src("2023-summer", 10)),
      ],
      requiresWorking: true,
    },
    {
      id: "b",
      stem: `The point ${M("Q")} also lies on this curve.\nThe two tangents, at ${M("P")} and at ${M("Q")}, are perpendicular to each other.\nFind the coordinates of ${M("Q")}.`,
      marks: 3,
      answer: ansPoint(EXD_Q),
      scheme: [
        Ws(1, 1, `the gradient at ${M("Q")} is ${M(flatex(EXD_QM))}`),
        Ms(1, 1, `setting ${M(`${latex(deriv(K.exD))} = ${flatex(EXD_QM)}`)}`),
        Ws(2, 1, `${M(pointLatex(EXD_Q.x, EXD_Q.y))}`, { dependsOn: ["M1"], ft: true }),
      ],
      hints: ["Perpendicular tangents have gradients whose product is $-1$.", "Set $\\frac{dy}{dx}$ equal to that new gradient.", "Then find $y$ from the curve and write the pair."],
      workedSolution: `Perpendicular to a gradient of ${M(fplain(EXD_M))} means a gradient of ${M(flatex(EXD_QM))}.\n${M(`4x - 3 = ${flatex(EXD_QM)}`)} gives ${M(`x = ${fplain(EXD_Q.x)}`)}.\nFrom the curve, ${M(`y = ${fplain(EXD_Q.y)}`)}.\nSo ${M("Q")} is ${M(pointLatex(EXD_Q.x, EXD_Q.y))}.`,
      commonErrors: [
        errAlg("fm.calc.normal-gradient-not-reciprocated", pointLatex(EXD_NOTRECIP.x, EXD_NOTRECIP.y), "The method is right and the point is found properly, so a mark stands. The perpendicular gradient needs the number turned over as well as the sign changed.", 1, src("2019-summer", 11)),
        errAlg("fm.calc.normal-sign-not-flipped", pointLatex(EXD_FLIP.x, EXD_FLIP.y), "The reciprocal was taken but the sign was left alone, so the gradient used was positive. The product of two perpendicular gradients is $-1$.", 1, src("2024-summer", 9)),
        errAlg("fm.calc.stopped-at-the-gradient", flatex(EXD_QM), "The perpendicular gradient is right, and that is the hardest step. The question asks for the coordinates of $Q$, so carry on: set $\\frac{dy}{dx}$ equal to it, solve, then find $y$ from the curve.", 1, src("2025-summer", 13)),
        errAlg("fm.calc.answers-equation-not-coordinates", lineLatex(EXD_Q_TANGENT), "That is the equation of the tangent at $Q$, built correctly from the right gradient. The answer line wanted the coordinates of $Q$ instead.", 2, src("2025-summer", 13)),
      ],
      requiresWorking: true,
      followThrough: { fromPart: "a", rule: "use-candidate-value" },
    },
  ],
  totalMarks: 8,
  timeAllowanceSec: timeFor(8),
  skeleton: "(a)find5|(b)find3",
  examinerSources: [src("2025-summer", 13)],
  solutionProgram: `solve ${plain(deriv(K.exD))} = 5 -> P ${pointPlain(EXD_P.x, EXD_P.y)}; tangent ${linePlain(EXD_T)}; perp -> Q ${pointPlain(EXD_Q.x, EXD_Q.y)}`,
  verification: `ver.${id("q", "0016")}`,
  version: 1,
};

const allQuestions = [...questions, exA, exB, exC, exD];

// ---------------------------------------------------------------------------
// find the mistake
// ---------------------------------------------------------------------------

const ftmA = lineThrough(normalRoutes.notReciprocated(T.p6.m), fr(5), T.p6.y0);
const ftm01 = {
  id: id("ftm", "01"),
  topic: TOPIC,
  specRefs: SPEC,
  stem: `Eimear was asked for the equation of the normal to ${M(latex(K.p6, { lhs: "y" }))} at the point where ${M("x = 5")}. Her working:`,
  studentWorking: [
    `dy/dx = ${plain(deriv(K.p6))}`,
    `at x = 5: m = ${fplain(T.p6.m)}`,
    `gradient of normal = ${fplain(normalRoutes.notReciprocated(T.p6.m))}`,
    `y = 25 - 40 + 3 = ${fplain(T.p6.y0)}`,
    `${fplain(T.p6.y0)} = ${fplain(normalRoutes.notReciprocated(T.p6.m))}(5) + c, so c = ${fplain(ftmA.c)}`,
    `normal: ${linePlain(ftmA)}`,
  ],
  mistakeLine: 3,
  misconception: "fm.calc.normal-gradient-not-reciprocated",
  whatWentWrong: `Lines 1, 2 and 4 are all right, and lines 5 and 6 are accurate work on the number line 3 handed them.\nLine 3 changed the sign of the tangent's gradient but never turned it over. The normal's gradient is ${M(`-\\frac{1}{${fplain(T.p6.m)}}`)}, which is ${M(flatex(T.p6.g))}, not ${M(fplain(normalRoutes.notReciprocated(T.p6.m)))}.\nThe quickest check is the product: perpendicular gradients multiply to ${M("-1")}, and ${M(`${fplain(T.p6.m)} \\times ${fplain(normalRoutes.notReciprocated(T.p6.m))} = -4`)}.`,
  correction: [
    `gradient of normal = ${fplain(T.p6.g)}`,
    `${fplain(T.p6.y0)} = ${fplain(T.p6.g)}(5) + c, so c = ${fplain(T.p6.line.c)}`,
    `normal: ${linePlain(T.p6.line)}`,
  ],
  marksEarnedAsWritten: ["MW1", "M1"],
  feedback: `The derivative, the substitution and the point are all right, so the method marks stand and CCEA marks the rest on follow-through. Say the two moves out loud as you write the normal's gradient: turn it over, then change the sign. Then multiply the two gradients together; if the answer is not ${M("-1")}, one of the moves was missed.`,
  source: src("2019-summer", 11),
};

const ftmB = lineThrough(normalRoutes.signNotFlipped(T.p9.m), fr(2), T.p9.y0);
const ftm02 = {
  id: id("ftm", "02"),
  topic: TOPIC,
  specRefs: SPEC,
  stem: `Ruairi was asked for the equation of the normal to ${M(latex(K.p9, { lhs: "y" }))} at the point where ${M("x = 2")}. His working:`,
  studentWorking: [
    "y = 2x - 12x^-1",
    `dy/dx = ${plain(deriv(K.p9))}`,
    `at x = 2: m = 2 + 3 = ${fplain(T.p9.m)}`,
    `gradient of normal = ${fplain(normalRoutes.signNotFlipped(T.p9.m))}`,
    `y = 4 - 6 = ${fplain(T.p9.y0)}`,
    `normal: ${linePlain(ftmB)}`,
  ],
  mistakeLine: 4,
  misconception: "fm.calc.normal-sign-not-flipped",
  whatWentWrong: `Line 1 is the rewrite most candidates forget, and line 2 gets the sign of the second term right, which is the hard part of this derivative.\nLine 4 turned the gradient over but left it positive. A normal is perpendicular, and perpendicular gradients multiply to ${M("-1")}, so ${M(flatex(T.p9.g))} is needed rather than ${M(fplain(normalRoutes.signNotFlipped(T.p9.m)))}.\nEverything after line 4 is careful work on a gradient that points the wrong way.`,
  correction: [
    `gradient of normal = ${fplain(T.p9.g)}`,
    `${fplain(T.p9.y0)} = ${fplain(T.p9.g)}(2) + c, so c = ${fplain(T.p9.line.c)}`,
    `normal: ${linePlain(T.p9.line)}`,
  ],
  marksEarnedAsWritten: ["MW1", "M1"],
  feedback: `Two of the four marks are safe, and the differentiation here is better than most. The reciprocal on its own only makes the two lines equally steep, not perpendicular; the minus sign is what turns one of them through ${M("90^{\\circ}")}. Multiply the two gradients as a check before you go on.`,
  source: src("2024-summer", 9),
};

const ftm03 = {
  id: id("ftm", "03"),
  topic: TOPIC,
  specRefs: SPEC,
  stem: `Sinead was asked for the equation of the tangent at ${M("P")}, where ${M("x = -2")}, to the curve ${M(latex(EXB_CURVE, { lhs: "y" }))}, knowing the tangent there is parallel to ${M(lineLatex({ m: EXB.lineM, c: EXB.lineC }))}. Her working:`,
  studentWorking: [
    "tangent is parallel to the line, so m = 2",
    "at x = -2 the line gives y = 2(-2) - 7 = -11",
    "y - (-11) = 2(x - (-2))",
    "tangent: y = 2x - 7",
  ],
  mistakeLine: 2,
  misconception: "fm.calc.y-from-line-not-curve",
  whatWentWrong: `Line 1 is exactly right, and it is the step the reports say most candidates miss: parallel means the same gradient, so ${M(`m = ${fplain(EXB.lineM)}`)}.\nLine 2 then took the height of ${M("P")} from the **straight line** instead of from the curve. ${M("P")} lies on the curve, so ${M("x = -2")} has to go into ${M(latex(EXB_CURVE, { lhs: "y" }))}, which gives ${M(fplain(EXB_T.y0))}.\nBecause the wrong height came from the line itself, line 4 simply reproduces that line, which is why the answer looks tidy and is worth nothing.`,
  correction: [
    `at x = -2 the curve gives y = 3 + 8/4 = ${fplain(EXB_T.y0)}`,
    `${fplain(EXB_T.y0)} = 2(-2) + c, so c = ${fplain(EXB_T.line.c)}`,
    `tangent: ${linePlain(EXB_T.line)}`,
  ],
  marksEarnedAsWritten: ["W1"],
  feedback: `Reading the parallel condition correctly is worth a mark, and it is the half of the question the examiners report as the hard one. The other half is knowing which graph the point belongs to: ${M("P")} is on the curve, so every coordinate of ${M("P")} comes from the curve. When your tangent turns out to be the line the question gave you, that is the signal.`,
  source: src("2024-summer", 9),
};

// ---------------------------------------------------------------------------
// prompts
// ---------------------------------------------------------------------------

const prompts = [
  { id: id("rp", "01"), kind: "procedure", prompt: "Give the four steps for the equation of a tangent at a named point.", answer: "Differentiate; substitute the $x$ of the point to get $m$; substitute the same $x$ into the curve to get $y$; put $m$ and the point into $y - y_{1} = m(x - x_{1})$.", keyWords: ["differentiate", "substitute", "curve", "y - y1"], difficultyPrior: 4 },
  { id: id("rp", "02"), kind: "formula", prompt: "How is the gradient of a normal found from the gradient of the tangent?", answer: "Take the negative reciprocal: turn the gradient over, then change the sign, so the two gradients multiply to $-1$.", keyWords: ["negative reciprocal", "turn it over", "change the sign"], difficultyPrior: 3 },
  { id: id("rp", "03"), kind: "trap", prompt: "Where does the $y$-coordinate of the point of contact come from?", answer: "From the curve. Not from $\\frac{dy}{dx}$, and not from any straight line the question mentions.", keyWords: ["curve", "not the derivative"], difficultyPrior: 5 },
  { id: id("rp", "04"), kind: "trap", prompt: "A tangent is parallel to $y = 3x - 4$. What equation do you solve?", answer: "$\\frac{dy}{dx} = 3$, because parallel lines have equal gradients.", keyWords: ["3", "equal gradients"], difficultyPrior: 5 },
  { id: id("rp", "05"), kind: "trap", prompt: "The normal at $A$ has gradient $\\frac{1}{2}$. What is $\\frac{dy}{dx}$ at $A$?", answer: "$-2$, the negative reciprocal, because the relationship works in both directions.", keyWords: ["-2", "negative reciprocal"], difficultyPrior: 6 },
  { id: id("rp", "06"), kind: "procedure", prompt: "How do you find where a tangent meets its curve again?", answer: "Set the tangent's equation equal to the curve's, collect to zero and solve; the point of contact is a repeated root.", keyWords: ["equal", "repeated root", "solve"], difficultyPrior: 7 },
  { id: id("rp", "07"), kind: "trap", prompt: "Why must a term such as $\\frac{3}{x}$ be rewritten before you differentiate it?", answer: "The power rule is written for powers of $x$, so it becomes $3x^{-1}$ first.", keyWords: ["power rule", "3x"], difficultyPrior: 5 },
  { id: id("rp", "08"), kind: "qa", prompt: "Which single line earns a mark even when the gradient before it is wrong?", answer: "The normal's gradient written as the negative reciprocal of your own tangent gradient; CCEA credits it on follow-through.", keyWords: ["negative reciprocal", "follow-through"], difficultyPrior: 6 },
  { id: id("rp", "09"), kind: "trap", prompt: "A question asks for the coordinates of $Q$ and you have found the perpendicular gradient. What is still to do?", answer: "Set $\\frac{dy}{dx}$ equal to that gradient, solve for $x$, then find $y$ from the curve and write the pair.", keyWords: ["solve", "curve", "pair"], difficultyPrior: 7 },
  { id: id("rp", "10"), kind: "definition", prompt: "In one sentence each, what are a tangent and a normal?", answer: "A tangent is the straight line that touches the curve and travels in its direction; a normal is the straight line through the same point at right angles to the tangent.", keyWords: ["touches", "right angles", "straight line"], difficultyPrior: 3 },
].map((p) => ({ ...p, topic: TOPIC, specRefs: SPEC, examUnit: "FM1" }));

