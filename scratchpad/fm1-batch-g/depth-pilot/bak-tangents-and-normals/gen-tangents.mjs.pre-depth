        { id: "b", text: `$${lineLatex(constantSlip(fr(4), fr(2), fr(5)))}$`, correct: false, misconception: "fm.calc.tangent-constant-slip", feedback: "The $8$ was added instead of taken away. From $5 = 8 + c$, $c$ is $-3$." },
        { id: "c", text: "$y = 2x + 5$", correct: false, misconception: "fm.calc.tangent-constant-slip", feedback: "The coordinates have been used as the gradient and the intercept. The gradient was given as 4." },
