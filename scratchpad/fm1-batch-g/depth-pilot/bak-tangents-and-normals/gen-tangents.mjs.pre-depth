      Ws(1, 1, `${M(lineLatex(T.p8.line))}`, { dependsOn: ["M2"], ft: true }),
    ],
    hints: ["Rewrite $\\frac{8}{x}$ as $8x^{-1}$ first.", "The derivative is $-8x^{-2}$.", "The height at $x = 2$ is $\\frac{8}{2}$."],
    worked: `Rewrite: ${M(latex(K.p8, { lhs: "y", style: "index" }))}, so ${M(latex(deriv(K.p8), { lhs: "\\frac{dy}{dx}" }))}.\nAt ${M("x = 2")}: ${M(`m = -\\frac{8}{4} = ${fplain(T.p8.m)}`)}.\nFrom the curve, ${M(`y = ${fplain(T.p8.y0)}`)}.\n${M(`y - ${fplain(T.p8.y0)} = ${fplain(T.p8.m)}(x - 2)`)} gives ${M(lineLatex(T.p8.line))}.`,
    errors: [
      errAlg("fm.calc.negative-power-differentiation", lineLatex(lineThrough(at(route("negPowerSignKept", K.p8), fr(2)), fr(2), T.p8.y0)), "The point is right and the index stepped down correctly. Multiplying 8 by the power $-1$ makes the gradient negative, so the tangent slopes down.", 2, src("2019-summer", 11)),
      errAlg("fm.calc.index-moved-to-numerator", lineLatex(lineThrough(at(route("indexMovedUp", K.p8), fr(2)), fr(2), T.p8.y0)), "The curve was lifted to the top line as $8x$ before it was differentiated. Crossing the line changes the sign of the index.", 1, src("2024-summer", 1)),
      constantSlipError(T.p8.m, fr(2), T.p8.y0, "Gradient and point are both right.", 3, src("2023-summer", 10)),
    ],
    sources: [src("2019-summer", 11)],
    program: `tangent to ${plain(K.p8)} at x = 2 -> ${linePlain(T.p8.line)}`,
  }),
);

questions.push(
  single("0009", {
    difficulty: 4,
    setting: "A normal to a curve with a negative power, the 2019 discriminator rebuilt",
    stem: `A curve has the equation ${M(latex(K.p9, { lhs: "y" }))}\nFind the equation of the normal to this curve at the point where ${M("x = 2")}.`,
    marks: 4,
    answer: ansLine(T.p9.line),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p9), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p9.m)}`)}`),
      Ws(1, 1, `normal gradient ${M(flatex(T.p9.g))}`, { ft: true }),
      Ms(1, 1, `the point ${M(pointLatex(fr(2), T.p9.y0))}`),
      Ws(2, 1, `${M(lineLatex(T.p9.line))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["Rewrite the fraction as $-12x^{-1}$ before differentiating.", "Two negatives make the second term of the derivative positive.", "Then the negative reciprocal, then the point."],
    worked: `Rewrite: ${M(latex(K.p9, { lhs: "y", style: "index" }))}, so ${M(latex(deriv(K.p9), { lhs: "\\frac{dy}{dx}" }))}.\nAt ${M("x = 2")}: ${M(`2 + 3 = ${fplain(T.p9.m)}`)}, so the normal's gradient is ${M(flatex(T.p9.g))}.\nFrom the curve, ${M(`4 - 6 = ${fplain(T.p9.y0)}`)}.\n${M(`${fplain(T.p9.y0)} = ${flatex(T.p9.g)}(2) + c`)} gives ${M(`c = ${flatex(T.p9.line.c)}`)}, so ${M(lineLatex(T.p9.line))}.`,
    errors: [
      errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(normalRoutes.notReciprocated(T.p9.m), fr(2), T.p9.y0)), "The derivative, the substitution and the point are all right. The normal's gradient needs the number turned over as well as the sign changed.", 2, src("2019-summer", 11)),
      errAlg("fm.calc.negative-power-differentiation", lineLatex(lineThrough(perp(at(route("negPowerSignKept", K.p9), fr(2))), fr(2), T.p9.y0)), "The reciprocal and the point are right. In the derivative, $-12$ multiplied by the power $-1$ gives $+12$, so that term is added.", 1, src("2019-summer", 11)),
      constantSlipError(T.p9.g, fr(2), T.p9.y0, "Everything up to the last line is right.", 3, src("2023-summer", 10)),
    ],
    sources: [src("2019-summer", 11)],
    program: `normal to ${plain(K.p9)} at x = 2 -> ${linePlain(T.p9.line)}`,
  }),
);

questions.push(
  single("0010", {
    difficulty: 3,
    setting: "A stated tangent gradient, so the derivative becomes an equation",
    stem: `A curve has the equation ${M(latex(K.p10, { lhs: "y" }))}\nAt the point ${M("B")} on this curve the tangent has gradient ${M("5")}.\nFind the coordinates of ${M("B")}.`,
    marks: 3,
    answer: ansPoint(P10_P),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p10), { lhs: "\\frac{dy}{dx}" }))}`),
      Ms(1, 1, `setting ${M(`${latex(deriv(K.p10))} = 5`)}`),
      Ws(1, 1, `${M(pointLatex(P10_P.x, P10_P.y))} as a coordinate pair`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["The gradient is given, so it belongs on the right of an equation.", "Solve for $x$.", "Then find $y$ from the curve and write the pair."],
    worked: `${M(latex(deriv(K.p10), { lhs: "\\frac{dy}{dx}" }))}.\nSet it equal to the given gradient: ${M("2x - 3 = 5")}, so ${M(`x = ${fplain(P10_P.x)}`)}.\nFrom the curve, ${M(`y = 16 - 12 + 4 = ${fplain(P10_P.y)}`)}.\nSo ${M("B")} is ${M(pointLatex(P10_P.x, P10_P.y))}.`,
    errors: [
      errAlg("fm.calc.default-to-derivative-zero", pointLatex(P10_ZERO.x, P10_ZERO.y), "That is the point where the gradient is zero. The question stated a gradient of 5, so the equation to solve is $\\frac{dy}{dx} = 5$.", 1, src("2025-summer", 13)),
      errAlg("fm.calc.stationary-y-from-derivative", pointLatex(P10_P.x, fr(5)), "The $x$-coordinate is right, so two of the three marks stand. The second coordinate is the height of the curve there, not the gradient you were given.", 2, src("2025-summer", 11)),
    ],
    sources: [src("2025-summer", 13)],
    program: `solve ${plain(deriv(K.p10))} = 5 -> ${pointPlain(P10_P.x, P10_P.y)}`,
  }),
);

questions.push(
  single("0011", {
    difficulty: 4,
    setting: "A stated normal gradient, so the negative reciprocal has to be taken backwards",
    stem: `A curve has the equation ${M(latex(K.p11, { lhs: "y" }))}\nAt the point ${M("A")} on this curve the normal has gradient ${M(flatex(P11_G))}.\nFind the coordinates of ${M("A")}.`,
    marks: 3,
    answer: ansPoint(P11_P),
    scheme: [
      Ws(1, 1, `the tangent gradient ${M(fplain(P11_M))} from the negative reciprocal`),
      Ms(1, 1, `setting ${M(`${latex(deriv(K.p11))} = ${fplain(P11_M)}`)}`),
      Ws(2, 1, `${M(pointLatex(P11_P.x, P11_P.y))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["The relationship works both ways: turn the normal's gradient over and change its sign.", "That gives $\\frac{dy}{dx}$ at $A$.", "Solve, then find $y$ from the curve."],
    worked: `The normal has gradient ${M(flatex(P11_G))}, so the tangent has gradient ${M(fplain(P11_M))}.\n${M(latex(deriv(K.p11), { lhs: "\\frac{dy}{dx}" }))}, so ${M(`4x - 1 = ${fplain(P11_M)}`)} and ${M(`x = ${fplain(P11_P.x)}`)}.\nFrom the curve, ${M(P11_SUBST)}.\nSo ${M("A")} is ${M(pointLatex(P11_P.x, P11_P.y))}.`,
    errors: [
      errAlg("fm.calc.normal-gradient-not-reciprocated", pointLatex(P11_WRONG.x, P11_WRONG.y), "The method is right, so the structure of the answer is sound. The tangent gradient was taken as the normal's with the sign changed; it also has to be turned over.", 1, src("2024-summer", 9)),
      errAlg("fm.calc.normal-sign-not-flipped", pointLatex(P11_FLIP.x, P11_FLIP.y), "The reciprocal was taken but the sign was left alone. The two gradients must multiply to $-1$.", 1, src("2024-summer", 9)),
      errAlg("fm.calc.stationary-y-from-derivative", pointLatex(P11_P.x, P11_M), "The $x$-coordinate is right. The second coordinate comes from substituting into the curve, not from the gradient.", 2, src("2025-summer", 11)),
    ],
    sources: [src("2024-summer", 9)],
    program: `perp(${fplain(P11_G)}) = ${fplain(P11_M)}; solve ${plain(deriv(K.p11))} = ${fplain(P11_M)} -> ${pointPlain(P11_P.x, P11_P.y)}`,
  }),
);

questions.push(
  single("0012", {
    difficulty: 4,
    setting: "A tangent to a cubic that crosses the curve a second time",
    stem: `The tangent to ${M(latex(K.p12, { lhs: "y" }))} at the point where ${M("x = -1")} meets that curve a second time, at the point ${M("C")}.\nFind the coordinates of ${M("C")}.`,
    marks: 4,
    answer: ansPoint(MEET.p12),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p12), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p12.m)}`)}`),
      Ws(1, 1, `the tangent ${M(lineLatex(T.p12.line))}`, { ft: true }),
      Ms(1, 1, `setting the curve equal to the tangent and collecting to zero`),
      Ws(2, 1, `${M(pointLatex(MEET.p12.x, MEET.p12.y))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["Find the tangent first, in the usual four steps.", "Then set the curve equal to the tangent.", "$x = -1$ is a repeated root, so $(x + 1)^{2}$ is a factor."],
    worked: `${M(latex(deriv(K.p12), { lhs: "\\frac{dy}{dx}" }))}, so at ${M("x = -1")} the gradient is ${M(fplain(T.p12.m))} and the point is ${M(pointLatex(fr(-1), T.p12.y0))}.\nThe tangent is ${M(lineLatex(T.p12.line))}.\nSetting the curve equal to it: ${M("x^{3} - 3x - 2 = 0")}, and since the line touches at ${M("x = -1")} that root repeats: ${M("(x + 1)^{2}(x - 2) = 0")}.\nSo ${M(`x = ${fplain(MEET.p12.x)}`)} and ${M(`y = ${fplain(MEET.p12.y)}`)}, giving ${M(pointLatex(MEET.p12.x, MEET.p12.y))}.`,
    errors: [
      errAlg("fm.calc.default-to-derivative-zero", pointLatex(fr(-1), T.p12.y0), "That is the point the tangent touches at, which the question already gave you. The second point is the other root of the equation where the two graphs meet.", 2, src("2025-summer", 13)),
      errAlg("fm.calc.equate-line-and-curve-instead-of-differentiate", pointLatex(fr(2), fr(0)).replace(pointLatex(fr(2), fr(0)), lineLatex(T.p12.line)), "That is the equation of the tangent, and it is correct. The question asked where that tangent meets the curve again, so it has to be set equal to the curve and solved.", 2, src("2024-summer", 9)),
    ],
    sources: [src("2024-summer", 9)],
    program: `tangent to ${plain(K.p12)} at x = -1 -> ${linePlain(T.p12.line)}; meets again at ${pointPlain(MEET.p12.x, MEET.p12.y)}`,
  }),
);

// --- exam-style ------------------------------------------------------------

const exA = single("0013", {
  style: "exam-style",
  difficulty: 4,
  ao: ["AO1", "AO2", "AO3"],
  setting: "A single seven-mark normal on a cubic, the shape of Summer 2023 Question 10",
  emphasis: ["in the form $y = mx + c$"],
  stem: `A curve has the equation ${M(latex(K.exA, { lhs: "y" }))}\nFind the equation of the normal to this curve at the point ${M(pointLatex(fr(-1), T.exA.y0))}.\nGive your answer in the form ${M("y = mx + c")}.`,
  marks: 7,
  answer: ansLine(T.exA.line, true),
  scheme: [
    MWs(1, 1, `${M(latex(deriv(K.exA), { lhs: "\\frac{dy}{dx}" }))}`),
    Ms(1, 1, `substituting ${M("x = -1")} into ${M("\\frac{dy}{dx}")}`),
    Ws(1, 1, `the tangent gradient ${M(fplain(T.exA.m))}`, { dependsOn: ["M1"] }),
    Ws(2, 1, `the normal gradient ${M(flatex(T.exA.g))}`, { ft: true }),
    Ms(2, 1, `checking or using ${M(`y = ${fplain(T.exA.y0)}`)} at ${M("x = -1")}`),
    Ms(3, 1, `substituting the point into ${M("y - y_{1} = m(x - x_{1})")}`),
    Ws(3, 1, `${M(lineLatex(T.exA.line))}`, { dependsOn: ["M3"], ft: true }),
  ],
  hints: [
    "Differentiate the cubic first: the derivative is a quadratic.",
    "Substitute $-1$ carefully, with brackets.",
    "Turn the tangent gradient over and change its sign.",
    "The point is given, so go straight to $y - y_{1} = m(x - x_{1})$.",
  ],
  worked: `${M(latex(deriv(K.exA), { lhs: "\\frac{dy}{dx}" }))}.\nAt ${M("x = -1")}: ${M(`3(-1)^{2} + 4(-1) - 4 = 3 - 4 - 4 = ${fplain(T.exA.m)}`)}.\nThe normal's gradient is ${M(`-\\frac{1}{${fplain(T.exA.m)}} = ${flatex(T.exA.g)}`)}.\nThe point is ${M(pointLatex(fr(-1), T.exA.y0))}, which the curve confirms: ${M(`-1 + 2 + 4 + 1 = ${fplain(T.exA.y0)}`)}.\n${M(`${fplain(T.exA.y0)} = ${flatex(T.exA.g)}(-1) + c`)} gives ${M(`c = ${flatex(T.exA.line.c)}`)}, so ${M(lineLatex(T.exA.line))}.`,
  errors: [
    errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(normalRoutes.notReciprocated(T.exA.m), fr(-1), T.exA.y0)), "The derivative and the substitution are right, so four marks stand. The normal's gradient needs the number turned over as well as the sign changed.", 4, src("2019-summer", 11)),
    errAlg("fm.calc.normal-sign-not-flipped", lineLatex(lineThrough(normalRoutes.signNotFlipped(T.exA.m), fr(-1), T.exA.y0)), "The reciprocal is there and the point is right. The sign still has to change, because the two gradients multiply to $-1$.", 4, src("2024-summer", 9)),
    constantSlipError(T.exA.g, fr(-1), T.exA.y0, "Gradient, reciprocal and point are all right, so six marks stand.", 6, src("2023-summer", 10)),
    errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(T.exA.m, fr(-1), T.exA.y0)), "That is the tangent at the point, and the working behind it is sound. The question asked for the normal, which is perpendicular to it.", 4, src("2019-summer", 11)),
  ],
  sources: [src("2019-summer", 11), src("2023-summer", 10)],
  program: `normal to ${plain(K.exA)} at x = -1 -> ${linePlain(T.exA.line)}`,
  figures: [],
});

const exB = {
  id: id("q", "0014"),
  topic: TOPIC,
  specRefs: SPEC,
  tier: "untiered",
  paper: PAPER,
  style: "exam-style",
  difficulty: 5,
  ao: ["AO1", "AO2", "AO3"],
  commandWords: ["Find"],
  emphasis: ["parallel to the straight line"],
  context: { setting: "A gradient condition that fixes an unknown coefficient, then the tangent and normal that follow", original: true },
  figures: [dataFigure(givenSvg, "A curve drawn on axes with a dashed tangent parallel to a second dashed straight line, the point of contact marked P.")],
  parts: [
    {
      id: "a",
      stem: `At the point ${M("P")}, where ${M("x = -2")}, the tangent to ${M(latex(EXB_CURVE, { lhs: "y" }).replace(String(EXB_A.n), "a"))} runs parallel to the straight line ${M(lineLatex({ m: EXB.lineM, c: EXB.lineC }))}\nFind the value of ${M("a")}.`,
      marks: 4,
      answer: ansNum(EXB_A),
      scheme: [
        Ms(1, 1, `writing the curve as ${M("y = 3 + ax^{-2}")}`),
        MWs(1, 1, `${M("\\frac{dy}{dx} = -2ax^{-3}")}`, { dependsOn: ["M1"] }),
        Ms(2, 1, `setting ${M("\\frac{dy}{dx}")} at ${M("x = -2")} equal to ${M(fplain(EXB.lineM))}`),
        Ws(1, 1, `${M(`a = ${fplain(EXB_A)}`)}`, { dependsOn: ["M2"], ft: true }),
      ],
      hints: [
        "Parallel lines have equal gradients, so $\\frac{dy}{dx}$ at $P$ is the line's gradient.",
        "Write the curve with a negative index before differentiating.",
        "$\\frac{dy}{dx} = -2ax^{-3}$, and $(-2)^{3} = -8$.",
      ],
      workedSolution: `Write the curve as ${M("y = 3 + ax^{-2}")}, so ${M("\\frac{dy}{dx} = -2ax^{-3}")}.\nAt ${M("x = -2")}: ${M("\\frac{-2a}{-8} = \\frac{a}{4}")}.\nParallel to ${M(lineLatex({ m: EXB.lineM, c: EXB.lineC }))} means that gradient is ${M(fplain(EXB.lineM))}, so ${M(`\\frac{a}{4} = ${fplain(EXB.lineM)}`)} and ${M(`a = ${fplain(EXB_A)}`)}.`,
      commonErrors: [
        errNum("fm.calc.equate-line-and-curve-instead-of-differentiate", EXB_A_EQUATED, "The curve was set equal to the line instead of being differentiated. Parallel is a statement about gradients, so the derivative is what the line's gradient is compared with.", 0, src("2024-summer", 9)),
        errNum("fm.calc.negative-power-differentiation", EXB_A_SIGNKEPT, "The index stepped down correctly. Multiplying $a$ by the power $-2$ makes the derivative negative, which changes the sign of the answer.", 2, src("2025-summer", 8)),
        errNum("fm.calc.power-not-reduced", EXB_A_POWERKEPT, "The coefficient is handled correctly. The index still has to step down, from $-2$ to $-3$, before $-2$ is substituted.", 2, src("2025-summer", 8)),
      ],
      requiresWorking: true,
    },
    {
      id: "b",
      stem: `Find the equation of the tangent to this curve at ${M("P")}.`,
      marks: 3,
      answer: ansLine(EXB_T.line),
      scheme: [
        MWs(1, 1, `${M(`y = ${fplain(EXB_T.y0)}`)} at ${M("x = -2")}, from the curve`),
        Ms(1, 1, `substituting the point and ${M(`m = ${fplain(EXB_T.m)}`)} into the line formula`),
        Ws(1, 1, `${M(lineLatex(EXB_T.line))}`, { dependsOn: ["M1"], ft: true }),
      ],
      hints: ["The gradient is the one the question gave you.", "Find the height by substituting $-2$ into the curve with your value of $a$.", "Then build the line."],
      workedSolution: `With ${M(`a = ${fplain(EXB_A)}`)} the curve is ${M(latex(EXB_CURVE, { lhs: "y" }))}, so at ${M("x = -2")}, ${M(`y = 3 + \\frac{8}{4} = ${fplain(EXB_T.y0)}`)}.\nThe tangent's gradient is ${M(fplain(EXB_T.m))}, so ${M(`${fplain(EXB_T.y0)} = ${fplain(EXB_T.m)}(-2) + c`)} and ${M(`c = ${fplain(EXB_T.line.c)}`)}.\nThe tangent is ${M(lineLatex(EXB_T.line))}.`,
      commonErrors: [
        errAlg("fm.calc.y-from-line-not-curve", lineLatex({ m: EXB.lineM, c: EXB.lineC }), "The height of $P$ was taken from the given straight line rather than from the curve, which reproduces that line exactly. Substitute $-2$ into the curve instead.", 1, src("2024-summer", 9)),
        constantSlipError(EXB_T.m, EXB.x0, EXB_T.y0, "The gradient and the point are right.", 2, src("2023-summer", 10)),
      ],
      requiresWorking: true,
      followThrough: { fromPart: "a", rule: "use-candidate-value" },
    },
    {
      id: "c",
      stem: `Find the equation of the normal to this curve at ${M("P")}.\nGive your answer in the form ${M("y = mx + c")}.`,
      marks: 2,
      answer: ansLine(EXB_N.line, true),
      scheme: [
        Ws(1, 1, `the normal gradient ${M(flatex(EXB_N.g))}`, { ft: true }),
        Ws(2, 1, `${M(lineLatex(EXB_N.line))}`, { ft: true }),
      ],
      hints: ["Turn the tangent's gradient over and change the sign.", "The point is the same one you used in part (b)."],
      workedSolution: `The tangent's gradient is ${M(fplain(EXB_T.m))}, so the normal's is ${M(flatex(EXB_N.g))}.\nThrough ${M(pointLatex(EXB.x0, EXB_T.y0))}: ${M(`${fplain(EXB_T.y0)} = ${flatex(EXB_N.g)}(-2) + c`)} gives ${M(`c = ${fplain(EXB_N.line.c)}`)}.\nThe normal is ${M(lineLatex(EXB_N.line))}.`,
      commonErrors: [
        errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(normalRoutes.notReciprocated(EXB_T.m), EXB.x0, EXB_T.y0)), "The point is right. The normal's gradient needs the number turned over as well as the sign changed; here only the sign changed.", 1, src("2024-summer", 9)),
        errAlg("fm.calc.normal-sign-not-flipped", lineLatex(lineThrough(normalRoutes.signNotFlipped(EXB_T.m), EXB.x0, EXB_T.y0)), "The reciprocal is there. The sign still has to change for the two gradients to multiply to $-1$.", 1, src("2024-summer", 9)),
      ],
      requiresWorking: true,
      followThrough: { fromPart: "b", rule: "use-candidate-value" },
    },
  ],
  totalMarks: 9,
  timeAllowanceSec: timeFor(9),
  skeleton: "(a)find4|(b)find3|(c)find2",
  examinerSources: [src("2024-summer", 9)],
  solutionProgram: `a = ${fplain(EXB_A)}; tangent ${linePlain(EXB_T.line)}; normal ${linePlain(EXB_N.line)}`,
  verification: `ver.${id("q", "0014")}`,
  version: 1,
};

