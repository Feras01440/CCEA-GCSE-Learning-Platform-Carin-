/* ---- items --------------------------------------------------------------------------------------------- */

const ENTRY_NOTE = MATRIX_NOTE;

const numAns = (value) => ({
  kind: "numeric",
  value,
  tolerance: { type: "absolute", value: 0.0005 },
  unitRequired: false,
  acceptForms: ["decimal", "fraction"],
});

const ce = (misconception, value, feedback, marks, source) => ({
  misconception,
  pattern: { kind: "numeric", value, tolerance: { type: "absolute", value: 0.0005 } },
  feedback,
  marksTypicallyEarned: marks,
  source,
});

const opt = (id, M, correct, feedback, misconception) => ({
  id,
  text: `$${mTex(M)}$`,
  correct,
  feedback,
  ...(misconception ? { misconception } : {}),
});

const questions = [
  {
    id: `q.${TOPIC}.0001`, difficulty: 1, style: "practice", commandWords: ["Find"],
    setting: "An added matrix cleared by subtraction, the simplest of the two kinds",
    parts: [{
      id: "main",
      stem: `It is given that $A + X = B$, where $A = ${mTex(ADD_A)}$ and $B = ${mTex(ADD_B)}$.\nFind the matrix $X$.\n${ENTRY_NOTE}`,
      marks: 2,
      answer: matrixAnswer(ADD_X),
      scheme: [
        { id: "MW1", code: "MW", marks: 1, for: `$X = B - A$` },
        { id: "W1", code: "W", marks: 1, for: `$${mTex(ADD_X)}$`, ft: true },
      ],
      hints: [`Take $A$ from both sides.`, "Subtract entry by entry."],
      workedSolution: `Taking $A$ from both sides gives $X = B - A$.\nEntry by entry, $X = ${mTex(ADD_B)} - ${mTex(ADD_A)} = ${mTex(ADD_X)}$.`,
      commonErrors: [
