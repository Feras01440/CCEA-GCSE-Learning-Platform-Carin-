      { showSteps: 2, studentSupplies: [3, 4] },
      { showSteps: 1, studentSupplies: [2, 3, 4] },
    ],
    verification: `ver.we.${TOPIC}.02`,
    version: 1,
  },
];

const diagnostics = [
  {
    id: `dx.${TOPIC}.pre`,
    topic: TOPIC,
    specRefs: REFS,
    when: "pre",
    items: [
      {
        id: "p1",
        stem: `Three quick checks on what this lesson is built from. None of them is the new method, so answer from what you already know.\nWhat is the inverse of $${mTex(COL_A)}$?`,
        skill: "The inverse of a 2 by 2",
        options: [
          opt("a", COL.Ai, true, `The determinant is $${fPlain(det2(COL_A))}$, so swapping and negating is the whole of it.`),
          opt("b", adj2(COL_A).map((r) => r.map((v) => frac(v.n * -1, v.d))), false, `Every sign has been changed. Only the other diagonal changes sign.`),
          opt("c", routes.adjNotSwapped(COL_A), false, `The signs changed but the leading diagonal never swapped.`),
        ],
        secondsExpected: 30, confidence: true, hypercorrectionQueue: true,
      },
      {
        id: "p2",
        stem: `Solve $x + 7 = 12$.`,
        skill: "Undoing an addition",
        options: [
          { id: "a", text: "$x = 5$", correct: true, feedback: `Take $7$ from both sides. A matrix equation with an added matrix works the same way.` },
          { id: "b", text: "$x = 19$", correct: false, feedback: `The $7$ has been added rather than taken away.` },
          { id: "c", text: `$x = \\frac{12}{7}$`, correct: false, feedback: `The $7$ is added to $x$, not multiplying it, so division does not undo it.` },
        ],
        secondsExpected: 20, confidence: true, hypercorrectionQueue: true,
      },
      {
        id: "p3",
        stem: `For two matrices $P$ and $Q$, is $PQ$ always the same as $QP$?`,
        skill: "Order in a matrix product",
        options: [
          { id: "a", text: "No, the order changes the product", correct: true, feedback: `That is why an inverse has to be written on the same side of both sides of an equation.` },
          { id: "b", text: "Yes, multiplication can be done in any order", correct: false, feedback: `That holds for numbers. Matrix products depend on the order, and often only one of the two exists.` },
          { id: "c", text: "Only when both are $2 \\times 2$", correct: false, feedback: `Even two square matrices of the same size usually give different products in the two orders.` },
        ],
        secondsExpected: 25, confidence: true, hypercorrectionQueue: true,
      },
    ],
  },
  {
    id: `dx.${TOPIC}.post`,
    topic: TOPIC,
    specRefs: REFS,
    when: "post",
    items: [
      {
        id: "d1",
        stem: `An equation reads $A + X = B$. What is $X$?`,
        skill: "Clearing an added matrix",
        options: [
          { id: "a", text: "$B - A$", correct: true, feedback: `Take $A$ from both sides, entry by entry.` },
          { id: "b", text: "$A - B$", correct: false, misconception: "fm.matrix.subtract-wrong-way", feedback: `The subtraction is the wrong way round, so every entry has the opposite sign.` },
          { id: "c", text: `$A^{-1}B$`, correct: false, misconception: "fm.matrix.equation-undone-wrongly", feedback: `$A$ is added here, not multiplying, so no inverse is needed.` },
        ],
        secondsExpected: 25, confidence: true, hypercorrectionQueue: true,
      },
      {
        id: "d2",
        stem: `An equation reads $AX = B$. What is $X$?`,
        skill: "Pre-multiplying by the inverse",
        options: [
          { id: "a", text: `$A^{-1}B$`, correct: true, feedback: `The inverse goes in front of both sides, so $A^{-1}A$ becomes the identity.` },
          { id: "b", text: `$BA^{-1}$`, correct: false, misconception: "fm.matrix.inverse-order", feedback: `That is the inverse behind $B$. Because the order changes a product, it gives a different matrix.` },
          { id: "c", text: `$\\frac{B}{A}$`, correct: false, misconception: "fm.matrix.equation-undone-wrongly", feedback: `Division is not defined for matrices. The inverse is what replaces it.` },
        ],
        secondsExpected: 30, confidence: true, hypercorrectionQueue: true,
      },
      {
        id: "d3",
        stem: `Which of these is $X$ for $AX = B$, with $A = ${mTex(SQ_A)}$ and $B = ${mTex(SQ_B)}$?`,
        skill: "Working the product in the right order",
        options: [
          opt("a", SQ.X, true, `$A^{-1}B$, with the inverse in front.`),
          opt("b", E.sqOrderReversed, false, `That is $BA^{-1}$, the inverse behind $B$.`, "fm.matrix.inverse-order"),
          opt("c", mMul(SQ_A, SQ_B), false, `That is $AB$: the matrix itself was used where its inverse belonged.`, "fm.matrix.equation-undone-wrongly"),
        ],
        secondsExpected: 45, confidence: true, hypercorrectionQueue: true,
      },
      {
        id: "d4",
        stem: `An equation reads $AX + C = B$. What is the first step?`,
        skill: "The order of operations in a combined equation",
        options: [
          { id: "a", text: `Take $C$ from both sides`, correct: true, feedback: `Clear the added matrix first; only then does the inverse come in.` },
          { id: "b", text: `Multiply both sides by $A^{-1}$ straight away`, correct: false, misconception: "fm.matrix.equation-undone-wrongly", feedback: `That leaves $C$ inside the equation and solves a different one.` },
          { id: "c", text: `Take $A$ from both sides`, correct: false, misconception: "fm.matrix.equation-undone-wrongly", feedback: `$A$ is multiplying $X$, so subtracting it undoes nothing.` },
        ],
        secondsExpected: 30, confidence: true, hypercorrectionQueue: true,
      },
      {
        id: "d5",
        stem: `The matrix $S = ${mTex(SING)}$. Can the equation $SX = B$ be solved?`,
        skill: "A singular matrix in an equation",
        options: [
          { id: "a", text: `No, because $\\det S = 0$ and $S$ has no inverse`, correct: true, feedback: `Without an inverse there is nothing to pre-multiply by, so the equation has no single solution.` },
          { id: "b", text: `Yes, by dividing both sides by $S$`, correct: false, misconception: "fm.matrix.singular-not-recognised", feedback: `Matrices are never divided, and this one has no inverse either.` },
          { id: "c", text: `Yes, because $S$ is $2 \\times 2$`, correct: false, misconception: "fm.matrix.singular-not-recognised", feedback: `Being square is not enough. The determinant has to be something other than zero.` },
        ],
        secondsExpected: 35, confidence: true, hypercorrectionQueue: true,
      },
    ],
  },
];

const findTheMistake = [
  {
    id: `ftm.${TOPIC}.01`,
    topic: TOPIC,
    specRefs: REFS,
    stem: `Fionn was asked to find $X$ for $AX = B$, where $A = ${mTex(SQ_A)}$ and $B = ${mTex(SQ_B)}$. His working:`,
    studentWorking: [
      `det A = ${fPlain(det2(SQ_A))}`,
      `A inverse = ${mPlain(SQ.Ai)}`,
      `X = B x A inverse`,
      `X = ${mPlain(E.sqOrderReversed)}`,
    ],
    mistakeLine: 3,
    misconception: "fm.matrix.inverse-order",
    whatWentWrong: `Lines 1 and 2 are both right: the determinant and the inverse are correct, and they carry the first two marks.\nLine 3 puts the inverse behind $B$. Pre-multiplying means the inverse arrives in front of each side, so the product is $A^{-1}B$, not $BA^{-1}$.\nBecause the order of a matrix product changes the answer, line 4 is accurate arithmetic on the wrong product: the answer should be $${mPlain(SQ.X)}$.`,
    correction: [`X = A inverse x B`, `X = ${mPlain(SQ.X)}`],
    marksEarnedAsWritten: ["MW1", "M2"],
    feedback: `The determinant and the inverse are right, so the first two marks stand. The order mark and the answer mark both go with line 3, however accurate line 4 is. The habit that fixes it is to write the inverse in front of both sides on one line, before any multiplying: $A^{-1}AX = A^{-1}B$. Then the order is already settled by the time the arithmetic starts.`,
    source: CER18,
  },
];

const prompts = [
  { id: `rp.${TOPIC}.01`, kind: "procedure", prompt: "How do you solve $A + X = B$?", answer: "Take $A$ from both sides: $X = B - A$, worked entry by entry, in that direction.", keyWords: ["B - A", "both sides"], difficultyPrior: 3 },
  { id: `rp.${TOPIC}.02`, kind: "trap", prompt: "Why can you not divide both sides of $AX = B$ by $A$?", answer: "Division is not defined for matrices. What replaces it is multiplying by the inverse, which exists when the determinant is not zero.", keyWords: ["not defined", "inverse"], difficultyPrior: 5 },
  { id: `rp.${TOPIC}.03`, kind: "formula", prompt: "Write the solution of $AX = B$.", answer: "$X = A^{-1}B$, with the inverse in front of $B$.", keyWords: ["A^-1 B", "front"], difficultyPrior: 4 },
  { id: `rp.${TOPIC}.04`, kind: "procedure", prompt: "Give the three lines that justify $X = A^{-1}B$.", answer: "$A^{-1}AX = A^{-1}B$; $A^{-1}A$ is the identity, so $IX = A^{-1}B$; the identity leaves $X$ unchanged, so $X = A^{-1}B$.", keyWords: ["identity", "unchanged"], difficultyPrior: 6 },
  { id: `rp.${TOPIC}.05`, kind: "trap", prompt: "Which side does the inverse go on, and why does it matter?", answer: "In front, on both sides. Matrix products depend on the order, so an inverse in front of one side and behind the other breaks the equation.", keyWords: ["front", "order"], difficultyPrior: 6 },
  { id: `rp.${TOPIC}.06`, kind: "procedure", prompt: "What is the first step for $AX + C = B$?", answer: "Take $C$ from both sides, giving $AX = B - C$. The inverse comes in only after the added matrix is cleared.", keyWords: ["B - C", "cleared"], difficultyPrior: 5 },
  { id: `rp.${TOPIC}.07`, kind: "qa", prompt: "$A$ is $2 \\times 2$ and $B$ is $2 \\times 1$. What shape is $X$ in $AX = B$?", answer: "A $2 \\times 1$ column: as many rows as $A$ and as many columns as $B$.", keyWords: ["2 x 1", "column"], difficultyPrior: 4 },
  { id: `rp.${TOPIC}.08`, kind: "trap", prompt: "An equation is $SX = B$ and $\\det S = 0$. What do you write?", answer: "That $S$ has no inverse because its determinant is zero, so the equation cannot be solved. Name the matrix, not just the determinant.", keyWords: ["no inverse", "name"], difficultyPrior: 6 },
];

/* ---- bundle ---------------------------------------------------------------------------------------------- */

const noteChecks = [
  check("schema", "Validated against the Zod NoteFrontmatter and the NoteBlock union by pipeline/build-content.mts; the hero block is first, gate ids g1 to g6 are unique, every prompt block names a prompt in this bundle, the recap is a heading and one paragraph of five lines before the closing section, and every gate restates the matrices it uses."),
  check("scope-tier", "FM1 is untiered and calculator-allowed. FM1-MAT-03 allows A plus or minus X = B, AX = B and a combination of these, and excludes XA = B: every question here is one of the allowed forms, and the excluded form appears once, in a notonspec callout, as a fact rather than a method. No matrix is larger than 2 by 2 and no product is 3 by 3."),
  check("formula-sheet", "The Unit 1 sheet carries nothing about matrices, so the inverse formula and the pre-multiplication rule are both recall."),
  check("command-words", "Find, Identify and Explain are the command words, with the tariffs from packs/further-maths/exam-true/command-words.json. The stems keep the shape of the matrix-equation parts read in the Summer 2018, 2019, 2022 and 2023 FM1 papers while every matrix, entry and sentence is our own, and no eight-word run is shared with any paper, scheme or report."),
  check("tariff", "2 marks for a subtraction, 4 for an inverse-and-product, and 2 + 3 + 2 and 2 + 4 for the exam-style questions, matching Summer 2019 Q5 (4 marks for the matrix X), Summer 2023 Q6(i) (4 marks for AX = C) and Q6(ii) (1 mark for the explanation, which we set at 2 so naming the matrix earns its own point)."),
  check("maths-numeric", `Every inverse is proved by back-multiplication (A A^-1 = A^-1 A = I) and every solution is substituted back into the equation it came from: A + X = B gives ${mPlain(ADD_X)}; A - X = B gives ${mPlain(SUB_X)}; AX = B gives ${mPlain(COL.X)} and ${mPlain(SQ.X)} and ${mPlain(TEN.X)}; AX + C = B gives ${mPlain(CMB.X)}. The singular example has determinant 0, asserted.`),
  check("examiner-alignment", "One examiner callout stands in the body beside the pre-multiplication step (Summer 2018 Q5). Every other finding is a Sheet trap. Gates g1 sorts the equation, g2 clears an added matrix, g3 and g4 fix the inverse and the side it goes on, g5 the shape and g6 the combined form."),
  check("copy-shingle", "Checked with node scripts/qa/shingles.mjs --topic matrix-equations: no eight-word run is shared with any question paper, mark scheme or Chief Examiner report."),
  check("style-lint", "British English, second person, calm; no exclamation marks and no verdict word about a learner's answer. Every maths segment opens and closes inside one line, holds no prose words, and carries no TeX command without its backslash. Seven inline SVG figures, all drawn from the computed matrices, and one embeddable video from data/links/media-map.json followed immediately by a gate."),
];

const itemChecks = (detail) => [
  check("schema", "Validated by pipeline/build-content.mts against the Zod Question / WorkedExample / DiagnosticSet / FindTheMistake schema; every scheme sums to its part's marks and the skeleton matches the parts."),
  check("maths-numeric", detail),
  check("command-words", "Command words and tariffs taken from packs/further-maths/exam-true/command-words.json; the wording is ours."),
  check("examiner-alignment", "Every post-check distractor and every common error carries a registry misconception naming the error its route executes, evidenced by the Summer 2018 Q5, Summer 2019 Q5, Summer 2022 Q3, Summer 2023 Q6 or Summer 2024 Q7 report block; the pre-check's prerequisite distractors carry no topic tag."),
  check("copy-shingle", "scripts/qa/shingles.mjs reports no shared eight-word run for this topic."),
  check("style-lint", "KaTeX segments paired, prose-free and backslash-complete; British English; no exclamation marks. Whole-matrix answers use the engine's matrix kind, which accepts a leading scalar as well as worked-out entries."),
];

const verification = [
  verLog(`ver.note.${TOPIC}`, `note.${TOPIC}`, noteChecks),
  verLog(`ver.we.${TOPIC}.01`, `we.${TOPIC}.01`, itemChecks(`The worked example solves AX = B for ${mPlain(COL_A)} and ${mPlain(COL_B)}: the inverse is ${mPlain(COL.Ai)} and X is ${mPlain(COL.X)}, checked by substitution. The twin solves the same form for ${mPlain(TWIN_A)} and ${mPlain(TWIN_B)}, giving ${mPlain(TWIN.X)}.`)),
  verLog(`ver.we.${TOPIC}.02`, `we.${TOPIC}.02`, itemChecks(`The second worked example clears C first: B - C is ${mPlain(CMB_RHS)}, the inverse is ${mPlain(CMB.Ai)} and X is ${mPlain(CMB.X)}, checked by substituting back into AX + C = B. The twin is the same combined form on ${mPlain(TWIN2_A)}, ${mPlain(TWIN2_C)} and ${mPlain(TWIN2_B)}: B - C is ${mPlain(mSub(TWIN2_B, TWIN2_C))} and X is ${mPlain(TWIN2.X)}, substituted back; it is marked out of 4, like q0008.`)),
  ...builtQuestions.map((q) =>
    verLog(
      `ver.${q.id}`,
      q.id,
      itemChecks(
        `Every matrix was computed by matlib.mjs and every solution substituted back: ${q.parts
          .map((p) => `${p.id} -> ${p.answer.kind === "matrix" ? p.answer.entries.map((r) => r.join(" ")).join(" ; ") : p.answer.kind === "numeric" ? p.answer.value : "the option or wording the scheme names"}`)
          .join("; ")}. Each distractor and common error was produced by executing the route its feedback describes (routes.* in matlib.mjs).`,
      ),
    ),
  ),
];

