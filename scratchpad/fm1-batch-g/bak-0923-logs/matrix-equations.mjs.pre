/**
 * FM1 batch G — topic 3: matrix-equations (difficulty 3 -> S).
 * Enrichment: data/enrichment/further-maths/matrix-equations.md (ccea-only; sort the equation before
 * solving it, the three-line pre-multiply chain, same side both sides, the shape check, and the
 * combined form are recreated here in our own words and figures).
 * Every inverse is back-multiplied to the identity and every solution is substituted back.
 */
import {
  OUT, PAPER, check, log as verLog, writeJson, lintTree, figure, svgWrap, svgText, svgPath, svgRect, num,
  shingleClash, corpusFiles,
} from "./lib.mjs";
import {
  mat, dims, mAdd, mSub, mMul, mEq, identity, det2, adj2, inv2, checkInverse, mTex, mPlain, invTex,
  matrixBox, matrixRowSvg, routes, matrixAnswer, matrixError, MATRIX_NOTE, frac, fVal, fPlain, fNeg,
  singularKeyWords,
} from "./matlib.mjs";

const SLUG = "matrix-equations";
const TOPIC = "fm.u1.matrix-equations";
const REFS = ["FM1-MAT-03"];
const CER18 = "ccea-cer:further-maths:2018-summer:FM1:Q5";
const CER19 = "ccea-cer:further-maths:2019-summer:FM1:Q5";
const CER22 = "ccea-cer:further-maths:2022-summer:FM1:Q3";
const CER23 = "ccea-cer:further-maths:2023-summer:FM1:Q6";
const CER24 = "ccea-cer:further-maths:2024-summer:FM1:Q7";

/* ---- the equations, solved and checked ---------------------------------------------------------- */

/** X = B - A, with the result put back into the original equation. */
function solveAdd(A, B) {
  const X = mSub(B, A);
  if (!mEq(mAdd(A, X), B)) throw new Error("A + X = B failed its substitution check");
  return X;
}
/** A - X = B gives X = A - B, checked the same way. */
function solveSub(A, B) {
  const X = mSub(A, B);
  if (!mEq(mSub(A, X), B)) throw new Error("A - X = B failed its substitution check");
  return X;
}
/** X = A^-1 B, with A^-1 proved by back-multiplication and X put back into AX = B. */
function solveMul(A, B) {
  const Ai = checkInverse(A);
  const X = mMul(Ai, B);
  if (!mEq(mMul(A, X), B)) throw new Error("AX = B failed its substitution check");
  return { X, Ai };
}

const ADD_A = mat([[4, -2], [3, 5]]);
const ADD_B = mat([[9, 1], [0, 8]]);
const ADD_X = solveAdd(ADD_A, ADD_B);

const SUB_A = mat([[6, 2], [1, 7]]);
const SUB_B = mat([[2, 5], [4, 3]]);
const SUB_X = solveSub(SUB_A, SUB_B);

const COL_A = mat([[3, 1], [5, 2]]);          // det 1
const COL_B = mat([[7], [12]]);
const COL = solveMul(COL_A, COL_B);

const SQ_A = mat([[2, 5], [1, 3]]);           // det 1
const SQ_B = mat([[1, 4], [2, 3]]);
const SQ = solveMul(SQ_A, SQ_B);

const TEN_A = mat([[4, 2], [3, 4]]);          // det 10, so the inverse carries a fraction
const TEN_B = mat([[10], [20]]);
const TEN = solveMul(TEN_A, TEN_B);

const CMB_A = mat([[4, 7], [1, 2]]);          // det 1
const CMB_C = mat([[3], [1]]);
const CMB_B = mat([[11], [4]]);
const CMB_RHS = mSub(CMB_B, CMB_C);
const CMB = solveMul(CMB_A, CMB_RHS);
if (!mEq(mAdd(mMul(CMB_A, CMB.X), CMB_C), CMB_B)) throw new Error("AX + C = B failed its substitution check");

const SING = mat([[2, 6], [1, 3]]);           // det 0
if (det2(SING).n !== 0) throw new Error("the singular example is not singular");

const TWIN_A = mat([[5, 3], [3, 2]]);         // det 1
const TWIN_B = mat([[4], [3]]);
const TWIN = solveMul(TWIN_A, TWIN_B);

/**
 * 22 Sep fix pass: the second worked example (AX + C = B) had the plain subtraction A + X = B as its twin, a
 * 2-mark task marked out of 4. Its twin is now the same combined form on new matrices, built from a chosen X so
 * that every entry is an integer, then solved the long way and substituted back.
 */
const TWIN2_A = mat([[5, 2], [2, 1]]);        // det 1
const TWIN2_C = mat([[2], [1]]);
const TWIN2_X_CHOSEN = mat([[3], [-1]]);
const TWIN2_B = mAdd(mMul(TWIN2_A, TWIN2_X_CHOSEN), TWIN2_C);
const TWIN2 = solveMul(TWIN2_A, mSub(TWIN2_B, TWIN2_C));
if (!mEq(TWIN2.X, TWIN2_X_CHOSEN)) throw new Error("the second twin does not solve back to the chosen X");
if (!mEq(mAdd(mMul(TWIN2_A, TWIN2.X), TWIN2_C), TWIN2_B)) throw new Error("the second twin failed its substitution check");

/* ---- error routes, executed ----------------------------------------------------------------------- */

const E = {
  sqOrderReversed: routes.orderReversed(SQ_A, SQ_B),   // B A^-1 instead of A^-1 B
  addWrongWay: mSub(ADD_A, ADD_B),                      // A - B where B - A was wanted
  subWrongWay: mSub(SUB_B, SUB_A),                      // B - A where A - B was wanted
  cmbNoClear: null,
};
/** The added matrix never cleared: A^-1 B used where A^-1 (B - C) belonged. */
E.cmbNoClear = mMul(CMB.Ai, CMB_B);
for (const [k, v] of Object.entries(E)) if (!v) throw new Error(`route ${k} reached no matrix`);
if (mEq(E.sqOrderReversed, SQ.X)) throw new Error("the order-reversed route lands on the answer");
if (mEq(E.cmbNoClear, CMB.X)) throw new Error("the uncleared route lands on the answer");

/* ---- figures ---------------------------------------------------------------------------------------- */

const rr = (v) => Math.round(v * 10) / 10;

/** The three-line chain, with the wrong-side version struck through beside it. */
function chainSvg() {
  const out = [];
  const rows = [
    { left: "A X = B", note: "the equation as it stands" },
    { left: "A⁻¹ A X = A⁻¹ B", note: "the inverse pushed in from the left of both sides" },
    { left: "I X = A⁻¹ B", note: "because A⁻¹ A is the identity" },
    { left: "X = A⁻¹ B", note: "and the identity leaves X alone" },
  ];
  rows.forEach((r, i) => {
    const y = 40 + i * 34;
    if (i === 1) out.push(svgRect(20, y - 21, 250, 26, { width: 1.2, fill: "currentColor", opacity: 0.09 }));
    out.push(svgText(32, y, r.left, { size: 15, anchor: "start" }));
    out.push(svgText(290, y, r.note, { size: 10.5, anchor: "start" }));
  });
  out.push(svgPath("M 14 20 L 14 160", { width: 1.6 }));
  out.push(svgText(300, 196, "four lines, and the middle two are the justification", { size: 11.5 }));
  return svgWrap(
    "0 0 600 210",
    "Four lines of working: A X equals B, then the inverse of A pushed in from the left of both sides, then the identity times X, then X equals the inverse of A times B",
    out.join(""),
  );
}

/**
 * 22 Sep fix pass: section 5's own figure. The section says to clear C before the inverse comes in; the figure it
 * used to carry was the AX = B product A^-1 B = X, which read as the very move the sentence above it warns against.
 * This is the combined form's chain, symbolic only, so gate g6 (the first entry of B - C) is not printed above it.
 */
function combinedSvg() {
  const out = [];
  const rows = [
    { left: "A X + C = B", note: "the equation as it stands" },
    { left: "A X = B − C", note: "take C from both sides first" },
    { left: "A⁻¹ A X = A⁻¹ (B − C)", note: "then the inverse, in front of both sides" },
    { left: "X = A⁻¹ (B − C)", note: "the bracket stays until the product is worked out" },
  ];
  rows.forEach((r, i) => {
    const y = 40 + i * 34;
    if (i === 1) out.push(svgRect(20, y - 21, 250, 26, { width: 1.2, fill: "currentColor", opacity: 0.09 }));
    out.push(svgText(32, y, r.left, { size: 15, anchor: "start" }));
    out.push(svgText(290, y, r.note, { size: 10.5, anchor: "start" }));
  });
  out.push(svgPath("M 14 20 L 14 160", { width: 1.6 }));
  out.push(svgText(300, 196, "the added matrix is cleared before the inverse comes in", { size: 11.5 }));
  return svgWrap(
    "0 0 600 210",
    "Four lines of working: A X plus C equals B, then A X equals B minus C, then the inverse of A in front of both sides, then X equals the inverse of A times the bracket B minus C",
    out.join(""),
  );
}

/** Same side or nothing: the wrong-side arrangement drawn and struck through. */
function sidesSvg() {
  const out = [];
  out.push(svgRect(22, 34, 250, 76, { width: 1.2, fill: "currentColor", opacity: 0.05 }));
  out.push(svgText(147, 28, "both inverses on the left", { size: 10.5 }));
  out.push(svgText(147, 70, "A⁻¹ A X = A⁻¹ B", { size: 16 }));
  out.push(svgText(147, 96, "the equation still balances", { size: 10.5 }));
  out.push(svgRect(312, 34, 266, 76, { width: 1.2, fill: "currentColor", opacity: 0.05 }));
  out.push(svgText(445, 28, "one left, one right", { size: 10.5 }));
  out.push(svgText(445, 70, "A⁻¹ A X = B A⁻¹", { size: 16 }));
  out.push(svgPath("M 356 62 L 534 78", { width: 1.8 }));
  out.push(svgText(445, 96, "not allowed: the order changes the product", { size: 10.5 }));
  out.push(svgText(300, 140, "pre-multiply means in front, on both sides at once", { size: 11.5 }));
  return svgWrap(
    "0 0 600 154",
    "Two boxes: on the left the inverse written in front of both sides, which balances; on the right the inverse in front of one side and behind the other, struck through",
    out.join(""),
  );
}

/** The sorting card: four equations, each waiting for its method. */
function sortSvg() {
  const out = [];
  const cells = [
    { t: "A + X = B", m: "subtract A" },
    { t: "A X = B", m: "multiply by the inverse" },
    { t: "X − A = B", m: "add A" },
    { t: "A X + C = B", m: "clear C, then the inverse" },
  ];
  cells.forEach((c, i) => {
    const x = 26 + (i % 2) * 288;
    const y = 36 + Math.floor(i / 2) * 84;
    out.push(svgRect(x, y, 264, 64, { width: 1.2, fill: "currentColor", opacity: 0.05 }));
    out.push(svgText(x + 132, y + 28, c.t, { size: 16 }));
    out.push(svgText(x + 132, y + 50, c.m, { size: 10.5 }));
  });
  out.push(svgText(300, 218, "sort the equation before you calculate anything", { size: 11.5 }));
  return svgWrap(
    "0 0 600 232",
    "Four boxed matrix equations with the method named under each: subtract A, multiply by the inverse, add A, and clear C before using the inverse",
    out.join(""),
  );
}

/** The shape strip, in the language matrix-arithmetic already uses. */
function shapeSvg() {
  const out = [];
  out.push(svgText(300, 32, "the shape of X is fixed before any arithmetic", { size: 12 }));
  out.push(svgText(150, 78, "2 × 2", { size: 20 }));
  out.push(svgText(150, 98, "A", { size: 11 }));
  out.push(svgText(228, 78, "×", { size: 16 }));
  out.push(svgText(300, 78, "2 × 1", { size: 20 }));
  out.push(svgText(300, 98, "X", { size: 11 }));
  out.push(svgText(372, 78, "=", { size: 16 }));
  out.push(svgText(445, 78, "2 × 1", { size: 20 }));
  out.push(svgText(445, 98, "B", { size: 11 }));
  out.push(`<path d='M 180 90 L 180 112 L 272 112 L 272 90' stroke='currentColor' stroke-width='1.1' fill='none' stroke-dasharray='4 3'/>`);
  out.push(svgText(226, 128, "these match, so the product exists", { size: 10.5 }));
  out.push(`<path d='M 128 62 L 128 46 L 476 46 L 476 62' stroke='currentColor' stroke-width='1.1' fill='none' stroke-dasharray='4 3'/>`);
  out.push(svgText(300, 156, "so X has as many rows as A and as many columns as B", { size: 11.5 }));
  return svgWrap(
    "0 0 600 170",
    "The shape rule applied to A times X equals B: a 2 by 2 multiplied by a 2 by 1 gives a 2 by 1, with the inner pair joined and the outer pair joined",
    out.join(""),
  );
}

const CHAIN_SVG = chainSvg();
const SIDES_SVG = sidesSvg();
const SORT_SVG = sortSvg();
const SHAPE_SVG = shapeSvg();
const ADD_SVG = matrixRowSvg(
  [{ M: ADD_B, label: "B" }, "−", { M: ADD_A, label: "A" }, "=", { M: ADD_X, label: "X" }],
  {
    title: "Matrix B take away matrix A, entry by entry, giving the unknown matrix X",
    note: "ordinary algebra: take A from both sides",
  },
);
const COMBINED_SVG = combinedSvg();

/* ---- note ------------------------------------------------------------------------------------------- */

const blocks = [
  {
    type: "hero",
    lede: "An equation with a matrix in it is solved the way any equation is: undo whatever was done to the unknown. Adding and subtracting behave normally. Multiplying does not, because there is no dividing by a matrix, so the undo is the inverse — and it has to go in front on both sides.",
    can: [
      "Sort a matrix equation into the kind that needs subtraction and the kind that needs an inverse",
      "Solve AX = B by writing X as the inverse of A multiplied by B, in that order",
      "Clear an added matrix first, and say what shape the answer will be",
    ],
    minutes: 14,
  },
  { type: "h", text: "Two kinds of equation, sorted first" },
  {
    type: "p",
    md: `$A + X = B$ and $AX = B$ look alike and are not. The first is ordinary algebra: take $A$ from both sides, entry by entry, and $X$ is left.\nThe second cannot be done that way, because there is no dividing by a matrix. It needs the inverse. So the first thing to do with any matrix equation is decide which kind it is.`,
  },
  {
    type: "figure",
    alt: `Four boxed matrix equations with the method named under each: subtract A, multiply by the inverse, add A, and clear C first.`,
    svg: SORT_SVG,
    caption: `Four equations, four methods. Sorting comes before arithmetic.`,
  },
  {
    type: "gate",
    id: "g1",
    kind: "choice",
    prompt: `One tap to begin. Among the four equations in the card above, which one is solved simply by taking $A$ from both sides?`,
    options: ["$A + X = B$", "$AX = B$", "$AX + C = B$"],
    answer: "$A + X = B$",
    explain: `$A$ is added to $X$, so subtracting $A$ undoes it. The two with $AX$ in them need the inverse, because $A$ is multiplying.`,
  },
  { type: "h", text: "1. When the matrix is added or subtracted" },
  {
    type: "p",
    md: `Treat it exactly as you would a number equation. From $A + X = B$, take $A$ from both sides: $X = B - A$, worked entry by entry.\nThe direction matters. $X = B - A$, not $A - B$: every entry of the answer changes sign if you take them the wrong way round, and nothing in the layout will warn you.`,
  },
  {
    type: "figure",
    alt: `Matrix B take away matrix A, entry by entry, giving the unknown matrix X.`,
    svg: ADD_SVG,
    caption: `$X = B - A$, position by position.`,
  },
  {
    type: "gate",
    id: "g2",
    kind: "number",
    prompt: `For $A + X = B$ with $A = ${mTex(ADD_A)}$ and $B = ${mTex(ADD_B)}$, the answer is $X = B - A$. What is the entry in row 1, column 1 of $X$?`,
    answer: fPlain(ADD_X[0][0]),
    explain: `$${fPlain(ADD_B[0][0])} - ${fPlain(ADD_A[0][0])} = ${fPlain(ADD_X[0][0])}$. Taking them the other way round would give $${fPlain(E.addWrongWay[0][0])}$.`,
  },
  { type: "h", text: "2. When the matrix is multiplying" },
  {
    type: "p",
    md: `From $AX = B$ there is nothing to divide by, so multiply instead — by $A^{-1}$, which is the matrix that undoes $A$.\nWrite the chain out. $A^{-1}AX = A^{-1}B$. The left side has $A^{-1}A$, which is the identity, and the identity leaves $X$ unchanged. So $X = A^{-1}B$.`,
  },
  {
    type: "figure",
    alt: `Four lines of working: A X equals B, the inverse pushed in from the left of both sides, the identity times X, and X equals the inverse of A times B.`,
    svg: CHAIN_SVG,
    caption: `The middle two lines are the reason, not decoration.`,
  },
  {
    type: "callout",
    kind: "why",
    title: "Why an inverse and not a division",
    md: `Division is defined for numbers because every number except zero has a reciprocal. Matrices have inverses instead, and only when the determinant is not zero. So "divide both sides by $A$" has no meaning; "multiply both sides by $A^{-1}$" has one, and it does the same job.`,
  },
  {
    type: "gate",
    id: "g3",
    kind: "choice",
    prompt: `In the chain shown above, $A^{-1}AX = A^{-1}B$ becomes $X = A^{-1}B$. What happened to $A^{-1}A$?`,
    options: ["It became the identity, which leaves $X$ unchanged", "It cancelled to zero", "It became $A^{2}$"],
    answer: "It became the identity, which leaves $X$ unchanged",
