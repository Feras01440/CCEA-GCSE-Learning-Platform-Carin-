const noteChecks = [
  check("schema", "Validated against the Zod NoteFrontmatter and the NoteBlock union by pipeline/build-content.mts; the hero block is first, gate ids g1 to g5 are unique, every prompt block names a prompt in this bundle, and every gate restates the rows and columns it uses so it reads alone in the review inbox."),
  check("scope-tier", "FM1 is untiered and calculator-allowed. The FM1-MAT-01 teacher guidance allows non-square matrices for addition and subtraction and caps multiplication at 3 rows or 3 columns while excluding 3 by 3 matrices: the largest matrix here is 2 by 3 and the largest product is 2 by 3. Transformations of the unit square, which AQA 8365 examines at 5.3 and 5.4, are not on this specification and appear nowhere."),
  check("formula-sheet", "The Unit 1 sheet carries nothing about matrices, so the row-by-column rule and the shape rule are both must-know. The note says so."),
  check("command-words", "Work out, Write down, Identify and Explain are the command words, with the tariffs from packs/further-maths/exam-true/command-words.json (Write down 1-1-2, Identify 1-1-2, Calculate 2-3-6). The stems keep the shape of the matrix openers read in the Summer 2019, 2023 and 2025 FM1 papers while every matrix, entry and sentence is our own."),
  check("tariff", "2 marks for a sum or a scalar multiple, 3 for a product, 1 for a shape or a conformability statement, and 2 + 3 + 1 for the exam-style question, matching the 4 to 6 marks matrices carry at the start of a Unit 1 paper."),
  check("maths-numeric", `Every sum, difference, scalar multiple and product is computed in exact rational arithmetic by matlib.mjs and three product entries were recomputed independently as a check: ${PRODUCT_CHECKS.map((c) => `${c.name} = ${c.got}`).join("; ")}. AB and BA were compared and found different, so the non-commutativity example holds.`),
  check("examiner-alignment", "One examiner callout stands in the body beside the squaring step (Summer 2024 Q7). Every other finding is a Sheet trap. Gates g1 and g4 fix the shapes, g2 the entry-by-entry operations, g3 the row-by-column rule and g5 the squared matrix."),
  check("copy-shingle", "An 8-word shingle scan of the note and the bundle against every text file of the private FM corpus (scratchpad/fm1-batch-g/lib.mjs shingleClash) returns nothing; every matrix and every entry here is new."),
  check("style-lint", "British English, second person, calm; no exclamation marks and no verdict word about a learner's answer. Every maths segment opens and closes inside one line and holds no prose words, checked by lintTree before the files were written. Six inline SVG figures, every one drawn from the computed matrices, and one embeddable video from data/links/media-map.json followed immediately by a gate. The closing panel is a pointer of under 80 words followed by the prompts."),
];

const itemChecks = (detail) => [
  check("schema", "Validated by pipeline/build-content.mts against the Zod Question / WorkedExample / DiagnosticSet / FindTheMistake schema; every scheme sums to its part's marks and the skeleton matches the parts."),
  check("maths-numeric", detail),
  check("command-words", "Command words and tariffs taken from packs/further-maths/exam-true/command-words.json; the wording is ours."),
  check("examiner-alignment", "Every common error and every tagged distractor carries a registry misconception naming the error its route executes, evidenced by the Summer 2019 Q1, Summer 2022 Q3, Summer 2023 Q8, Summer 2024 Q7 or Summer 2025 Q1 report block; the post-check distractor that subtracts where a sum was asked carries no tag, because no registry misconception describes it."),
  check("copy-shingle", "8-word shingle scan against the private FM corpus returns nothing."),
  check("style-lint", "KaTeX segments paired and prose-free; British English; no exclamation marks. Every matrix answer is a table spec, one input per entry, because the marker accepts no typed form of a matrix (probe-matrix.mts)."),
];

const verification = [
  verLog(`ver.note.${TOPIC}`, `note.${TOPIC}`, noteChecks),
  verLog(`ver.we.${TOPIC}.01`, `we.${TOPIC}.01`, itemChecks(`The worked example multiplies ${mPlain(A)} by ${mPlain(B)} to give ${mPlain(AB)}; each of the four entries is printed from the exact sum the generator computed. The twin multiplies them the other way round, giving ${mPlain(BA)}, which is a different matrix.`)),
  ...builtQuestions.map((q) =>
    verLog(
      `ver.${q.id}`,
      q.id,
      itemChecks(
        `Every matrix was computed by matlib.mjs: ${q.parts
          .map((p) => `${p.id} -> ${p.answer.kind === "table" ? p.answer.cells.map((c) => c.value).join(", ") : p.answer.kind === "numeric" ? p.answer.value : "the option the scheme names"}`)
          .join("; ")}. Each distractor matrix was produced by executing the route its feedback describes (routes.* in matlib.mjs) and re-checked against the published JSON by verify-published.mjs.`,
      ),
    ),
  ),
];

const bundle = {
  $schema: "../../../../../pipeline/schema/topic-bundle.schema.json",
  topic: {
    id: TOPIC,
    slug: SLUG,
    title: "Adding, subtracting and multiplying matrices",
    subject: "further-maths",
    unit: "FM1",
    tier: "untiered",
    strand: "Matrices",
    statementIds: REFS,
    prerequisites: [],
    order: 45,
    hardness: "L",
    difficulty: 2,
    examinerFlagged: true,
    examinerSources: [CER19, CER22, CER23, CER24, CER25],
    examWeightHint:
      "Unit 1 is one two-hour calculator paper of 100 marks, sat every Summer. Matrix arithmetic comes as a short question, first on the paper in Summer 2019 and Summer 2025: Summer 2025 Q1 (a scalar multiple, then a 2 by 2 times a 2 by 3), Summer 2019 Q1, Summer 2023 Q8 and Summer 2024 Q7(a) all set two or three short parts worth 4 to 6 marks in total. The Summer 2025 scheme gave M1 for each operation carried out correctly and W1 for every entry right, with follow-through into later parts.",
    mustMemorise: [
      "Add and subtract entry by entry, and only between matrices of the same shape",
      "A number outside the brackets multiplies every entry",
      "The entry in row i, column j of a product is row i of the first against column j of the second",
      "(m × n)(n × p) gives m × p: the inner numbers must match",
      "AB and BA are different; A² means A × A, not each entry squared",
    ],
    onFormulaSheet: [],
    notOnThisSpec: [
      "3 × 3 matrices, which the Teacher Guidance excludes",
      "Matrices representing transformations of the unit square, and combinations of transformations",
      "The transpose of a matrix",
      "Matrix division as an operation in its own right",
    ],
    externalRefs: [
      {
        kind: "youtube",
        videoId: "X66YHxuGUvE",
        channel: "corbettmaths",
        credit: "Multiplying Matrices 2x2 by 2x2, corbettmaths (embeddable id verified in data/links/media-map.json)",
      },
      {
        kind: "youtube",
        videoId: "msRyXRdFoyI",
        channel: "corbettmaths",
        credit: "Adding Matrices, corbettmaths (embeddable id verified in data/links/media-map.json)",
      },
      {
        kind: "ccea-doc",
        docType: "cer",
        url: "https://ccea.org.uk/key-stage-4/gcse/subjects/gcse-further-mathematics-2017/reports",
        asOf: "2026-09-20",
      },
    ],
    keywords: ["matrix", "dimensions", "product", "scalar multiple", "row by column"],
  },
  note: {
    id: `note.${TOPIC}`,
    topic: TOPIC,
    title: "Adding, subtracting and multiplying matrices",
    subject: "further-maths",
    unit: "FM1",
    tier: "untiered",
    specRefs: REFS,
    calculator: true,
    formulaSheet: {
      given: [
        "Quadratic formula x = (−b ± √(b² − 4ac)) / 2a",
        "Differentiation y = axⁿ ⇒ dy/dx = naxⁿ⁻¹",
        "Integration ∫axⁿ dx = axⁿ⁺¹/(n + 1) + c",
        "Logarithm aˣ = n ⇒ x = log_a n",
      ],
      mustKnow: [
        "Add and subtract entry by entry, same shape only",
        "Row by column for every entry of a product",
        "(m × n)(n × p) gives m × p",
        "AB ≠ BA, and A² = A × A",
      ],
    },
    notOnThisSpec: [
      "3 × 3 matrices",
      "Matrices as transformations of the unit square",
      "The transpose of a matrix",
      "Matrix division",
    ],
    hardness: "L",
    examinerFlagged: true,
    externalRefs: [
      {
        kind: "youtube",
        videoId: "X66YHxuGUvE",
        channel: "corbettmaths",
        credit: "Multiplying Matrices 2x2 by 2x2, corbettmaths (embeddable id verified in data/links/media-map.json)",
      },
    ],
    sheet: {
      mustBeAbleTo: [
        "Name a matrix's shape as rows by columns",
        "Add and subtract matrices of the same shape, entry by entry",
        "Multiply a matrix by a number, reaching every entry",
        "Work out any entry of a product as a row of the first against a column of the second",
        "Multiply a 2 × 2 by a 2 × 2, and a 2 × 2 by a 2 × 3",
        "Use the shape rule to say whether a product exists and what shape it is",
        "Explain why a particular sum or product cannot be worked out",
        "Work out A² as A × A",
      ],
      howExamined:
        "Unit 1 is one two-hour calculator paper of 100 marks, sat every Summer. Matrix arithmetic is a short question, first on the paper in Summer 2019 and Summer 2025: Summer 2025 Q1 (a scalar multiple, then a 2 by 2 times a 2 by 3, generally well done), Summer 2019 Q1, Summer 2023 Q8 and Summer 2024 Q7(a), each two or three short parts worth 4 to 6 marks in total. The Summer 2025 scheme gave M1 for each operation carried out correctly and W1 for every entry right; later parts of the same question are marked on follow-through from the matrix produced here.",
      traps: [
        "Squaring each entry instead of multiplying the matrix by itself (Summer 2019 FM1 Q1, Summer 2023 FM1 Q8, Summer 2024 FM1 Q7)",
        "Squaring the matrix where a scalar multiple was asked for (Summer 2025 FM1 Q1)",
        "Multiplying the entries in matching positions instead of row by column (Summer 2023 FM1 Q8)",
        "A product that does not come out the right shape, so a 2 by 2 answer was never reached (Summer 2023 FM1 Q8)",
        "Subtracting matrices of different sizes (Summer 2023 FM1 Q8)",
