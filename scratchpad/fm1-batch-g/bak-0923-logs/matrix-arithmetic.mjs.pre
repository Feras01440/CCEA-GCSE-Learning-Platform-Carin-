const findTheMistake = [
  {
    id: `ftm.${TOPIC}.01`,
    topic: TOPIC,
    specRefs: REFS,
    stem: `Seán was asked to work out $AB$, where $A = ${mTex(A)}$ and $B = ${mTex(B)}$. His working:`,
    studentWorking: [
      `A is 2 x 2 and B is 2 x 2, so AB is 2 x 2`,
      `row 1, column 1: (${fPlain(A[0][0])})(${fPlain(B[0][0])}) = ${fPlain(E.abElementwise[0][0])}`,
      `row 1, column 2: (${fPlain(A[0][1])})(${fPlain(B[0][1])}) = ${fPlain(E.abElementwise[0][1])}`,
      `row 2, column 1: (${fPlain(A[1][0])})(${fPlain(B[1][0])}) = ${fPlain(E.abElementwise[1][0])}`,
      `row 2, column 2: (${fPlain(A[1][1])})(${fPlain(B[1][1])}) = ${fPlain(E.abElementwise[1][1])}`,
      `AB = ${mPlain(E.abElementwise)}`,
    ],
    mistakeLine: 2,
    misconception: "fm.matrix.elementwise-product",
    whatWentWrong: `Line 1 is right, and the shape he predicted is the shape he produced, so nothing looks wrong on the page.\nLine 2 multiplies the two entries sitting in the same position. A matrix product pairs a whole row of the first with a whole column of the second, so that entry is $(${fPlain(A[0][0])})(${fPlain(B[0][0])}) + (${fPlain(A[0][1])})(${fPlain(B[1][0])}) = ${fPlain(AB[0][0])}$.\nEvery line after it repeats the same pairing, so the whole matrix is wrong even though the arithmetic in each line is right.`,
    correction: [
      `row 1, column 1: (${fPlain(A[0][0])})(${fPlain(B[0][0])}) + (${fPlain(A[0][1])})(${fPlain(B[1][0])}) = ${fPlain(AB[0][0])}`,
      `row 1, column 2: (${fPlain(A[0][0])})(${fPlain(B[0][1])}) + (${fPlain(A[0][1])})(${fPlain(B[1][1])}) = ${fPlain(AB[0][1])}`,
      `AB = ${mPlain(AB)}`,
    ],
    // The scheme for this task is M1, M2, W1, and pairing matching positions earns none of them;
    // writing the shapes down carries no mark of its own.
    marksEarnedAsWritten: [],
    feedback: `The shape you predicted is right and the arithmetic is accurate, so this is a method problem rather than a careless one. Each entry of a product is a sum of two products, never a single one: if a line of your working has no plus sign in it, you have paired the wrong things. Say "row of the first, column of the second" as you write each line.`,
    source: CER23,
  },
];

