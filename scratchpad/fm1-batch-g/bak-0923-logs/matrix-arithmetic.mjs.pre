/**
 * FM1 batch G — topic 1: matrix-arithmetic (difficulty 2 -> L).
 * Every sum, difference, scalar multiple and product is computed in exact rational arithmetic by
 * matlib.mjs; every distractor matrix is produced by executing the route its feedback describes.
 */
import {
  OUT, PAPER, check, log as verLog, writeJson, lintTree, figure, svgWrap, svgText, svgPath, num,
  shingleClash, corpusFiles,
} from "./lib.mjs";
import {
  mat, dims, mAdd, mSub, mMul, mScale, mEq, mTex, mPlain, matrixRowSvg, matrixBox, routes, matrixAnswer, matrixError, MATRIX_NOTE, fPlain, fVal,
} from "./matlib.mjs";

const SLUG = "matrix-arithmetic";
const TOPIC = "fm.u1.matrix-arithmetic";
const REFS = ["FM1-MAT-01"];
const CER19 = "ccea-cer:further-maths:2019-summer:FM1:Q1";
const CER22 = "ccea-cer:further-maths:2022-summer:FM1:Q3";
const CER23 = "ccea-cer:further-maths:2023-summer:FM1:Q8";
const CER24 = "ccea-cer:further-maths:2024-summer:FM1:Q7";
const CER25 = "ccea-cer:further-maths:2025-summer:FM1:Q1";

/* ---- the matrices, and everything built from them ---------------------------------------------- */

const A = mat([[3, -1], [2, 4]]);
const B = mat([[5, 2], [-1, 0]]);
const C = mat([[1, 4, -2], [3, 0, 5]]);

const SUM = mAdd(A, B);
const DIFF = mSub(A, B);
const TRIPLE = mScale(3, A);
const AB = mMul(A, B);
const BA = mMul(B, A);
const ASQ = mMul(A, A);
const AC = mMul(A, C);
const TWO_A_MINUS_B = mSub(mScale(2, A), B);

if (mEq(AB, BA)) throw new Error("AB and BA came out equal, so the non-commutativity example does not work");

/** Three sample entries of every product, recomputed by hand-style summation as a check. */
const PRODUCT_CHECKS = [
  { name: "AB row 1 column 1", got: fVal(AB[0][0]), want: fVal(A[0][0]) * fVal(B[0][0]) + fVal(A[0][1]) * fVal(B[1][0]) },
  { name: "AB row 2 column 1", got: fVal(AB[1][0]), want: fVal(A[1][0]) * fVal(B[0][0]) + fVal(A[1][1]) * fVal(B[1][0]) },
  { name: "AC row 2 column 3", got: fVal(AC[1][2]), want: fVal(A[1][0]) * fVal(C[0][2]) + fVal(A[1][1]) * fVal(C[1][2]) },
];
for (const c of PRODUCT_CHECKS) if (Math.abs(c.got - c.want) > 1e-12) throw new Error(`${c.name}: ${c.got} vs ${c.want}`);

/* ---- error routes, executed ---------------------------------------------------------------------- */

const E = {
  abElementwise: routes.elementwise(A, B),
  abSwapped: routes.rowsAndColumnsSwapped(A, B),
  aSquaredElementwise: routes.elementwise(A, A),
  sumSubtracted: mSub(A, B),
  diffWrongWay: mSub(B, A),
};
for (const [k, v] of Object.entries(E)) if (!v) throw new Error(`route ${k} reached no matrix`);
if (mEq(E.abElementwise, AB) || mEq(E.abSwapped, AB)) throw new Error("a product route lands on the right answer");
if (mEq(E.aSquaredElementwise, ASQ)) throw new Error("the elementwise square equals the matrix square");

/* ---- figures --------------------------------------------------------------------------------------- */

const GIVENS_SVG = matrixRowSvg(
  [{ M: A, label: "A" }, { M: B, label: "B" }, { M: C, label: "C", cell: 46 }],
  {
    title: `The three matrices used in this lesson: A and B are 2 by 2 and C is 2 by 3`,
    note: `A and B are 2 by 2; C is 2 by 3`,
  },
);

const ADD_SVG = matrixRowSvg(
  [{ M: A, label: "A" }, "+", { M: B, label: "B" }, "=", { M: SUM }],
  {
    title: `Matrix A added to matrix B, each pair of entries in matching positions added to give the sum`,
    note: "each entry added to the entry in the same position",
  },
);

function rowByColumnSvg() {
  const out = [];
  const boxA = matrixBox(A, { x: 24, y: 48, label: "A" });
  out.push(boxA.svg);
  out.push(svgText(24 + boxA.w + 15, 48 + 34, "×", { size: 18 }));
  const boxB = matrixBox(B, { x: 24 + boxA.w + 34, y: 48, label: "B" });
  out.push(boxB.svg);
  const eqX = 24 + boxA.w + 34 + boxB.w + 18;
  out.push(svgText(eqX, 48 + 34, "=", { size: 18 }));
  const boxP = matrixBox(AB, { x: eqX + 16, y: 48 });
  out.push(boxP.svg);
  // the first row of A swept against the first column of B, and where that entry lands
  out.push(`<rect x='${num(24)}' y='${num(48)}' width='${num(boxA.w)}' height='${num(34)}' fill='currentColor' fill-opacity='0.12' stroke='none'/>`);
  out.push(`<rect x='${num(24 + boxA.w + 34)}' y='${num(48)}' width='${num(44)}' height='${num(68)}' fill='currentColor' fill-opacity='0.12' stroke='none'/>`);
  out.push(`<rect x='${num(eqX + 16)}' y='${num(48)}' width='${num(44)}' height='${num(34)}' stroke='currentColor' stroke-width='1.4' fill='none'/>`);
  out.push(svgText(300, 150, `row 1 of A against column 1 of B gives the entry in row 1, column 1`, { size: 11.5 }));
  out.push(
    svgText(
      300,
      168,
      `(${fPlain(A[0][0])})(${fPlain(B[0][0])}) + (${fPlain(A[0][1])})(${fPlain(B[1][0])}) = ${fPlain(AB[0][0])}`,
      { size: 12.5 },
    ),
  );
  return svgWrap(
    "0 0 600 184",
    `The product of A and B with the first row of A and the first column of B shaded, and the entry they produce outlined in the answer matrix`,
    out.join(""),
  );
}

function shapeRuleSvg() {
  const out = [];
  out.push(svgText(300, 30, "the two middle numbers must match", { size: 12 }));
  const show = (x, label, m, n) => {
    out.push(svgText(x, 72, `${m} × ${n}`, { size: 20 }));
    out.push(svgText(x, 92, label, { size: 11 }));
  };
  show(150, "A", 2, 2);
  show(300, "C", 2, 3);
  out.push(svgText(225, 72, "×", { size: 16 }));
  out.push(`<path d='M 178 84 L 178 106 L 272 106 L 272 84' stroke='currentColor' stroke-width='1.1' fill='none' stroke-dasharray='4 3'/>`);
  out.push(svgText(225, 122, "these two are both 2, so the product exists", { size: 11 }));
  out.push(svgPath("M 350 72 L 392 72 M 382 65 L 392 72 L 382 79", { width: 1.4 }));
  out.push(svgText(432, 72, `${dims(AC)[0]} × ${dims(AC)[1]}`, { size: 20 }));
  out.push(svgText(432, 92, "the product", { size: 11 }));
  out.push(`<path d='M 128 56 L 128 40 L 462 40 L 462 56' stroke='currentColor' stroke-width='1.1' fill='none' stroke-dasharray='4 3'/>`);
  out.push(svgText(300, 150, "the outer two numbers give the shape of the answer", { size: 11.5 }));
  return svgWrap(
    "0 0 600 166",
    `The shape rule: a 2 by 2 multiplied by a 2 by 3, with the two inner numbers joined to show they match and the two outer numbers joined to show they give the product's shape`,
    out.join(""),
  );
}

const ROWCOL_SVG = rowByColumnSvg();
const SHAPE_SVG = shapeRuleSvg();
const ORDER_SVG = matrixRowSvg(
  [{ M: AB, label: "AB" }, "≠", { M: BA, label: "BA" }],
  {
    title: `The product of A and B beside the product of B and A, showing that the two are different matrices`,
    note: "the same two matrices, multiplied the other way round",
  },
);
const SQUARE_SVG = matrixRowSvg(
  [{ M: ASQ, label: "A × A" }, "≠", { M: E.aSquaredElementwise, label: "each entry squared" }],
  {
    title: `A multiplied by itself beside the matrix made by squaring each entry of A, showing that the two are different`,
    note: "squaring a matrix means multiplying it by itself",
  },
);

/* ---- note -------------------------------------------------------------------------------------------- */

const blocks = [
  {
    type: "hero",
    lede: "A matrix is a rectangle of numbers kept together so it can be worked with as one object. Adding and subtracting behave exactly as you would guess. Multiplying does not: it pairs a row with a column, and the order you multiply in changes the answer.",
    can: [
      "Add, subtract and scale matrices entry by entry, and say when you cannot",
      "Multiply two matrices by pairing each row with each column",
      "Decide from the shapes whether a product exists, and what shape it will be",
    ],
    minutes: 12,
  },
  { type: "h", text: "Numbers kept in a rectangle" },
  {
    type: "p",
    md: `A matrix is written inside brackets and described by its shape: **rows first, then columns**. Here $A$ and $B$ are $2 \\times 2$, and $C$ is $2 \\times 3$.\nThe shape is not decoration. It decides what you are allowed to do: two matrices can only be added if they are the same shape, and can only be multiplied if the shapes fit together in one particular way.`,
  },
  {
    type: "figure",
    alt: `Three matrices drawn in square brackets: A and B are each 2 by 2, and C is 2 by 3.`,
    svg: GIVENS_SVG,
    caption: `$A$ and $B$ are $2 \\times 2$; $C$ is $2 \\times 3$. Rows first, then columns.`,
  },
  {
    type: "gate",
    id: "g1",
    kind: "choice",
    prompt: `One tap to begin. The matrix $C$ shown above has two rows and three columns. What is its shape called?`,
    options: ["$2 \\times 3$", "$3 \\times 2$", "$6$"],
    answer: "$2 \\times 3$",
    explain: `Rows first, then columns, so $C$ is $2 \\times 3$. Getting that order the wrong way round is what makes the multiplication rule look impossible later.`,
  },
  { type: "h", text: "1. Adding, subtracting and scaling" },
  {
    type: "p",
    md: `These three are the easy ones. To add, add the entries in matching positions. To subtract, subtract them. To multiply by a number, multiply **every** entry by it.\nThe only rule is shape: $A + B$ works because both are $2 \\times 2$, but $A + C$ does not exist at all, because the third column of $C$ has nothing in $A$ to pair with.`,
  },
  {
    type: "figure",
    alt: `Matrix A added to matrix B, with each pair of entries in matching positions added to give the sum.`,
    svg: ADD_SVG,
    caption: `Position by position, and nothing moves.`,
  },
  {
    type: "gate",
    id: "g2",
    kind: "number",
    prompt: `In the addition shown above, $A$ has $${fPlain(A[1][0])}$ in row 2, column 1 and $B$ has $${fPlain(B[1][0])}$ in the same place. What is the entry in row 2, column 1 of $A + B$?`,
    answer: fPlain(SUM[1][0]),
    explain: `$${fPlain(A[1][0])} + (${fPlain(B[1][0])}) = ${fPlain(SUM[1][0])}$. Every entry of a sum comes from the one position it sits in.`,
  },
  { type: "h", text: "2. Multiplying: a row meets a column" },
  {
    type: "p",
    md: `Multiplication does not work position by position. To find the entry in **row $i$, column $j$** of $AB$, take row $i$ of $A$ and column $j$ of $B$, multiply term by term and add.\nWhy not entry by entry? Because a matrix stands for a whole set of combinations at once, and each row of the first has to meet every column of the second.`,
  },
  {
    type: "figure",
    alt: `The product of A and B, with the first row of A and the first column of B shaded and the entry they produce outlined in the answer matrix.`,
    svg: ROWCOL_SVG,
    caption: `Row 1 against column 1 lands in row 1, column 1.`,
  },
  {
    type: "callout",
    kind: "why",
    title: "Why entry by entry is not multiplication",
    md: `Multiplying matching entries would leave each number of the answer resting on one number from each matrix. Row by column makes every entry rest on a whole row and a whole column, which is what lets one matrix stand for a system of equations later in this unit.`,
  },
  {
    type: "gate",
    id: "g3",
    kind: "number",
    prompt: `Using $A$ and $B$ from this lesson, row 2 of $A$ is $${fPlain(A[1][0])}$, $${fPlain(A[1][1])}$ and column 1 of $B$ is $${fPlain(B[0][0])}$, $${fPlain(B[1][0])}$. What is the entry in row 2, column 1 of $AB$?`,
    answer: fPlain(AB[1][0]),
    explain: `$(${fPlain(A[1][0])})(${fPlain(B[0][0])}) + (${fPlain(A[1][1])})(${fPlain(B[1][0])}) = ${fPlain(AB[1][0])}$. Term by term along the row and down the column, then add.`,
  },
  { type: "h", text: "3. The shape rule" },
  {
    type: "p",
    md: `Write the two shapes side by side. The product exists only when the **inner** two numbers match, and then the **outer** two give the shape of the answer.\nSo $2 \\times 2$ times $2 \\times 3$ works and gives a $2 \\times 3$ answer. The other way round, $2 \\times 3$ times $2 \\times 2$, has inner numbers $3$ and $2$, so that product does not exist.`,
  },
  {
    type: "figure",
    alt: `The shape rule: a 2 by 2 multiplied by a 2 by 3, with the inner numbers joined to show they match and the outer numbers joined to show they give the product's shape.`,
    svg: SHAPE_SVG,
    caption: `Inner numbers match, outer numbers give the answer's shape.`,
  },
  {
    type: "gate",
    id: "g4",
    kind: "choice",
    prompt: `Using the shape rule shown above, what shape is the product of a $2 \\times 2$ matrix and a $2 \\times 3$ matrix, in that order?`,
    options: ["$2 \\times 3$", "$2 \\times 2$", "$3 \\times 2$"],
    answer: "$2 \\times 3$",
    explain: `The inner numbers are both $2$, so the product exists, and the outer numbers $2$ and $3$ give its shape.`,
  },
  { type: "h", text: "4. Two things that catch people out" },
  {
    type: "p",
    md: `**The order matters.** $AB$ and $BA$ are different matrices, and often only one of them exists. Never swap them to make the arithmetic easier.\n**Squaring means multiplying.** $A^{2}$ is $A \\times A$, worked out row by column. It is not the matrix you get by squaring each entry, and that is the slip examiners report most often on this topic.`,
  },
  {
    type: "figure",
    alt: `The product AB beside the product BA, showing that the two are different matrices.`,
    svg: ORDER_SVG,
    caption: `Same two matrices, opposite order, different answer.`,
  },
  {
    type: "callout",
    kind: "examiner",
    title: "Summer 2024, Unit 1, Question 7",
    md: "Candidates who squared each entry instead of multiplying the matrix by itself lost the whole part. The same slip is reported in Summer 2019 and Summer 2023, so it is worth one deliberate check: write the multiplication out before you start.",
    source: CER24,
  },
  {
    type: "video",
    videoId: "X66YHxuGUvE",
    title: "Multiplying Matrices 2x2 by 2x2 - Corbettmaths",
    channel: "corbettmaths",
    why: "The row-by-column sweep worked through slowly on several pairs of matrices.",
  },
  {
    type: "gate",
    id: "g5",
    kind: "number",
    prompt: `For the matrix $A$ in this lesson, $A^{2}$ means $A \\times A$. Row 1 of $A$ is $${fPlain(A[0][0])}$, $${fPlain(A[0][1])}$ and column 1 of $A$ is $${fPlain(A[0][0])}$, $${fPlain(A[1][0])}$. What is the entry in row 1, column 1 of $A^{2}$?`,
    answer: fPlain(ASQ[0][0]),
    explain: `$(${fPlain(A[0][0])})(${fPlain(A[0][0])}) + (${fPlain(A[0][1])})(${fPlain(A[1][0])}) = ${fPlain(ASQ[0][0])}$. Squaring the entry alone would give $${fPlain(E.aSquaredElementwise[0][0])}$, which is a different matrix.`,
  },
  { type: "h", text: "You can now" },
  {
    type: "p",
    md: `Add, subtract and scale entry by entry, and say when the shapes forbid it.\nMultiply by pairing each row of the first with each column of the second.\nUse the shape rule to decide whether a product exists and what shape it is.\nTreat $AB$ and $BA$ as different matrices.\nWork out $A^{2}$ as $A \\times A$, never by squaring the entries.`,
  },
  { type: "h", text: "In the exam" },
  {
    type: "p",
    md: `Matrix arithmetic is a short question, usually $4$ to $6$ marks across two or three parts: a scalar multiple or a sum, then a product. It opened the paper in Summer 2019 and Summer 2025. The first mark is the row-by-column working written out; the last is every entry right. Stuck on a product? Write the shapes down first — they tell you whether to start at all, and how many entries the answer needs.`,
  },
  { type: "prompt", promptId: `rp.${TOPIC}.01` },
  { type: "prompt", promptId: `rp.${TOPIC}.03` },
  { type: "prompt", promptId: `rp.${TOPIC}.04` },
  { type: "prompt", promptId: `rp.${TOPIC}.06` },
];

/* ---- items ------------------------------------------------------------------------------------------- */

/**
 * Whole-matrix answers use the engine's `matrix` kind (suite 1064), which accepts pmatrix, bmatrix,
 * a bare grid and a name in front, marks entry by entry and names a transpose. Entries are marked as
 * written, so the answer-line sentence asks for every entry worked out.
 */
const ENTRY_NOTE = MATRIX_NOTE;

const numAns = (value) => ({
  kind: "numeric",
  value,
  tolerance: { type: "absolute", value: 0.0005 },
  unitRequired: false,
  acceptForms: ["decimal", "fraction"],
});

const ce = (misconception, value, feedback, marks, source) => ({
  misconception,
  pattern: { kind: "numeric", value },
  feedback,
  marksTypicallyEarned: marks,
  source,
});

const opt = (id, M, correct, feedback, misconception) => ({
  id,
  text: `$${mTex(M)}$`,
  correct,
  feedback,
  ...(misconception ? { misconception } : {}),
});

const questions = [
  {
    id: `q.${TOPIC}.0001`,
    difficulty: 1,
    style: "practice",
    commandWords: ["Work out"],
    setting: "A sum of two square matrices, the opening part of a matrix question",
    figures: [figure(GIVENS_SVG, `Three matrices drawn in square brackets: A and B are each 2 by 2, and C is 2 by 3.`)],
    parts: [
      {
        id: "main",
        stem: `The diagram shows the matrices $A$, $B$ and $C$, where $A = ${mTex(A)}$ and $B = ${mTex(B)}$.\nWork out $A + B$.\n${ENTRY_NOTE}`,
        marks: 2,
        answer: matrixAnswer(SUM),
        scheme: [
          { id: "MW1", code: "MW", marks: 1, for: "adding the entries in matching positions" },
          { id: "W1", code: "W", marks: 1, for: `$${mTex(SUM)}$` },
        ],
        hints: ["Add the two entries that sit in the same position."],
        workedSolution: `Adding position by position: $${mTex(A)} + ${mTex(B)} = ${mTex(SUM)}$.`,
        commonErrors: [
          matrixError("fm.matrix.elementwise-product", E.abElementwise, `The entries in matching positions have been multiplied rather than added. Adding them gives $${mTex(SUM)}$.`, 0, CER23),
          // 22 Sep: the A - B common error is gone. Subtracting where a sum was asked is not a subtraction taken the
          // wrong way round, no registry id describes it, and the engine's entry-by-entry line already answers it.
        ],
        requiresWorking: false,
      },
    ],
  },
  {
    id: `q.${TOPIC}.0002`,
    difficulty: 1,
    style: "practice",
    commandWords: ["Work out"],
    setting: "A scalar multiple, where every entry is multiplied",
    parts: [
      {
        id: "main",
        stem: `The matrix $A = ${mTex(A)}$.\nWork out $3A$.\n${ENTRY_NOTE}`,
        marks: 2,
        answer: matrixAnswer(TRIPLE),
        scheme: [
          { id: "MW1", code: "MW", marks: 1, for: "every entry multiplied by $3$" },
          { id: "W1", code: "W", marks: 1, for: `$${mTex(TRIPLE)}$` },
        ],
        hints: ["A number outside the brackets multiplies every entry inside."],
        workedSolution: `Multiplying every entry by $3$: $3${mTex(A)} = ${mTex(TRIPLE)}$.`,
        commonErrors: [
          matrixError("fm.matrix.scalar-multiple-squared", E.aSquaredElementwise, `Each entry has been squared instead of multiplied by $3$. A number outside the brackets multiplies every entry, giving $${mTex(TRIPLE)}$.`, 0, CER25),
        ],
        requiresWorking: false,
      },
    ],
  },
  {
    id: `q.${TOPIC}.0003`,
    difficulty: 2,
    style: "practice",
    commandWords: ["Identify"],
    setting: "Whether an operation is possible at all, decided from the shapes",
    figures: [figure(GIVENS_SVG, `Three matrices drawn in square brackets: A and B are each 2 by 2, and C is 2 by 3.`)],
    parts: [
      {
        id: "main",
        stem: `The diagram shows $A$, which is $2 \\times 2$, and $C$, which is $2 \\times 3$.\nIdentify the correct statement about $A + C$.`,
        marks: 1,
        answer: {
          kind: "mcq",
          shuffle: true,
          options: [
            { id: "a", text: "It does not exist, because the two matrices are different shapes", correct: true, feedback: `Adding pairs entries in matching positions, and $C$ has a third column with nothing opposite it.` },
            { id: "b", text: "It is a $2 \\times 3$ matrix, with the extra column of $C$ copied across", correct: false, misconception: "fm.matrix.dimensions-not-conformable", feedback: `Nothing is copied across in an addition. With no entry of $A$ opposite that third column, the sum does not exist.` },
            { id: "c", text: "It is a $2 \\times 2$ matrix, using the first two columns of $C$", correct: false, misconception: "fm.matrix.dimensions-not-conformable", feedback: `A matrix cannot be trimmed to fit. Addition needs the two shapes to be identical.` },
          ],
        },
        scheme: [{ id: "W1", code: "W", marks: 1, for: "it does not exist: the shapes differ" }],
        hints: ["Compare the two shapes before anything else."],
        workedSolution: `$A$ is $2 \\times 2$ and $C$ is $2 \\times 3$.\nAddition pairs entries in matching positions, so it needs identical shapes. $A + C$ does not exist.`,
        commonErrors: [],
        requiresWorking: false,
      },
    ],
  },
  {
    id: `q.${TOPIC}.0004`,
    difficulty: 2,
    style: "practice",
    commandWords: ["Work out"],
    setting: "A product of two square matrices, worked row by column",
    parts: [
      {
        id: "main",
        stem: `The matrices $A = ${mTex(A)}$ and $B = ${mTex(B)}$.\nWork out $AB$.\n${ENTRY_NOTE}`,
        marks: 3,
        answer: matrixAnswer(AB),
        scheme: [
          { id: "M1", code: "M", marks: 1, for: "at least one entry from a row of $A$ against a column of $B$" },
          { id: "M2", code: "M", marks: 1, for: "all four entries attempted row by column", dependsOn: ["M1"] },
          { id: "W1", code: "W", marks: 1, for: `$${mTex(AB)}$`, ft: true },
        ],
        hints: ["Row 1 of $A$ with column 1 of $B$ gives the entry in row 1, column 1.", "Work along the row and down the column, then add."],
        workedSolution: `Row by column: $${mTex(A)}${mTex(B)} = ${mTex(AB)}$.\nFor example row 2, column 1 is $(${fPlain(A[1][0])})(${fPlain(B[0][0])}) + (${fPlain(A[1][1])})(${fPlain(B[1][0])}) = ${fPlain(AB[1][0])}$.`,
        commonErrors: [
          matrixError("fm.matrix.elementwise-product", E.abElementwise, `The entries in matching positions have been multiplied. Each entry of a product is a whole row against a whole column, which gives $${mTex(AB)}$.`, 0, CER23),
          matrixError("fm.matrix.rows-and-columns-swapped", E.abSwapped, `Rows of $A$ have been paired with rows of $B$. It is a row of the first against a column of the second, which gives $${mTex(AB)}$.`, 1, CER23),
          matrixError("fm.matrix.inverse-order", BA, `That is $BA$. The order of a matrix product changes the answer, and $AB$ is $${mTex(AB)}$.`, 1, CER24),
        ],
        requiresWorking: true,
      },
    ],
  },
  {
    id: `q.${TOPIC}.0005`,
    difficulty: 2,
    style: "practice",
    commandWords: ["Write down"],
    setting: "One named entry of a product, so the row-by-column rule is used on its own",
    parts: [
      {
        id: "main",
        stem: `The matrices $A = ${mTex(A)}$ and $B = ${mTex(B)}$.\nWrite down the entry in row 2, column 1 of $AB$.`,
        marks: 2,
        answer: numAns(fVal(AB[1][0])),
