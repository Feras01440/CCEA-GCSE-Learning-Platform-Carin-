];

/* ---- items ----------------------------------------------------------------------------------------- */

const numAns = (value, { dp = 2 } = {}) => ({
  kind: "numeric",
  value: Number(value.toFixed(dp)),
  tolerance: { type: "dp", places: dp },
  unitRequired: false,
  acceptForms: ["decimal", "fraction"],
});
const exactAns = (value) => ({
  kind: "numeric",
  // a same-base solution is a whole number; the division that produced it leaves floating-point dust
  value: Math.round(value * 1e6) / 1e6,
  tolerance: { type: "absolute", value: 0.0005 },
  unitRequired: false,
  acceptForms: ["decimal", "fraction"],
});

const ce = (misconception, value, feedback, marks, source) => ({
  misconception,
  pattern: { kind: "numeric", value: Number(Number(value).toFixed(2)), tolerance: { type: "absolute", value: 0.005 } },
  feedback,
  marksTypicallyEarned: marks,
  source,
});

const logScheme = (e, marks) => {
  const s = [
    { id: "M1", code: "M", marks: 1, for: `taking logarithms of both sides` },
    { id: "MW1", code: "MW", marks: 1, for: `$(${idx(e.m, e.c)}) \\log ${e.L} = ${e.p === 0 ? `\\log ${e.R}` : `(${idx(e.p, e.q)}) \\log ${e.R}`}$, with brackets` },
  ];
  if (marks >= 4) s.push({ id: "M2", code: "M", marks: 1, for: "expanding and collecting the terms in $x$ on one side", dependsOn: ["MW1"] });
  if (marks >= 5) s.push({ id: "M3", code: "M", marks: 1, for: "factorising $x$ out and dividing", dependsOn: ["M2"] });
  s.push({ id: "W1", code: "W", marks: 1, for: `$${d2(e.x).toFixed(2)}$`, ft: true });
  return s;
};

