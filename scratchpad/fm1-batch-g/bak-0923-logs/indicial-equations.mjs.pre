/**
 * FM1 batch F — topic 5: indicial-equations (difficulty 2 -> L).
 * Every solution and every distractor is produced by solving the equation the route describes,
 * in full precision, and rounded only when it is printed.
 */
import {
  OUT, PAPER, check, log as verLog, writeJson, lintTree, figure, svgWrap, svgText, svgPath, svgRect, num,
  shingleClash, corpusFiles,
} from "./lib.mjs";

const SLUG = "indicial-equations";
const TOPIC = "fm.u1.indicial-equations";
const REFS = ["FM1-LOG-03"];
const CER18 = "ccea-cer:further-maths:2018-summer:FM1:Q6";
const CER19 = "ccea-cer:further-maths:2019-summer:FM1:Q9";
const CER22 = "ccea-cer:further-maths:2022-summer:FM1:Q5";
const CER23 = "ccea-cer:further-maths:2023-summer:FM1:Q7";
const CER25 = "ccea-cer:further-maths:2025-summer:FM1:Q9";

/* ---- the mathematics, computed ---------------------------------------------------------------- */

const L10 = (v) => Math.log10(v);
const d2 = (v) => Math.round(v * 100) / 100;
const d6 = (v) => Math.round(v * 1e6) / 1e6;

/**
 * Solves L^(m x + c) = R^(p x + q) exactly as the method does:
 *   (m x + c) log L = (p x + q) log R
 *   x (m log L - p log R) = q log R - c log L
 */
function solve({ L, m, c, R, p, q }) {
  const denom = m * L10(L) - p * L10(R);
  if (Math.abs(denom) < 1e-12) throw new Error("the x terms cancel, so this equation has no single solution");
  const x = (q * L10(R) - c * L10(L)) / denom;
  // checked by substitution at full precision
  const lhs = L ** (m * x + c);
  const rhs = R ** (p * x + q);
  if (Math.abs(lhs - rhs) > 1e-6 * Math.max(1, Math.abs(lhs))) throw new Error(`substitution check failed: ${lhs} vs ${rhs}`);
  return { ...arguments[0], x, denom, numer: q * L10(R) - c * L10(L), lhs, rhs };
}

/** The index expression m x + c, printed the way a paper prints it. */
function idx(m, c) {
  const mx = m === 1 ? "x" : m === -1 ? "-x" : `${m}x`;
  if (c === 0) return mx;
  return `${mx} ${c < 0 ? "-" : "+"} ${Math.abs(c)}`;
}
const eqTex = (e) => `${e.L}^{${idx(e.m, e.c)}} = ${e.R === Math.round(e.R) && e.p === 0 ? e.R : e.R}^{${e.p === 0 ? "" : idx(e.p, e.q)}}`;
/** A ^ (linear) = plain number, or a ^ (linear) = b ^ (linear). */
const printEq = (e) => (e.p === 0 && e.q === 1 ? `${e.L}^{${idx(e.m, e.c)}} = ${e.R}` : `${e.L}^{${idx(e.m, e.c)}} = ${e.R}^{${idx(e.p, e.q)}}`);

const WE = solve({ L: 5, m: 3, c: -2, R: 40, p: 0, q: 1 });
const Q1 = solve({ L: 2, m: 1, c: 0, R: 40, p: 0, q: 1 });
const Q2 = solve({ L: 5, m: 1, c: 2, R: 90, p: 0, q: 1 });
const Q3 = solve({ L: 7, m: 3, c: -1, R: 200, p: 0, q: 1 });
const Q4 = solve({ L: 4, m: 1, c: 0, R: 2, p: 1, q: 3 }); // 4^x = 2^(x+3), exactly x = 3
const Q5 = solve({ L: 5, m: 2, c: 0, R: 3, p: 1, q: 4 });
const Q6 = solve({ L: 3, m: 1, c: 0, R: 11, p: 0, q: 1 });
const TWIN = solve({ L: 4, m: 2, c: -3, R: 150, p: 0, q: 1 });
const EXA = solve({ L: 2, m: 4, c: 1, R: 7, p: 1, q: 3 });
const EXB = solve({ L: 8, m: 1, c: 0, R: 2, p: 1, q: 4 }); // 8^x = 2^(x+4), exactly x = 2

if (Math.abs(Q4.x - 3) > 1e-9) throw new Error(`Q4 should be exactly 3, got ${Math.round(Q4.x)}`);
if (Math.abs(EXB.x - 2) > 1e-9) throw new Error(`EXB should be exactly 2, got ${Math.round(EXB.x)}`);

/** The log identity behind the method, checked at three sample points. */
const IDENTITY = [
  { a: 3, x: 4 },
  { a: 7, x: 2.5 },
  { a: 2, x: -1.5 },
].map((s) => ({ ...s, lhs: d6(L10(s.a ** s.x)), rhs: d6(s.x * L10(s.a)) }));
for (const s of IDENTITY) if (Math.abs(s.lhs - s.rhs) > 1e-6) throw new Error(`log a^x = x log a failed at a = ${s.a}, x = ${s.x}`);

/* ---- error routes, executed --------------------------------------------------------------------- */

const routes = {
  /**
   * The brackets are dropped where there was one to drop, so the logarithm multiplies only the
   * constant term of that index (the slip the reports print as "2x - 1 log 3"). An index with no
   * constant has no bracket, so that side is untouched.
   */
  bracketsOmitted: (e) => {
    const leftBracket = e.c !== 0 && e.m !== 0;
    const rightBracket = e.p !== 0 && e.q !== 0;
    const lhsCoef = leftBracket ? e.m : e.m * L10(e.L);
    const lhsConst = leftBracket ? e.c * L10(e.L) : 0;
    const rhsCoef = e.p === 0 ? 0 : rightBracket ? e.p : e.p * L10(e.R);
    const rhsConst = e.p === 0 ? e.q * L10(e.R) : e.q * L10(e.R);
    const denom = lhsCoef - rhsCoef;
    if (Math.abs(denom) < 1e-12) return null;
    return (rhsConst - lhsConst) / denom;
  },
  /** An x term is moved across without its sign changing, so the two x terms add instead of subtract. */
  termsNotCollected: (e) => {
    const denom = e.m * L10(e.L) + e.p * L10(e.R);
    if (Math.abs(denom) < 1e-12) return null;
    return (e.q * L10(e.R) - e.c * L10(e.L)) / denom;
  },
  /** The difference of two logarithms in the numerator is carried out as a division. */
  logsDividedNotSubtracted: (e) => {
    if (e.c === 0) return null;
    return (e.q * L10(e.R)) / (e.c * L10(e.L)) / (e.m * L10(e.L) - e.p * L10(e.R));
  },
  /** Every logarithm rounded to two decimal places before anything is combined. */
  roundedTooEarly: (e) => {
    const lL = d2(L10(e.L));
    const lR = d2(L10(e.R));
    return (e.q * lR - e.c * lL) / (e.m * lL - e.p * lR);
  },
  /** The power undone by dividing, as though the index were a multiplier. */
  dividedNotLogged: (e) => e.R / e.L,
  /** The quotient of two logarithms carried out as a subtraction. */
  subtractedNotDivided: (e) => e.q * L10(e.R) - e.m * L10(e.L),
};

const E = {
  q1Divided: routes.dividedNotLogged(Q1),
  q1Subtracted: routes.subtractedNotDivided(Q1),
  q2Brackets: routes.bracketsOmitted(Q2),
  q3Brackets: routes.bracketsOmitted(Q3),
  q4Brackets: routes.bracketsOmitted(Q4),
  q5Collected: routes.termsNotCollected(Q5),
  q6Rounded: routes.roundedTooEarly(Q6),
  exaBrackets: routes.bracketsOmitted(EXA),
  exaCollected: routes.termsNotCollected(EXA),
  exaDivided: routes.logsDividedNotSubtracted(EXA),
};
for (const [key, v] of Object.entries(E)) if (v === null || !Number.isFinite(v)) throw new Error(`route ${key} reached no value`);

/* ---- figures -------------------------------------------------------------------------------------- */

const rr = (v) => num(Math.round(v * 10) / 10);

function trappedSvg() {
  const body = [
    svgRect(40, 30, 220, 64, { width: 1.2, fill: "currentColor", opacity: 0.06 }),
    svgText(150, 22, "the index is the unknown", { size: 10.5 }),
    svgText(150, 72, `${Q1.L}^x = ${Q1.R}`, { size: 26 }),
    svgPath("M 268 62 L 322 62 M 312 55 L 322 62 L 312 69", { width: 1.6 }),
    svgText(295, 48, "take logs", { size: 10 }),
    svgRect(330, 30, 220, 64, { width: 1.2, fill: "currentColor", opacity: 0.06 }),
    svgText(440, 22, "now it is an ordinary factor", { size: 10.5 }),
    svgText(440, 72, `x log ${Q1.L} = log ${Q1.R}`, { size: 20 }),
    svgPath("M 150 100 L 150 118 M 143 108 L 150 118 L 157 108", { width: 1.1, dash: "4 3" }),
    svgPath("M 440 100 L 440 118 M 433 108 L 440 118 L 447 108", { width: 1.1, dash: "4 3" }),
    svgText(150, 134, "dividing by 2 does nothing here", { size: 11 }),
    svgText(440, 134, "divide by log 2 and x is free", { size: 11 }),
    svgText(295, 164, "a logarithm is the only tool that brings a power down", { size: 11.5 }),
  ].join("");
  return svgWrap(
    "0 0 590 178",
    `Two boxed equations side by side: 2 to the power x equals 40 on the left, and x times log 2 equals log 40 on the right, with an arrow labelled take logs running between them`,
    body,
  );
}

function routeSvg() {
  // An SVG text node renders its characters literally, so the index is bracketed rather than braced:
  // "5^{3x - 2}" stripped of its braces would read "53x - 2".
  const lines = [
    `${WE.L}^(${idx(WE.m, WE.c)}) = ${WE.R}`,
    `log(${WE.L}^(${idx(WE.m, WE.c)})) = log ${WE.R}`,
    `(${idx(WE.m, WE.c)}) log ${WE.L} = log ${WE.R}`,
    `${idx(WE.m, WE.c)} = log ${WE.R} / log ${WE.L}`,
    `x = ${d2(WE.x)}`,
  ];
  const notes = [
    "the equation as printed",
    "take logs of both sides",
    "the power law brings the index down",
    "divide by log 5, then tidy",
    "only now reach for the calculator",
  ];
  const out = [];
  lines.forEach((t, i) => {
    // The caret is the exponent marker and must survive: stripping it turned "5^(3x - 2)" into "53x - 2".
    out.push(svgText(30, 34 + i * 32, t, { size: 14, anchor: "start" }));
    out.push(svgText(320, 34 + i * 32, notes[i], { size: 10.5, anchor: "start" }));
  });
  out.push(svgRect(20, 18 + 2 * 32, 280, 26, { width: 1.2, fill: "currentColor", opacity: 0.09 }));
  return svgWrap(
    "0 0 560 196",
    `Five lines of working solving 5 to the power 3x minus 2 equals 40, each with a short note beside it, and the line where the power law is used highlighted`,
    out.join(""),
  );
}

function bracketSvg() {
  const out = [
    svgRect(20, 26, 250, 96, { width: 1.2, fill: "currentColor", opacity: 0.05 }),
    svgText(145, 20, "with the brackets", { size: 10.5 }),
    svgText(145, 56, `(${idx(EXA.m, EXA.c)}) log ${EXA.L}`, { size: 17 }),
    svgText(145, 84, "every term inside is", { size: 10.5 }),
    svgText(145, 100, `multiplied by log ${EXA.L}`, { size: 10.5 }),
    svgRect(310, 26, 250, 96, { width: 1.2, fill: "currentColor", opacity: 0.05 }),
    svgText(435, 20, "without them", { size: 10.5 }),
    svgText(435, 56, `${EXA.m}x ${EXA.c < 0 ? "-" : "+"} ${Math.abs(EXA.c)} log ${EXA.L}`, { size: 17 }),
    svgText(435, 84, `only the ${Math.abs(EXA.c)} is multiplied,`, { size: 10.5 }),
    svgText(435, 100, "so the equation changes", { size: 10.5 }),
    svgPath("M 272 74 L 306 74", { width: 1, dash: "3 3" }),
    svgText(290, 140, "one pair of brackets, five marks", { size: 11.5 }),
  ].join("");
  return svgWrap(
    "0 0 580 154",
    `Two boxes: on the left the index written in brackets and multiplied by the logarithm, on the right the same line with the brackets missing so the logarithm multiplies only the constant`,
    out,
  );
}

function collectSvg() {
  const lines = [
    `(${idx(EXA.m, EXA.c)}) log ${EXA.L} = (${idx(EXA.p, EXA.q)}) log ${EXA.R}`,
    `${EXA.m}x log ${EXA.L} + log ${EXA.L} = x log ${EXA.R} + ${EXA.q} log ${EXA.R}`,
    `${EXA.m}x log ${EXA.L} - x log ${EXA.R} = ${EXA.q} log ${EXA.R} - log ${EXA.L}`,
    `x(${EXA.m} log ${EXA.L} - log ${EXA.R}) = ${EXA.q} log ${EXA.R} - log ${EXA.L}`,
    `x = ${d2(EXA.x)}`,
  ];
  const notes = ["logs of both sides, with brackets", "expand both sides", "x terms left, numbers right", "factorise x out", "divide, and only then evaluate"];
  const out = [];
  lines.forEach((t, i) => {
    out.push(svgText(26, 32 + i * 32, t, { size: 12.5, anchor: "start" }));
    out.push(svgText(360, 32 + i * 32, notes[i], { size: 10.5, anchor: "start" }));
  });
  out.push(svgRect(18, 16 + 3 * 32, 330, 26, { width: 1.2, fill: "currentColor", opacity: 0.09 }));
  return svgWrap(
    "0 0 580 196",
    `Five lines of working solving 2 to the power 4x plus 1 equals 7 to the power x plus 3, each with a short note beside it, and the factorising line highlighted`,
    out.join(""),
  );
}

function accuracySvg() {
  const early = d2(E.q6Rounded);
  const out = [
    svgRect(24, 28, 246, 104, { width: 1.2, fill: "currentColor", opacity: 0.05 }),
    svgText(147, 22, "rounded on the way", { size: 10.5 }),
    svgText(147, 56, `log ${Q6.R} ≈ ${d2(L10(Q6.R))}`, { size: 13 }),
    svgText(147, 78, `log ${Q6.L} ≈ ${d2(L10(Q6.L))}`, { size: 13 }),
    svgText(147, 110, `x = ${early.toFixed(2)}`, { size: 16 }),
    svgRect(310, 28, 246, 104, { width: 1.2, fill: "currentColor", opacity: 0.05 }),
    svgText(433, 22, "kept until the end", { size: 10.5 }),
    svgText(433, 56, `log ${Q6.R} ÷ log ${Q6.L}`, { size: 13 }),
    svgText(433, 78, "in one calculator step", { size: 10.5 }),
    svgText(433, 110, `x = ${d2(Q6.x).toFixed(2)}`, { size: 16 }),
    svgPath("M 274 80 L 306 80", { width: 1, dash: "3 3" }),
    svgText(290, 152, "two decimal places apart, and one of them is the mark", { size: 11.5 }),
  ].join("");
  return svgWrap(
    "0 0 580 166",
    `Two boxes comparing the same equation solved with the logarithms rounded to two decimal places first and with them kept to full precision until the last step, giving different answers`,
    out,
  );
}

const TRAPPED_SVG = trappedSvg();
const ROUTE_SVG = routeSvg();
const BRACKET_SVG = bracketSvg();
const COLLECT_SVG = collectSvg();
const ACCURACY_SVG = accuracySvg();

/* ---- note --------------------------------------------------------------------------------------- */

const blocks = [
  {
    type: "hero",
    lede: "Sometimes the unknown is the power itself. You cannot divide a power away, so the equation looks stuck. Taking logarithms of both sides brings the index down to the front, and what is left is an ordinary linear equation you already know how to solve.",
    can: [
      "Take logarithms of both sides and bring the index down with brackets",
      "Expand, collect the x terms on one side and factorise to reach x",
      "Keep full accuracy until the last step and answer to the accuracy asked for",
    ],
    minutes: 11,
  },
  { type: "h", text: "When the unknown has climbed into the power" },
  {
    type: "p",
    md: `$${Q1.L}^{x} = ${Q1.R}$ looks like nothing you can rearrange. Dividing by $${Q1.L}$ does not touch the $x$, because the $x$ is an index rather than a multiplier.\nA logarithm is the tool that moves it. Take logs of both sides and the power law turns $\\log ${Q1.L}^{x}$ into $x \\log ${Q1.L}$, so the $x$ becomes an ordinary factor and the equation becomes linear.`,
  },
  {
    type: "figure",
    alt: `Two boxed equations: 2 to the power x equals 40 on the left, and x times log 2 equals log 40 on the right, joined by an arrow labelled take logs.`,
    svg: TRAPPED_SVG,
    caption: `Once the index is down at the front it is just a number multiplying $x$.`,
  },
  {
    type: "gate",
    id: "g1",
    kind: "choice",
    prompt: `One tap to begin. In the picture above, $${Q1.L}^{x} = ${Q1.R}$ becomes $x \\log ${Q1.L} = \\log ${Q1.R}$. Which law of logarithms did that?`,
    options: ["The power law", "The product law", "The quotient law"],
    answer: "The power law",
    explain: `$\\log a^{n} = n \\log a$ is the power law. It is the only one that moves an index, and it is the first line of every question of this kind.`,
  },
  { type: "h", text: "1. The route, line by line" },
  {
    type: "p",
    md: `Solve $${printEq(WE)}$.\n**Step 1.** Take logs of both sides.\n**Step 2.** The power law brings the whole index down, in brackets: $(${idx(WE.m, WE.c)}) \\log ${WE.L} = \\log ${WE.R}$.\n**Step 3.** Divide by $\\log ${WE.L}$, then tidy the linear equation.\n**Step 4.** Evaluate once, at the end: $x = ${d2(WE.x).toFixed(2)}$ to two decimal places.`,
  },
  {
    type: "figure",
