          { id: "c", text: "The answer is more accurate, because the numbers are simpler", correct: false, misconception: "fm.logs.rounded-too-early", feedback: `Simpler numbers are not more accurate ones. Keep the logarithms in the calculator until the last step.` },
        ],
        secondsExpected: 35,
        confidence: true,
        hypercorrectionQueue: true,
      },
    ],
  },
];

const findTheMistake = [
  {
    id: `ftm.${TOPIC}.01`,
    topic: TOPIC,
    specRefs: REFS,
    // The equation is printed as KaTeX so the index's extent is unambiguous: this item is *about*
    // how far an index reaches, and "7^3x - 1" would read as 343x - 1.
    stem: `Cara was asked to solve $${printEq(Q3)}$ correct to two decimal places. Her working:`,
    studentWorking: [
      `$\\log\\left(${Q3.L}^{${idx(Q3.m, Q3.c)}}\\right) = \\log ${Q3.R}$`,
      `${idx(Q3.m, Q3.c)} log ${Q3.L} = log ${Q3.R}`,
      `${Q3.m}x = log ${Q3.R} + log ${Q3.L}`,
      `${Q3.m}x = ${d6(L10(Q3.R) + L10(Q3.L))}`,
      `x = ${d2(E.q3Brackets).toFixed(2)}`,
    ],
    mistakeLine: 2,
    misconception: "fm.logs.brackets-omitted",
    whatWentWrong: `Line 1 is right: logarithms of both sides is always the first move.\nLine 2 brings the index down without a bracket, so $\\log ${Q3.L}$ multiplies only the $${Math.abs(Q3.c)}$ and no longer multiplies the $${Q3.m}x$. Everything after that solves a different equation, which is why the answer is out by more than a rounding.\nThe line should read $(${idx(Q3.m, Q3.c)}) \\log ${Q3.L} = \\log ${Q3.R}$, and then $x = ${d2(Q3.x).toFixed(2)}$.`,
    correction: [
      `(${idx(Q3.m, Q3.c)}) log ${Q3.L} = log ${Q3.R}`,
      `${idx(Q3.m, Q3.c)} = log ${Q3.R} / log ${Q3.L} = ${d6(L10(Q3.R) / L10(Q3.L))}`,
      `x = ${d2(Q3.x).toFixed(2)}`,
    ],
    marksEarnedAsWritten: ["M1"],
    feedback: `Taking logarithms of both sides is the right first move and it earns its mark. The bracket is what the rest depends on: the index is one expression, so all of it multiplies the logarithm. Write the bracket as you bring the index down, every time, and the rest is a linear equation you can already do.`,
    source: CER18,
  },
];

const prompts = [
  {
    id: `rp.${TOPIC}.01`,
    kind: "procedure",
    prompt: "Give the first two lines of solving an equation with the unknown in the index.",
    answer: "Take logarithms of both sides, then use the power law to bring each whole index down in front of its logarithm, inside a bracket.",
    keyWords: ["logarithms of both sides", "power law", "bracket"],
    difficultyPrior: 4,
  },
  {
    id: `rp.${TOPIC}.02`,
    kind: "trap",
    prompt: "Why must the index be written in a bracket when it comes down?",
    answer: "Because the whole index multiplies the logarithm. Without the bracket only the constant is multiplied, and the equation being solved is no longer the one that was set.",
    keyWords: ["whole index", "constant", "bracket"],
    difficultyPrior: 5,
  },
  {
    id: `rp.${TOPIC}.03`,
    kind: "procedure",
    prompt: "With logarithms on both sides, how is $x$ found?",
    answer: "Expand both brackets, move the $x$ terms to one side and the numbers to the other, factorise $x$ out, then divide.",
    keyWords: ["expand", "factorise", "divide"],
    difficultyPrior: 5,
  },
  {
    id: `rp.${TOPIC}.04`,
    kind: "trap",
    prompt: "From $x \\log 2 = \\log 40$, what is the next line, and what is it not?",
    answer: "It is $x = \\frac{\\log 40}{\\log 2}$, a quotient of the two logarithms. It is not $\\log 40 - \\log 2$, which is a different number.",
    keyWords: ["quotient", "divide", "not"],
    difficultyPrior: 6,
  },
  {
    id: `rp.${TOPIC}.05`,
    kind: "trap",
    prompt: "When should the calculator be used in an indicial equation, and to what accuracy is the answer given?",
    answer: "Only at the last step, on the whole expression at once. Give two decimal places unless the question says otherwise.",
    keyWords: ["last step", "two decimal places"],
    difficultyPrior: 4,
  },
  {
    id: `rp.${TOPIC}.06`,
    kind: "qa",
    prompt: "When can an indicial equation be solved without logarithms at all?",
    answer: "When both sides can be written as powers of the same base. Then the indices are equal and the equation is linear at once.",
    keyWords: ["same base", "indices are equal"],
    difficultyPrior: 5,
  },
];

/* ---- bundle ----------------------------------------------------------------------------------------- */

const noteChecks = [
  check("schema", "Validated against the Zod NoteFrontmatter and the NoteBlock union by pipeline/build-content.mts; the hero block is first, gate ids g1 to g5 are unique, every prompt block names a prompt in this bundle, and every gate restates the equation and the line it works from so it reads alone in the review inbox."),
  check("scope-tier", "FM1 is untiered and calculator-allowed. Every index is a constant or a linear expression in x, which is exactly what the FM1-LOG-03 teacher guidance allows. The change-of-base rule, natural logarithms and equations whose indices are quadratic appear nowhere."),
  check("formula-sheet", "The Unit 1 sheet gives a^x = n so x = log_a n. The power law that brings the index down is must-know, not given, and the note says so."),
  check("command-words", "Solve is the command word (typicalTariff 2-4-6 in packs/further-maths/exam-true/command-words.json), with its trap that every solution must be produced with algebraic working. The stems keep the shape of the indicial parts read in the 2018, 2022, 2023, 2024 and 2025 FM1 papers while every eight-word run and every base and coefficient is our own."),
  check("tariff", "3 to 5 marks for a single equation and 5 + 3 for the exam-style pair, matching Summer 2018 Q6 (5), Summer 2022 Q5(b) (4), Summer 2023 Q7(b) (4), Summer 2024 Q6(b) (5) and Summer 2025 Q9(b) (5)."),
  check("maths-numeric", `Every solution is produced by solve(), which applies the method symbolically and then checks the answer by substituting it back into both sides at full precision (${[WE, Q1, Q2, Q3, Q4, Q5, Q6, EXA, EXB].map((e) => `${printEq(e).replace(/[{}$\\]/g, "")} -> ${d6(e.x)}`).join("; ")}). The identity log a^x = x log a was checked at three sample points: ${IDENTITY.map((s) => `a = ${s.a}, x = ${s.x} (${s.lhs} vs ${s.rhs})`).join("; ")}.`),
  check("examiner-alignment", "One examiner callout stands in the body beside the bracket step (Summer 2018 Q6). Every other finding is a Sheet trap. Gates g1 and g2 run the one-sided route, g3 is the bracket, g4 the collecting, g5 the accuracy."),
  check("copy-shingle", "An 8-word shingle scan of the note and the bundle against every text file of the private FM corpus (scratchpad/fm1-batch-f/lib.mjs shingleClash) returns nothing. Every base, coefficient and constant is new: the corpus equations were read only for tariff and part structure."),
  check("style-lint", "British English, second person, calm; no exclamation marks and no verdict word about a learner's answer. Every maths segment opens and closes inside one line and holds no prose words, checked by lintTree before the files were written. Five inline SVG figures, all built from the computed working, and one embeddable video from data/links/media-map.json followed immediately by a gate. The closing panel is a pointer of under 80 words followed by the prompts."),
];

const itemChecks = (detail) => [
  check("schema", "Validated by pipeline/build-content.mts against the Zod Question / WorkedExample / DiagnosticSet / FindTheMistake schema; every scheme sums to its part's marks and the skeleton matches the parts."),
  check("maths-numeric", detail),
  check("command-words", "Command words and tariffs taken from packs/further-maths/exam-true/command-words.json; the wording is ours."),
  check("examiner-alignment", "Every distractor and common error carries a registry misconception evidenced by the Summer 2018 Q6, Summer 2019 Q9, Summer 2022 Q5 or Summer 2025 Q9 report block."),
  check("copy-shingle", "8-word shingle scan against the private FM corpus returns nothing."),
  check("style-lint", "KaTeX segments paired and prose-free; British English; no exclamation marks."),
];

const verification = [
  verLog(`ver.note.${TOPIC}`, `note.${TOPIC}`, noteChecks),
  verLog(`ver.we.${TOPIC}.01`, `we.${TOPIC}.01`, itemChecks(`The worked example solves ${printEq(WE).replace(/[{}$\\]/g, "")}: the quotient of logarithms is ${d6(L10(WE.R) / L10(WE.L))}, so x = ${d6(WE.x)} and the printed answer is ${d2(WE.x).toFixed(2)}. Substituting back gives ${d6(WE.lhs)} against ${d6(WE.rhs)}. The twin solves ${printEq(Q3).replace(/[{}$\\]/g, "")}, giving ${d2(Q3.x).toFixed(2)}.`)),
  ...builtQuestions.map((q) =>
    verLog(
      `ver.${q.id}`,
      q.id,
      itemChecks(
        `Every value was computed by solve() and checked by substitution: ${q.parts.map((p) => `${p.id} -> ${p.answer.value}`).join("; ")}. Each common-error value was produced by executing the route its feedback describes (routes.* in the generator) and re-checked against the published JSON by verify-published.mjs.`,
      ),
    ),
  ),
];

