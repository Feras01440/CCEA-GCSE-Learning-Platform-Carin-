/**
 * Calculus helpers for the FM1 batch-D generators (differentiation-integer-powers,
 * gradient-at-a-point, tangents-and-normals, stationary-points-and-nature).
 *
 * Everything printed in the four bundles comes from these functions: the polynomials, their
 * derivatives, every gradient, every tangent and normal, every stationary point, every
 * distractor and every curve drawn in an SVG. Nothing is a hand-typed number.
 *
 * A "poly" is a list of terms { c, p } with an INTEGER coefficient c and an INTEGER power p,
 * which is exactly the scope of FM1-DIF-01 (fractional indices are excluded).
 */
import { esc, wrap, assertClean } from "./lib.mjs";

// ---------------------------------------------------------------------------
// exact rationals (so a gradient of -1/5 is never a float in a comparison)
// ---------------------------------------------------------------------------

const gcd = (a, b) => {
  a = Math.abs(a);
  b = Math.abs(b);
  while (b) {
    const t = a % b;
    a = b;
    b = t;
  }
  return a || 1;
};

/** A rational n/d in lowest terms with a positive denominator. */
export function fr(n, d = 1) {
  if (!Number.isInteger(n) || !Number.isInteger(d)) throw new Error(`fr(): not integers (${n}, ${d})`);
  if (d === 0) throw new Error("fr(): zero denominator");
  if (d < 0) {
    n = -n;
    d = -d;
  }
  const g = gcd(n, d);
  return { n: n / g, d: d / g };
}
export const fadd = (a, b) => fr(a.n * b.d + b.n * a.d, a.d * b.d);
export const fsub = (a, b) => fr(a.n * b.d - b.n * a.d, a.d * b.d);
export const fmul = (a, b) => fr(a.n * b.n, a.d * b.d);
export const fdiv = (a, b) => {
  if (b.n === 0) throw new Error("fdiv(): division by zero");
  return fr(a.n * b.d, a.d * b.n);
};
export const fneg = (a) => fr(-a.n, a.d);
export const finv = (a) => fdiv(fr(1), a);
export const fval = (a) => a.n / a.d;
export const fisInt = (a) => a.d === 1;
export const feq = (a, b) => a.n === b.n && a.d === b.d;

/** True when the rational has a finite decimal expansion (denominator 2^a 5^b). */
export function terminates(a) {
  let d = a.d;
  while (d % 2 === 0) d /= 2;
  while (d % 5 === 0) d /= 5;
  return d === 1;
}

/** The exact decimal string of a terminating rational; throws for a recurring one. */
export function fdec(a) {
  if (!terminates(a)) throw new Error(`fdec(): ${a.n}/${a.d} does not terminate`);
  if (a.d === 1) return String(a.n);
  const places = (() => {
    let d = a.d;
    let two = 0;
    let five = 0;
    while (d % 2 === 0) {
      d /= 2;
      two += 1;
    }
    while (d % 5 === 0) {
      d /= 5;
      five += 1;
    }
    return Math.max(two, five);
  })();
  const s = (a.n / a.d).toFixed(places);
  return s.replace(/(\.\d*?)0+$/, "$1").replace(/\.$/, "");
}

/** LaTeX for a rational: an integer bare, otherwise \frac{a}{b} with the sign outside. */
export function flatex(a) {
  if (a.d === 1) return String(a.n);
  const sign = a.n < 0 ? "-" : "";
  return `${sign}\\frac{${Math.abs(a.n)}}{${a.d}}`;
}

/** Plain text for a rational, as a learner would type it: "4/3", "-0.2", "7". */
export const fplain = (a) => (a.d === 1 ? String(a.n) : terminates(a) ? fdec(a) : `${a.n}/${a.d}`);

// ---------------------------------------------------------------------------
// polynomials with integer powers
// ---------------------------------------------------------------------------

/** Build a poly from [[coefficient, power], …]. */
export const P = (pairs) => normalise(pairs.map(([c, p]) => ({ c, p })));

/** Merge equal powers, drop zero coefficients, order by falling power. */
export function normalise(terms) {
  const byPower = new Map();
  for (const t of terms) {
    if (!Number.isInteger(t.c) || !Number.isInteger(t.p)) throw new Error(`poly term not integral: ${JSON.stringify(t)}`);
    byPower.set(t.p, (byPower.get(t.p) ?? 0) + t.c);
  }
  return [...byPower.entries()]
    .filter(([, c]) => c !== 0)
    .map(([p, c]) => ({ c, p }))
    .sort((a, b) => b.p - a.p);
}

/** The derivative, term by term: c x^p becomes cp x^(p-1); a constant disappears. */
export const deriv = (terms) => normalise(terms.filter((t) => t.p !== 0).map((t) => ({ c: t.c * t.p, p: t.p - 1 })));

/** Value of the poly at a rational x, exactly. */
export function at(terms, x) {
  let sum = fr(0);
  for (const t of terms) {
    if (t.p < 0 && x.n === 0) throw new Error("at(): negative power evaluated at x = 0");
    let pw = fr(1);
    const k = Math.abs(t.p);
    for (let i = 0; i < k; i += 1) pw = fmul(pw, x);
    if (t.p < 0) pw = finv(pw);
    sum = fadd(sum, fmul(fr(t.c), pw));
  }
  return sum;
}

/** Value at a plain number (for drawing only). */
export function atNum(terms, x) {
  let sum = 0;
  for (const t of terms) sum += t.c * Math.pow(x, t.p);
  return sum;
}

export const polyEq = (a, b) => {
  const A = normalise(a);
  const B = normalise(b);
  return A.length === B.length && A.every((t, i) => t.c === B[i].c && t.p === B[i].p);
};

/**
 * LaTeX for a poly. Negative powers are printed as CCEA prints them in an answer,
 * as a fraction over x to a positive power; `style: "index"` prints them as x^{-n} instead.
 */
export function latex(terms, { lhs = null, style = "fraction" } = {}) {
  if (terms.length === 0) return lhs ? `${lhs} = 0` : "0";
  const bits = [];
  terms.forEach((t, i) => {
    const neg = t.c < 0;
    const m = Math.abs(t.c);
    let body;
    if (t.p === 0) body = String(m);
    else if (t.p > 0) body = `${m === 1 ? "" : m}x${t.p === 1 ? "" : `^{${t.p}}`}`;
    else if (style === "index") body = `${m === 1 ? "" : m}x^{${t.p}}`;
    // House style follows CCEA: a reciprocal term prints as 9/x, never as 9 over x to the power 1.
    else body = t.p === -1 ? `\\frac{${m}}{x}` : `\\frac{${m}}{x^{${-t.p}}}`;
    if (i === 0) bits.push(neg ? `-${body}` : body);
    else bits.push(`${neg ? "-" : "+"} ${body}`);
  });
  const body = bits.join(" ");
  return lhs ? `${lhs} = ${body}` : body;
}

/** Plain-text spelling of a poly for studentWorking lines: "12x^2 - 12/x^3". */
export function plain(terms) {
  if (terms.length === 0) return "0";
  const bits = [];
  terms.forEach((t, i) => {
    const neg = t.c < 0;
    const m = Math.abs(t.c);
    let body;
    if (t.p === 0) body = String(m);
    else if (t.p > 0) body = `${m === 1 ? "" : m}x${t.p === 1 ? "" : `^${t.p}`}`;
    else body = `${m}/x^${-t.p}`;
    if (i === 0) bits.push(neg ? `-${body}` : body);
    else bits.push(`${neg ? "-" : "+"} ${body}`);
  });
  return bits.join(" ");
}

// ---------------------------------------------------------------------------
// error routes: each one EXECUTES a described mistake on the poly
// ---------------------------------------------------------------------------

export const routes = {
  /** Multiplies by the power but leaves the index alone: 4x^3 becomes 12x^3. */
  powerNotReduced: (ts) => normalise(ts.filter((t) => t.p !== 0).map((t) => ({ c: t.c * t.p, p: t.p }))),
  /** Drops the index by one but never multiplies the coefficient: 4x^3 becomes 4x^2. */
  coefficientNotMultiplied: (ts) => normalise(ts.filter((t) => t.p !== 0).map((t) => ({ c: t.c, p: t.p - 1 }))),
  /** Differentiates everything else correctly and copies the constant term down. */
  constantKept: (ts) => normalise([...deriv(ts), ...ts.filter((t) => t.p === 0)]),
  /** Moves a/x^n to the top line as a x^n, then differentiates that. */
  indexMovedUp: (ts) =>
    normalise(
      ts
        .filter((t) => t.p !== 0)
        .map((t) => (t.p < 0 ? { c: t.c * -t.p, p: -t.p - 1 } : { c: t.c * t.p, p: t.p - 1 })),
    ),
  /** Reduces the negative index correctly but keeps the sign the term started with. */
  negPowerSignKept: (ts) =>
    normalise(ts.filter((t) => t.p !== 0).map((t) => ({ c: t.p < 0 ? -(t.c * t.p) : t.c * t.p, p: t.p - 1 }))),
  /** Forgets that the derivative of x is 1, so the linear term vanishes. */
  linearTermDropped: (ts) => normalise(ts.filter((t) => t.p !== 0 && t.p !== 1).map((t) => ({ c: t.c * t.p, p: t.p - 1 }))),
};

/** The route's output, guaranteed different from the correct derivative (else it could never fire). */
export function route(name, ts) {
  const wrong = routes[name](ts);
  if (polyEq(wrong, deriv(ts))) throw new Error(`route ${name} reaches the correct derivative for ${plain(ts)}`);
  return wrong;
}

/** Gradient routes for tangents and normals; each returns an exact rational. */
export const gradientRoutes = {
  /** The normal's gradient with the sign changed but no reciprocal taken. */
  normalNotReciprocated: (m) => fneg(m),
  /** The reciprocal taken but the sign left alone. */
  normalSignNotFlipped: (m) => finv(m),
  /** The tangent's gradient used for the normal without any change at all. */
  normalUnchanged: (m) => m,
};

// ---------------------------------------------------------------------------
// lines
// ---------------------------------------------------------------------------

/** The line of gradient m through (x1, y1), returned exactly as { m, c }. */
export function lineThrough(m, x1, y1) {
  return { m, c: fsub(y1, fmul(m, x1)) };
}

/** LaTeX "y = mx + c" from exact rationals, with 1 and -1 and a zero constant handled. */
export function lineLatex({ m, c }) {
  const mPart = m.n === 0 ? "" : feq(m, fr(1)) ? "x" : feq(m, fr(-1)) ? "-x" : `${flatex(m)}x`;
  if (c.n === 0) return `y = ${mPart === "" ? "0" : mPart}`;
  if (m.n === 0) return `y = ${flatex(c)}`;
  const sign = c.n < 0 ? "-" : "+";
  return `y = ${mPart} ${sign} ${flatex(fr(Math.abs(c.n), c.d))}`;
}

/** The same line as a learner would type it on the keypad: "y=-0.2x-1.6". */
export function linePlain({ m, c }) {
  const mPart = m.n === 0 ? "" : feq(m, fr(1)) ? "x" : feq(m, fr(-1)) ? "-x" : `${fplain(m)}x`;
  if (c.n === 0) return `y=${mPart === "" ? "0" : mPart}`;
  if (m.n === 0) return `y=${fplain(c)}`;
  return `y=${mPart}${c.n < 0 ? "-" : "+"}${fplain(fr(Math.abs(c.n), c.d))}`;
}

/** A coordinate pair as the marker wants it: "(2, -3)" or "(\frac{5}{2}, 7)". */
export const pointLatex = (x, y) => `(${flatex(x)}, ${flatex(y)})`;
/** The same pair as a learner types it: "(2.5, 7)". */
export const pointPlain = (x, y) => `(${fplain(x)}, ${fplain(y)})`;

/** Guards a coordinate answer: both ordinates must have a finite decimal, or a typed decimal is rejected. */
export function assertTerminating(where, ...values) {
  for (const v of values) {
    if (!terminates(v)) throw new Error(`${where}: ${v.n}/${v.d} does not terminate, so a typed decimal would be marked wrong`);
  }
}

// ---------------------------------------------------------------------------
// graph SVG: axes, grid, curves through computed points, marked points
// ---------------------------------------------------------------------------

const r1 = (v) => {
  if (!Number.isFinite(v)) throw new Error(`svg coordinate not finite: ${v}`);
  return Number(v.toFixed(1));
};

/**
 * Ramer-Douglas-Peucker (23 Sep, used by graphSvg's phone option): the fewest of the sampled points that keep the
 * drawn polyline within eps units of every sample, so a smooth curve stays smooth and a straight line costs two points.
 */
function rdp(pts, eps) {
  if (pts.length < 3) return pts;
  const [ax, ay] = pts[0];
  const [bx, by] = pts[pts.length - 1];
  const len = Math.hypot(bx - ax, by - ay) || 1;
  let worst = 0;
  let at = 0;
  for (let i = 1; i < pts.length - 1; i += 1) {
    const d = Math.abs((bx - ax) * (ay - pts[i][1]) - (ax - pts[i][0]) * (by - ay)) / len;
    if (d > worst) {
      worst = d;
      at = i;
    }
  }
  if (worst <= eps) return [pts[0], pts[pts.length - 1]];
  const left = rdp(pts.slice(0, at + 1), eps);
  const right = rdp(pts.slice(at), eps);
  return [...left.slice(0, -1), ...right];
}

/**
 * A graph on squared paper. Every curve is sampled from its own function, so nothing is drawn by hand.
 *
 *   curves   [{ f, dash, width, label, labelAt, from, to }]
 *   points   [{ x, y, label, open, dx, dy, anchor }]
 *   drops    [{ x, y, label }]        dashed line from the point down to the x axis
 *   vLines / hLines  [{ at, label, dash }]
 *   tri      { x1, x2, m, label }     a gradient triangle on a straight line
 *   phone    23 Sep (depth standard, Figures): draw every label at 14 units (axis names 15), and curves simplified by
 *            Ramer-Douglas-Peucker rather than thin(), so that, in a viewBox
 *            about 400 wide, the smallest renders at 12.5 px or more in the 358 px phone column; the caption is
 *            left to the note block. Off by default, so every figure drawn before 23 Sep is byte-identical.
 */
export function graphSvg({
  phone = false,
  title,
  width = 560,
  height = 360,
  xMin,
  xMax,
  yMin,
  yMax,
  xStep = 1,
  yStep = 1,
  curves = [],
  points = [],
  drops = [],
  vLines = [],
  hLines = [],
  tri = null,
  xLabel = "x",
  yLabel = "y",
  caption,
  grid = true,
}) {
  // label sizes: the 20 Sep values unless phone is asked for (see the doc comment)
  const FT = phone ? 14 : 11;
  const FL = phone ? 14 : 11.5;
  const FA = phone ? 15 : 12;
  if (phone) caption = undefined;
  const L = 52;
  const R = width - 20;
  const T = 24;
  const B = height - (caption ? 46 : 32);
  const sx = (x) => L + ((x - xMin) / (xMax - xMin)) * (R - L);
  const sy = (y) => B - ((y - yMin) / (yMax - yMin)) * (B - T);
  const ax = xMin <= 0 && xMax >= 0 ? sx(0) : L;
  const ay = yMin <= 0 && yMax >= 0 ? sy(0) : B;
  const parts = [];

  if (grid) {
    const d = [];
    for (let x = Math.ceil(xMin / xStep) * xStep; x <= xMax + 1e-9; x += xStep) d.push(`M ${r1(sx(x))} ${r1(T)} L ${r1(sx(x))} ${r1(B)}`);
    for (let y = Math.ceil(yMin / yStep) * yStep; y <= yMax + 1e-9; y += yStep) d.push(`M ${r1(L)} ${r1(sy(y))} L ${r1(R)} ${r1(sy(y))}`);
    parts.push(`<path d='${d.join(" ")}' stroke='currentColor' stroke-width='0.5' stroke-opacity='0.16' fill='none'/>`);
  }

  // axes
  parts.push(`<path d='M ${r1(L)} ${r1(ay)} L ${r1(R)} ${r1(ay)}' stroke='currentColor' stroke-width='1.3' fill='none'/>`);
  parts.push(`<path d='M ${r1(ax)} ${r1(T)} L ${r1(ax)} ${r1(B)}' stroke='currentColor' stroke-width='1.3' fill='none'/>`);

  // ticks
  for (let x = Math.ceil(xMin / xStep) * xStep; x <= xMax + 1e-9; x += xStep) {
    const v = Number(x.toFixed(6));
    if (Math.abs(v) < 1e-9) continue;
    parts.push(`<path d='M ${r1(sx(v))} ${r1(ay - 4)} L ${r1(sx(v))} ${r1(ay + 4)}' stroke='currentColor' stroke-width='1' fill='none'/>`);
    parts.push(
      `<text x='${r1(sx(v))}' y='${r1(Math.min(ay + (phone ? 20 : 17), B + (phone ? 17 : 14)))}' font-family='inherit' font-size='${FT}' fill='currentColor' text-anchor='middle'>${v}</text>`,
    );
  }
  for (let y = Math.ceil(yMin / yStep) * yStep; y <= yMax + 1e-9; y += yStep) {
    const v = Number(y.toFixed(6));
    if (Math.abs(v) < 1e-9) continue;
    parts.push(`<path d='M ${r1(ax - 4)} ${r1(sy(v))} L ${r1(ax + 4)} ${r1(sy(v))}' stroke='currentColor' stroke-width='1' fill='none'/>`);
    parts.push(
      `<text x='${r1(Math.max(ax - 8, L - 8))}' y='${r1(sy(v) + (phone ? 5 : 4))}' font-family='inherit' font-size='${FT}' fill='currentColor' text-anchor='end'>${v}</text>`,
    );
  }
  parts.push(`<text x='${r1(ax - 7)}' y='${r1(ay + (phone ? 17 : 14))}' font-family='inherit' font-size='${FT}' fill='currentColor' text-anchor='end'>0</text>`);

  for (const g of hLines) {
    parts.push(
      `<path d='M ${r1(L)} ${r1(sy(g.at))} L ${r1(R)} ${r1(sy(g.at))}' stroke='currentColor' stroke-width='1.1' stroke-dasharray='5 4' stroke-opacity='0.75' fill='none'/>`,
    );
    if (g.label) parts.push(`<text x='${r1(R - 3)}' y='${r1(sy(g.at) - 5)}' font-family='inherit' font-size='${FT}' fill='currentColor' text-anchor='end'>${esc(g.label)}</text>`);
  }
  for (const g of vLines) {
    parts.push(
      `<path d='M ${r1(sx(g.at))} ${r1(T)} L ${r1(sx(g.at))} ${r1(B)}' stroke='currentColor' stroke-width='1.1' stroke-dasharray='5 4' stroke-opacity='0.75' fill='none'/>`,
    );
    if (g.label) parts.push(`<text x='${r1(sx(g.at))}' y='${r1(T + 11)}' font-family='inherit' font-size='${FT}' fill='currentColor' text-anchor='middle'>${esc(g.label)}</text>`);
  }

  // curves, sampled, then thinned so a straight line costs two points instead of two hundred
  const thin = (pts) => {
    if (pts.length < 3) return pts;
    const out = [pts[0]];
    for (let i = 1; i < pts.length - 1; i += 1) {
      const [ax0, ay0] = out[out.length - 1];
      const [bx, by] = pts[i];
      const [cx, cy] = pts[i + 1];
      const area = Math.abs((bx - ax0) * (cy - ay0) - (cx - ax0) * (by - ay0));
      const span = Math.hypot(cx - ax0, cy - ay0) || 1;
      if (area / span > 0.25) out.push(pts[i]);
    }
    out.push(pts[pts.length - 1]);
    return out;
  };
  for (const cv of curves) {
    const from = cv.from ?? xMin;
    const to = cv.to ?? xMax;
    const steps = cv.steps ?? 300;
    const dx = (to - from) / steps;
    let run = [];
    const flush = () => {
      // phone (23 Sep): Ramer-Douglas-Peucker keeps the drawn curve within 0.3 units of the true one; thin() compares
      // each point only with its next neighbour, so a smooth curve sampled finely came out as a few long chords.
      const pts = phone ? rdp(run, 0.3) : thin(run);
      if (pts.length > 1) {
        parts.push(
          `<path d='M ${pts.map(([px, py]) => `${r1(px)} ${r1(py)}`).join(" L ")}' stroke='currentColor' stroke-width='${cv.width ?? 2}' fill='none' stroke-linejoin='round' stroke-linecap='round'${cv.dash ? " stroke-dasharray='6 4'" : ""}${cv.opacity ? ` stroke-opacity='${cv.opacity}'` : ""}/>`,
        );
      }
      run = [];
    };
    for (let i = 0; i <= steps; i += 1) {
      const x = from + i * dx;
      const y = cv.f(x);
      if (!Number.isFinite(y) || y < yMin - 1e-9 || y > yMax + 1e-9) {
        flush();
        continue;
      }
      run.push([sx(x), sy(y)]);
    }
    flush();
    if (cv.label) {
      const lx = cv.labelAt ?? (from + to) / 2;
      const ly = cv.f(lx);
      if (Number.isFinite(ly)) {
        parts.push(
          `<text x='${r1(sx(lx))}' y='${r1(sy(ly) + (cv.labelBelow ? 16 : -8))}' font-family='inherit' font-size='${FL}' fill='currentColor' text-anchor='middle'>${esc(cv.label)}</text>`,
        );
      }
    }
  }

  if (tri) {
    const { x1, x2, f } = tri;
    const y1 = f(x1);
    const y2 = f(x2);
    parts.push(
      `<path d='M ${r1(sx(x1))} ${r1(sy(y1))} L ${r1(sx(x2))} ${r1(sy(y1))} L ${r1(sx(x2))} ${r1(sy(y2))}' stroke='currentColor' stroke-width='1.2' stroke-dasharray='4 3' fill='none' stroke-opacity='0.85'/>`,
    );
    if (tri.runLabel) {
      parts.push(
        `<text x='${r1((sx(x1) + sx(x2)) / 2)}' y='${r1(sy(y1) + 14)}' font-family='inherit' font-size='${FT}' fill='currentColor' text-anchor='middle'>${esc(tri.runLabel)}</text>`,
      );
    }
    if (tri.riseLabel) {
      parts.push(
        `<text x='${r1(sx(x2) + 6)}' y='${r1((sy(y1) + sy(y2)) / 2 + 4)}' font-family='inherit' font-size='${FT}' fill='currentColor'>${esc(tri.riseLabel)}</text>`,
      );
    }
  }

  for (const d of drops) {
    parts.push(
      `<path d='M ${r1(sx(d.x))} ${r1(sy(d.y))} L ${r1(sx(d.x))} ${r1(ay)}' stroke='currentColor' stroke-width='1.1' stroke-dasharray='4 3' stroke-opacity='0.8' fill='none'/>`,
    );
  }

  const markers = [];
  for (const p of points) {
    const px = sx(p.x);
    const py = sy(p.y);
    markers.push([px, py]);
    parts.push(
      p.open
        ? `<circle cx='${r1(px)}' cy='${r1(py)}' r='4' fill='none' stroke='currentColor' stroke-width='1.8'/>`
        : `<circle cx='${r1(px)}' cy='${r1(py)}' r='3.6' fill='currentColor'/>`,
    );
    if (p.label) {
      const tx = px + (p.dx ?? 8);
      const ty = py + (p.dy ?? -8);
      markers.push([tx, ty]);
      parts.push(
        `<text x='${r1(tx)}' y='${r1(ty)}' font-family='inherit' font-size='${FL}' fill='currentColor' text-anchor='${p.anchor ?? "start"}'>${esc(p.label)}</text>`,
      );
    }
  }
  for (const [mx, my] of markers) {
    if (mx < 2 || mx > width - 2 || my < 10 || my > height - 2) {
      throw new Error(`${title}: a marker at (${r1(mx)}, ${r1(my)}) falls outside the viewBox 0 0 ${width} ${height}`);
    }
  }

  parts.push(`<text x='${r1(R)}' y='${r1(Math.max(ay - 8, T + 10))}' font-family='inherit' font-size='${FA}' fill='currentColor' text-anchor='end'>${esc(xLabel)}</text>`);
  parts.push(`<text x='${r1(ax + 7)}' y='${r1(T + 10)}' font-family='inherit' font-size='${FA}' fill='currentColor'>${esc(yLabel)}</text>`);
  if (caption) {
    parts.push(
      `<text x='${r1(width / 2)}' y='${r1(height - 10)}' font-family='inherit' font-size='11.5' fill='currentColor' text-anchor='middle'>${esc(caption)}</text>`,
    );
  }

  const svg = wrap({ width, height, title, body: parts.join("") });
  assertClean(svg);
  return svg;
}

/** A two-column "before and after" card, used for the power-rule and normal-gradient pictures. */
export function moveSvg({ title, heading, rows, width = 560, caption }) {
  const parts = [];
  const rowH = 34;
  const top = heading ? 46 : 22;
  const height = top + rowH * rows.length + (caption ? 26 : 10);
  if (heading) parts.push(`<text x='20' y='28' font-family='inherit' font-size='13' fill='currentColor' fill-opacity='0.8'>${esc(heading)}</text>`);
  rows.forEach((r, i) => {
    const y = top + rowH * i;
    parts.push(`<rect x='14' y='${r1(y)}' width='${r1(width - 28)}' height='${rowH - 8}' rx='5' fill='currentColor' fill-opacity='${r.tint ?? 0.06}' stroke='currentColor' stroke-width='1'/>`);
    parts.push(`<text x='28' y='${r1(y + 18)}' font-family='inherit' font-size='13' fill='currentColor'>${esc(r.left)}</text>`);
    if (r.right) {
      parts.push(`<text x='${r1(width - 28)}' y='${r1(y + 18)}' font-family='inherit' font-size='11.5' fill='currentColor' text-anchor='end'>${esc(r.right)}</text>`);
    }
  });
  if (caption) {
    parts.push(`<text x='${r1(width / 2)}' y='${r1(height - 8)}' font-family='inherit' font-size='11.5' fill='currentColor' text-anchor='middle'>${esc(caption)}</text>`);
  }
  const svg = wrap({ width, height, title, body: parts.join("") });
  assertClean(svg);
  return svg;
}
