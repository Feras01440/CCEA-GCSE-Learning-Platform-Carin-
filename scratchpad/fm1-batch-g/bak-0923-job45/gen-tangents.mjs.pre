  {
    type: "callout",
    kind: "examiner",
    title: "Summer 2025, Unit 1, Question 13",
    md: `A frequent slip was solving ${M("\\frac{dy}{dx} = 0")} instead of setting the derivative equal to the gradient the question stated; the report puts it down to habit. Read the question for the number ${M("\\frac{dy}{dx}")} must equal.`,
    source: src("2025-summer", 13),
  },
  {
    type: "video",
    videoId: "fPElVHyk_XI",
