const MWs = (n, marks, forText, extra = {}) => ({ id: `MW${n}`, code: "MW", marks, for: forText, ...extra });
const Ws = (n, marks, forText, extra = {}) => ({ id: `W${n}`, code: "W", marks, for: forText, ...extra });
const Ms = (n, marks, forText, extra = {}) => ({ id: `M${n}`, code: "M", marks, for: forText, ...extra });

const we01 = {
  id: id("we", "01"),
  topic: TOPIC,
  specRefs: SPEC,
  paper: PAPER,
  stem: `A curve has the equation ${M(latex(K.we1, { lhs: "y" }))}\nFind the equation of the tangent to this curve at the point where ${M("x = 4")}.`,
  figure: dataFigure(we1Svg, "A parabola with its tangent drawn as a dashed line touching at the point (4, 3), labelled with the tangent's equation."),
  steps: [
    {
      n: 1,
      working: `Differentiate: ${M(latex(deriv(K.we1), { lhs: "\\frac{dy}{dx}" }))}.`,
      decision: "This line is the first mark and it is available before anything can go wrong. Write it even if the rest of the question defeats you.",
      earns: ["MW1"],
    },
    {
      n: 2,
      working: `Substitute ${M("x = 4")}: ${M(`2(4) - 6 = ${fplain(T.we1.m)}`)}. The tangent's gradient is ${M(fplain(T.we1.m))}.`,
      decision: "The derivative is a rule; this turns it into the one number the straight line needs.",
      whyMenu: {
        options: ["Because the tangent has the curve's gradient at that point", "Because 4 is the gradient", "Because the tangent passes through the origin"],
        correct: 0,
        explain: "A tangent travels in the direction the curve is going, so at the point of contact the two gradients are the same number.",
      },
      earns: ["M1"],
    },
    {
      n: 3,
      working: `Find the point: substituting ${M("x = 4")} into the **curve** gives ${M(`16 - 24 + 11 = ${fplain(T.we1.y0)}`)}, so the point is ${M(pointLatex(fr(4), T.we1.y0))}.`,
      decision: "The height comes from the curve. Substituting into the derivative here would hand you the gradient a second time and leave the line unplaced.",
      earns: ["W1"],
    },
    {
      n: 4,
      working: `Put the gradient and the point into ${M("y - y_{1} = m(x - x_{1})")}: ${M(`y - ${fplain(T.we1.y0)} = ${fplain(T.we1.m)}(x - 4)`)}.`,
      decision: "Writing the formula out before substituting keeps the signs of the point where they belong, which is where the constant usually goes wrong.",
      earns: ["M2"],
    },
    {
      n: 5,
      working: `Tidy: ${M(`y - ${fplain(T.we1.y0)} = ${fplain(T.we1.m)}x - 8`)}, so ${M(lineLatex(T.we1.line))}.`,
      decision: "Leave it as y = mx + c unless the question asks for another form. Check the point: putting x = 4 into the tangent gives 3, which is the height you found.",
      earns: ["W2"],
    },
  ],
  finalAnswer: `$${lineLatex(T.we1.line)}$`,
  twin: {
    stem: `Find the equation of the tangent to ${M(latex(K.we1Twin, { lhs: "y" }))} at the point where ${M("x = 1")}.`,
    answer: ansLine(T.we1Twin.line),
  },
  faded: [
    { showSteps: 2, studentSupplies: [3, 4, 5] },
    { showSteps: 1, studentSupplies: [2, 3, 4, 5] },
  ],
  verification: `ver.${id("we", "01")}`,
  version: 1,
};

const we02 = {
  id: id("we", "02"),
  topic: TOPIC,
  specRefs: SPEC,
  paper: PAPER,
  stem: `A curve has the equation ${M(latex(K.we2, { lhs: "y" }))}\nFind the equation of the normal to this curve at the point where ${M("x = 1")}.`,
  figure: dataFigure(we2Svg, "The curve y = 2x minus 3 over x with its normal at the point (1, minus 1) drawn as a dashed line."),
  steps: [
    {
      n: 1,
      working: `Rewrite the fraction and differentiate: ${M("y = 2x - 3x^{-1}")}, so ${M(latex(deriv(K.we2), { lhs: "\\frac{dy}{dx}" }))}.`,
      decision: "The negative power has to come up before the rule can reach it, and multiplying -3 by -1 makes that term positive.",
      earns: ["MW1"],
    },
    {
      n: 2,
      working: `At ${M("x = 1")}: ${M(`2 + 3 = ${fplain(T.we2.m)}`)}, so the tangent's gradient is ${M(fplain(T.we2.m))}.`,
      decision: "One substitution into the derivative. This is the tangent's gradient, not the normal's, and mixing the two up here costs three marks downstream.",
      earns: ["M1"],
    },
    {
      n: 3,
      working: `Normal gradient: ${M(`-\\frac{1}{m} = -\\frac{1}{${fplain(T.we2.m)}} = ${flatex(T.we2.g)}`)}.`,
      decision: "Turn the number over, then change its sign. CCEA gives a mark for this step on its own, even when the gradient before it was wrong.",
      whyMenu: {
        options: ["Because perpendicular gradients multiply to -1", "Because the normal is always negative", "Because the curve is falling there"],
        correct: 0,
        explain: "Two perpendicular lines have gradients whose product is -1, which is exactly what taking the negative reciprocal arranges.",
      },
      earns: ["W1"],
    },
    {
      n: 4,
      working: `The point: ${M(`2 - 3 = ${fplain(T.we2.y0)}`)}, from the curve, so the normal passes through ${M(pointLatex(fr(1), T.we2.y0))}.`,
      decision: "The tangent and the normal share this point, so it is found once and used twice.",
      earns: ["M2"],
    },
    {
      n: 5,
      working: `Substitute: ${M(`${fplain(T.we2.y0)} = ${flatex(T.we2.g)}(1) + c`)}, so ${M(`c = ${flatex(T.we2.line.c)}`)} and ${M(lineLatex(T.we2.line))}.`,
      decision: "Fractions in the constant are normal on this paper. Leaving the answer as a decimal is fine, and so is clearing the fraction if the question asks for whole numbers.",
      earns: ["W2"],
    },
  ],
  finalAnswer: `$${lineLatex(T.we2.line)}$`,
  twin: {
    stem: `Find the equation of the normal to ${M(latex(K.we2Twin, { lhs: "y" }))} at the point where ${M("x = 2")}.`,
    answer: ansLine(T.we2Twin.line),
  },
  faded: [
    { showSteps: 2, studentSupplies: [3, 4, 5] },
    { showSteps: 1, studentSupplies: [2, 3, 4, 5] },
  ],
  verification: `ver.${id("we", "02")}`,
  version: 1,
};

const we03 = {
  id: id("we", "03"),
  topic: TOPIC,
  specRefs: SPEC,
  paper: PAPER,
  stem: `The tangent to ${M(latex(K.we3, { lhs: "y" }))} at the point where ${M("x = 1")} meets that curve a second time.\nFind the coordinates of that second point.`,
  figure: dataFigure(meetPlainSvg, "A cubic curve with a dashed tangent touching it on the right and crossing it again on the left, the two places marked but not named."),
  steps: [
    {
      n: 1,
      working: `The tangent first: ${M(latex(deriv(K.we3), { lhs: "\\frac{dy}{dx}" }))}, so at ${M("x = 1")} the gradient is ${M(fplain(T.we3.m))} and the point is ${M(pointLatex(fr(1), T.we3.y0))}.`,
      decision: "Nothing can be solved until the tangent has an equation, so the first half of this question is the ordinary four-step method.",
      earns: ["MW1"],
    },
    {
      n: 2,
      working: `So the tangent is ${M(lineLatex(T.we3.line))}.`,
      decision: "Check it against the point: -9 times 1, take away 2, gives -11, which is the height you found.",
      earns: ["W1"],
    },
    {
      n: 3,
      working: `Set the curve equal to the tangent: ${M(`${latex(K.we3)} = ${lineLatex(T.we3.line).replace("y = ", "")}`)}.`,
      decision: "Where a line meets a curve, their y values agree. Every crossing is a solution of this one equation, the touching point included.",
      earns: ["M1"],
    },
    {
      n: 4,
      working: `Collect everything on one side: ${M("x^{3} - 3x + 2 = 0")}.`,
      decision: "Bring it to zero before factorising. The cubic is about to show you the answer for free.",
      earns: ["W2"],
    },
    {
      n: 5,
      working: `${M("x = 1")} is a repeated root because the line is a tangent there, so ${M("(x - 1)^{2}")} is a factor: ${M("(x - 1)^{2}(x + 2) = 0")}.`,
      decision: "Touching means the root appears twice. Knowing that turns a cubic you would have to solve into one you can simply read.",
      whyMenu: {
        options: ["Because a tangent touches rather than crosses at that point", "Because cubics always have repeated roots", "Because x = 1 was in the question"],
        correct: 0,
        explain: "A crossing gives a single root; touching gives a double one. That is what lets you factor out the point of contact twice.",
      },
      earns: ["M2"],
    },
    {
      n: 6,
      working: `The remaining root is ${M(`x = ${fplain(MEET.we3.x)}`)}, and the curve gives ${M(`y = ${fplain(MEET.we3.y)}`)}. So the second point is ${M(pointLatex(MEET.we3.x, MEET.we3.y))}.`,
      decision: "Find the height from the curve or from the tangent: they agree here, because this is a point both pass through. The curve is the safer habit.",
      earns: ["W3"],
    },
  ],
  finalAnswer: `$${pointLatex(MEET.we3.x, MEET.we3.y)}$`,
  twin: {
    stem: `The tangent to ${M(latex(K.we3Twin, { lhs: "y" }))} at the point where ${M("x = 2")} meets that curve a second time. Find the coordinates of that second point.`,
    answer: ansPoint(MEET.we3Twin),
  },
  faded: [
    { showSteps: 3, studentSupplies: [4, 5, 6] },
    { showSteps: 2, studentSupplies: [3, 4, 5, 6] },
  ],
  verification: `ver.${id("we", "03")}`,
  version: 1,
};

/** Depth pass, 23 Sep: the variant that had no worked example, a stated gradient (the Summer 2025 Q13(i) shape). */
const we04 = {
  id: id("we", "04"),
  topic: TOPIC,
  specRefs: SPEC,
  paper: PAPER,
  stem: `A curve has the equation ${M(latex(K4, { lhs: "y" }))}\nThe tangent to this curve at the point ${M("P")} has gradient ${M(fplain(WE4_M))}.\nFind the equation of that tangent.`,
  steps: [
    {
      n: 1,
      working: `Differentiate: ${M(latex(deriv(K4), { lhs: "\\frac{dy}{dx}" }))}.`,
      decision: "The gradient rule comes first, as always; the question has only moved the unknown from m to x.",
      earns: ["MW1"],
    },
    {
      n: 2,
      working: `Set it equal to the stated gradient: ${M(`${latex(deriv(K4))} = ${fplain(WE4_M)}`)}.`,
      decision: "The gradient at P is given, so dy/dx equals that number there. Writing = 0 here is the slip the Summer 2025 report puts down to habit.",
      whyMenu: {
        options: [
          `Because the tangent's gradient at ${M("P")} is ${M("\\frac{dy}{dx}")} there, and it is given as ${M(fplain(WE4_M))}`,
          "Because every tangent to this curve has that gradient",
          `Because ${M("\\frac{dy}{dx} = 0")} at every point of contact`,
        ],
        correct: 0,
        explain: "The derivative gives the gradient at each x. Setting it equal to the stated gradient picks out the x where the tangent has that gradient.",
      },
      earns: ["M1"],
    },
    {
      n: 3,
      working: `Solve: ${M(`x = ${fplain(WE4_T.x0)}`)}.`,
      decision: "A linear derivative gives one point; a quadratic one can give two, and then the question tells you which.",
      earns: ["W1"],
    },
    {
      n: 4,
      working: `Find the height from the curve: ${M(`y = ${fplain(WE4_T.y0)}`)}, so ${M("P")} is ${M(pointLatex(WE4_T.x0, WE4_T.y0))}.`,
      decision: "The point sits on the curve, so its y comes from the curve, not from the gradient.",
      earns: ["W2"],
    },
    {
      n: 5,
      working: `The tangent: ${M(`y ${WE4_T.y0.n < 0 ? "+" : "-"} ${fplain(WE4_T.y0.n < 0 ? fneg(WE4_T.y0) : WE4_T.y0)} = ${fplain(WE4_M)}(x - ${fplain(WE4_T.x0)})`)}, which is ${M(lineLatex(WE4_T.line))}.`,
      decision: `Check it at P: ${fplain(WE4_M)} times ${fplain(WE4_T.x0)}, then the constant, gives ${fplain(WE4_T.y0)}, the height you found.`,
      earns: ["W3"],
    },
  ],
  finalAnswer: `$${lineLatex(WE4_T.line)}$`,
  twin: {
    stem: `A curve has the equation ${M(latex(K4T, { lhs: "y" }))} The tangent to this curve at the point ${M("Q")} has gradient ${M(fplain(WE4T_M))}. Find the equation of that tangent.`,
    answer: ansLine(WE4T_T.line),
  },
  // backward fading: the last step first, then the last two
  faded: [
    { showSteps: 4, studentSupplies: [5] },
    { showSteps: 3, studentSupplies: [4, 5] },
  ],
  verification: `ver.${id("we", "04")}`,
  version: 1,
};

