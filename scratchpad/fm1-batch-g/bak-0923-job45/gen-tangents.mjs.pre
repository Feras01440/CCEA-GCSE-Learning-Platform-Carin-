      ],
      secondsExpected: 30,
      confidence: true,
      hypercorrectionQueue: true,
    },
  ],
};

// ---------------------------------------------------------------------------
// questions
// ---------------------------------------------------------------------------

const single = (n, o) => ({
  id: id("q", n),
  topic: TOPIC,
  specRefs: SPEC,
  tier: "untiered",
  paper: PAPER,
  style: o.style ?? "practice",
  difficulty: o.difficulty ?? 3,
  ao: o.ao ?? ["AO1", "AO2"],
  commandWords: o.commandWords ?? ["Find"],
  emphasis: o.emphasis ?? [],
  context: { setting: o.setting, original: true },
  figures: o.figures ?? [],
  parts: [{ id: "main", stem: o.stem, marks: o.marks, answer: o.answer, scheme: o.scheme, hints: o.hints, workedSolution: o.worked, commonErrors: o.errors, requiresWorking: true }],
  totalMarks: o.marks,
  timeAllowanceSec: timeFor(o.marks),
  skeleton: `(main)${o.verb ?? "find"}${o.marks}`,
  examinerSources: o.sources ?? [],
  ...(o.program ? { solutionProgram: o.program } : {}),
  verification: `ver.${id("q", n)}`,
  version: 1,
});

const tangentScheme = (t, { normalStep = false } = {}) => {
  const s = [
    MWs(1, 1, `${M(latex(deriv(normalStep ? t.curve : t.curve), { lhs: "\\frac{dy}{dx}" }))}`),
  ];
  return s;
};

const questions = [];

questions.push(
  single("0001", {
    difficulty: 2,
    setting: "The tangent gradient on its own, as the opening part of a longer question",
    stem: `A curve has the equation ${M(latex(K.p1, { lhs: "y" }))}\nFind the gradient of the tangent to this curve at the point where ${M("x = 1")}.`,
    marks: 2,
    answer: ansNum(T.p1.m),
    scheme: [MWs(1, 1, `${M(latex(deriv(K.p1), { lhs: "\\frac{dy}{dx}" }))}`), Ws(1, 1, `${M(fplain(T.p1.m))}`, { ft: true })],
    hints: ["Differentiate first.", "The tangent's gradient is the curve's gradient at the point of contact."],
    worked: `${M(latex(deriv(K.p1), { lhs: "\\frac{dy}{dx}" }))}.\nAt ${M("x = 1")}: ${M(`2(1) + 5 = ${fplain(T.p1.m)}`)}.\nSo the tangent has gradient ${M(fplain(T.p1.m))}.`,
    errors: [
      errNum("fm.calc.normal-gradient-not-reciprocated", perp(T.p1.m), "That is the gradient of the normal. The tangent's gradient is the derivative itself, with no reciprocal and no sign change.", 1, src("2019-summer", 11)),
      errNum("fm.calc.gradient-read-as-coefficient", fr(5), "That is the coefficient of $x$ in the curve, read as though the graph were a straight line. A curve's gradient always comes from $\\frac{dy}{dx}$.", 0, src("2019-summer", 11)),
    ],
    sources: [src("2019-summer", 11)],
    program: `d/dx ${plain(K.p1)} = ${plain(deriv(K.p1))}; at x = 1 -> ${fplain(T.p1.m)}`,
  }),
);

questions.push(
  single("0002", {
    difficulty: 2,
    setting: "The simplest possible tangent, so the four steps can be seen whole",
    emphasis: ["in the form $y = mx + c$"],
    stem: `A curve has the equation ${M(latex(K.p2, { lhs: "y" }))}\nFind the equation of the tangent to this curve at the point where ${M("x = 3")}.\nGive your answer in the form ${M("y = mx + c")}.`,
    marks: 3,
    answer: ansLine(T.p2.line, true),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p2), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p2.m)}`)}`),
      Ms(1, 1, `the point ${M(pointLatex(fr(3), T.p2.y0))} and a substitution into ${M("y - y_{1} = m(x - x_{1})")}`),
      Ws(1, 1, `${M(lineLatex(T.p2.line))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["Differentiate, then substitute 3.", "Find the height from the curve.", "Then use $y - y_{1} = m(x - x_{1})$."],
    worked: `${M(latex(deriv(K.p2), { lhs: "\\frac{dy}{dx}" }))}, so at ${M("x = 3")} the gradient is ${M(fplain(T.p2.m))}.\nFrom the curve, ${M(`y = ${fplain(T.p2.y0)}`)}.\n${M(`y - ${fplain(T.p2.y0)} = ${fplain(T.p2.m)}(x - 3)`)}, so ${M(lineLatex(T.p2.line))}.`,
    errors: [
      constantSlipError(T.p2.m, fr(3), T.p2.y0, "The gradient and the point are both right, so most of the method is secure.", 2, src("2023-summer", 10)),
      errAlg("fm.calc.y-from-line-not-curve", lineLatex(lineThrough(T.p2.m, fr(3), T.p2.m)), "The gradient is right. The height of the point was taken as the gradient rather than from the curve; substituting 3 into $y = x^{2}$ gives 9.", 1, src("2024-summer", 9)),
    ],
    sources: [src("2023-summer", 10)],
    program: `tangent to ${plain(K.p2)} at x = 3 -> ${linePlain(T.p2.line)}`,
  }),
);

questions.push(
  single("0003", {
    difficulty: 3,
    setting: "A tangent whose constant turns out to be zero, so the answer looks unusual but is right",
    stem: `A curve has the equation ${M(latex(K.p3, { lhs: "y" }))}\nFind the equation of the tangent to this curve at the point where ${M("x = 2")}.`,
    marks: 3,
    answer: ansLine(T.p3.line),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p3), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p3.m)}`)}`),
      Ms(1, 1, `the point ${M(pointLatex(fr(2), T.p3.y0))}`),
      Ws(1, 1, `${M(lineLatex(T.p3.line))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["The gradient at $x = 2$ is $2(2) - 2$.", "The height is $4 - 4 + 4$.", "A constant of zero is a perfectly good answer."],
    worked: `${M(latex(deriv(K.p3), { lhs: "\\frac{dy}{dx}" }))}, so ${M(`m = ${fplain(T.p3.m)}`)} at ${M("x = 2")}.\nFrom the curve, ${M(`y = ${fplain(T.p3.y0)}`)}.\n${M(`y - ${fplain(T.p3.y0)} = ${fplain(T.p3.m)}(x - 2)`)} gives ${M(lineLatex(T.p3.line))}, a line through the origin.`,
    errors: [
      constantSlipError(T.p3.m, fr(2), T.p3.y0, "The gradient and the point are right.", 2, src("2023-summer", 10)),
      errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(perp(T.p3.m), fr(2), T.p3.y0)), "That is the normal at the same point. The question asked for the tangent, which keeps the gradient the derivative gave you.", 1, src("2019-summer", 11)),
    ],
    sources: [src("2022-summer", 8)],
    program: `tangent to ${plain(K.p3)} at x = 2 -> ${linePlain(T.p3.line)}`,
  }),
);

questions.push(
  single("0004", {
    difficulty: 2,
    verb: "write",
    commandWords: ["Write down"],
    setting: "The negative reciprocal on its own, which CCEA credits as a step of its own",
    stem: "The tangent to a curve at the point $A$ has gradient $4$.\nWrite down the gradient of the normal to the curve at $A$.",
    marks: 1,
    answer: ansNum(perp(fr(4))),
    scheme: [Ws(1, 1, `${M(flatex(perp(fr(4))))} or ${M(fplain(perp(fr(4))))}`)],
    hints: ["Turn the 4 over, then change the sign."],
    worked: `Perpendicular gradients multiply to ${M("-1")}, so the normal's gradient is ${M(`-\\frac{1}{4} = ${fplain(perp(fr(4)))}`)}.`,
    errors: [
      errNum("fm.calc.normal-gradient-not-reciprocated", normalRoutes.notReciprocated(fr(4)), "The sign changed but the number never turned over. Check with the product: $4 \\times -4$ is $-16$, and it needs to be $-1$.", 0, src("2019-summer", 11)),
      errNum("fm.calc.normal-sign-not-flipped", normalRoutes.signNotFlipped(fr(4)), "The number turned over but the sign stayed positive. $4 \\times \\frac{1}{4}$ is $1$, and a perpendicular pair multiplies to $-1$.", 0, src("2024-summer", 9)),
    ],
    sources: [src("2019-summer", 11)],
    program: `perp(4) = ${fplain(perp(fr(4)))}`,
  }),
);

questions.push(
  single("0005", {
    difficulty: 3,
    setting: "A normal gradient reached in two steps, the shape CCEA uses as a part (i)",
    stem: `A curve has the equation ${M(latex(K.p5, { lhs: "y" }))}\nFind the gradient of the normal to this curve at the point where ${M("x = 1")}.`,
    marks: 2,
    answer: ansNum(T.p5.g),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p5), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p5.m)}`)}`),
      Ws(1, 1, `${M(flatex(T.p5.g))}`, { ft: true }),
    ],
    hints: ["Differentiate and substitute 1 to get the tangent's gradient.", "Then take the negative reciprocal."],
    worked: `${M(latex(deriv(K.p5), { lhs: "\\frac{dy}{dx}" }))}, so at ${M("x = 1")} the tangent's gradient is ${M(fplain(T.p5.m))}.\nThe normal's gradient is ${M(`-\\frac{1}{m} = -\\frac{1}{${fplain(T.p5.m)}} = ${flatex(T.p5.g)}`)}.`,
    errors: [
      errNum("fm.calc.normal-gradient-not-reciprocated", normalRoutes.notReciprocated(T.p5.m), "The tangent gradient is right, so the method mark stands. The sign changed but the number never turned over.", 1, src("2019-summer", 11)),
      errNum("fm.calc.normal-sign-not-flipped", normalRoutes.signNotFlipped(T.p5.m), "The tangent gradient is right and the number turned over. The sign still has to change, because the product must be $-1$.", 1, src("2024-summer", 9)),
      errNum("fm.calc.normal-gradient-not-reciprocated", T.p5.m, "That is the tangent's gradient. The normal is perpendicular to the tangent, so it needs the negative reciprocal.", 1, src("2019-summer", 11)),
    ],
    sources: [src("2019-summer", 11)],
    program: `normal gradient of ${plain(K.p5)} at x = 1 -> ${fplain(T.p5.g)}`,
  }),
);

questions.push(
  single("0006", {
    difficulty: 3,
    setting: "A full normal on a quadratic, the four steps plus the reciprocal",
    stem: `A curve has the equation ${M(latex(K.p6, { lhs: "y" }))}\nFind the equation of the normal to this curve at the point where ${M("x = 5")}.`,
    marks: 4,
    answer: ansLine(T.p6.line),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p6), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p6.m)}`)}`),
      Ws(1, 1, `normal gradient ${M(flatex(T.p6.g))}`, { ft: true }),
      Ms(1, 1, `the point ${M(pointLatex(fr(5), T.p6.y0))} substituted into the line formula`),
      Ws(2, 1, `${M(lineLatex(T.p6.line))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["Differentiate and substitute 5.", "Take the negative reciprocal for the normal.", "Find the height from the curve, then build the line."],
    worked: `${M(latex(deriv(K.p6), { lhs: "\\frac{dy}{dx}" }))}, so ${M(`m = ${fplain(T.p6.m)}`)} at ${M("x = 5")}.\nThe normal's gradient is ${M(flatex(T.p6.g))}.\nFrom the curve, ${M(`y = 25 - 40 + 3 = ${fplain(T.p6.y0)}`)}.\n${M(`${fplain(T.p6.y0)} = ${flatex(T.p6.g)}(5) + c`)} gives ${M(`c = ${flatex(T.p6.line.c)}`)}, so ${M(lineLatex(T.p6.line))}.`,
    errors: [
      errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(normalRoutes.notReciprocated(T.p6.m), fr(5), T.p6.y0)), "The tangent gradient and the point are both right, so two marks stand. The normal's gradient needs the number turned over as well as the sign changed.", 2, src("2019-summer", 11)),
      errAlg("fm.calc.normal-sign-not-flipped", lineLatex(lineThrough(normalRoutes.signNotFlipped(T.p6.m), fr(5), T.p6.y0)), "The reciprocal is there and the point is right. The sign still has to change, because perpendicular gradients multiply to $-1$.", 2, src("2024-summer", 9)),
      constantSlipError(T.p6.g, fr(5), T.p6.y0, "Gradient, reciprocal and point are all right, so three marks stand.", 3, src("2023-summer", 10)),
    ],
    sources: [src("2023-summer", 10)],
    program: `normal to ${plain(K.p6)} at x = 5 -> ${linePlain(T.p6.line)}`,
  }),
);

questions.push(
  single("0007", {
    difficulty: 3,
    setting: "A normal on a cubic, where the derivative is itself a quadratic",
    stem: `A curve has the equation ${M(latex(K.p7, { lhs: "y" }))}\nFind the equation of the normal to this curve at the point where ${M("x = 1")}.`,
    marks: 4,
    answer: ansLine(T.p7.line),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p7), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p7.m)}`)}`),
      Ws(1, 1, `normal gradient ${M(flatex(T.p7.g))}`, { ft: true }),
      Ms(1, 1, `the point ${M(pointLatex(fr(1), T.p7.y0))} substituted into the line formula`),
      Ws(2, 1, `${M(lineLatex(T.p7.line))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["The derivative of $x^{3}$ is $3x^{2}$.", "Substitute 1 for the tangent gradient, then take the negative reciprocal.", "The height comes from the curve."],
    worked: `${M(latex(deriv(K.p7), { lhs: "\\frac{dy}{dx}" }))}, so ${M(`m = 3 + 2 = ${fplain(T.p7.m)}`)}.\nNormal gradient ${M(flatex(T.p7.g))}.\nFrom the curve, ${M(`y = 1 + 2 = ${fplain(T.p7.y0)}`)}.\n${M(`${fplain(T.p7.y0)} = ${flatex(T.p7.g)}(1) + c`)} gives ${M(`c = ${flatex(T.p7.line.c)}`)}, so ${M(lineLatex(T.p7.line))}.`,
    errors: [
      errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(normalRoutes.notReciprocated(T.p7.m), fr(1), T.p7.y0)), "The tangent gradient and the point are right. The normal's gradient needs the reciprocal as well as the sign change.", 2, src("2019-summer", 11)),
      errAlg("fm.calc.normal-sign-not-flipped", lineLatex(lineThrough(normalRoutes.signNotFlipped(T.p7.m), fr(1), T.p7.y0)), "The reciprocal is there. The sign still has to change for the two gradients to multiply to $-1$.", 2, src("2024-summer", 9)),
      constantSlipError(T.p7.g, fr(1), T.p7.y0, "Everything up to the last line is right.", 3, src("2023-summer", 10)),
    ],
    sources: [src("2023-summer", 10)],
    program: `normal to ${plain(K.p7)} at x = 1 -> ${linePlain(T.p7.line)}`,
  }),
);

questions.push(
  single("0008", {
    difficulty: 4,
    setting: "A tangent to a curve written as a fraction, the shape the 2019 report singled out",
    stem: `A curve has the equation ${M(latex(K.p8, { lhs: "y" }))}\nFind the equation of the tangent to this curve at the point where ${M("x = 2")}.`,
    marks: 4,
    answer: ansLine(T.p8.line),
    scheme: [
      Ms(1, 1, `writing the curve as ${M("y = 8x^{-1}")}`),
      MWs(1, 1, `${M(latex(deriv(K.p8), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p8.m)}`)}`, { dependsOn: ["M1"] }),
      Ms(2, 1, `the point ${M(pointLatex(fr(2), T.p8.y0))}`),
      Ws(1, 1, `${M(lineLatex(T.p8.line))}`, { dependsOn: ["M2"], ft: true }),
    ],
    hints: ["Rewrite $\\frac{8}{x}$ as $8x^{-1}$ first.", "The derivative is $-8x^{-2}$.", "The height at $x = 2$ is $\\frac{8}{2}$."],
    worked: `Rewrite: ${M(latex(K.p8, { lhs: "y", style: "index" }))}, so ${M(latex(deriv(K.p8), { lhs: "\\frac{dy}{dx}" }))}.\nAt ${M("x = 2")}: ${M(`m = -\\frac{8}{4} = ${fplain(T.p8.m)}`)}.\nFrom the curve, ${M(`y = ${fplain(T.p8.y0)}`)}.\n${M(`y - ${fplain(T.p8.y0)} = ${fplain(T.p8.m)}(x - 2)`)} gives ${M(lineLatex(T.p8.line))}.`,
    errors: [
      errAlg("fm.calc.negative-power-differentiation", lineLatex(lineThrough(at(route("negPowerSignKept", K.p8), fr(2)), fr(2), T.p8.y0)), "The point is right and the index stepped down correctly. Multiplying 8 by the power $-1$ makes the gradient negative, so the tangent slopes down.", 2, src("2019-summer", 11)),
      errAlg("fm.calc.index-moved-to-numerator", lineLatex(lineThrough(at(route("indexMovedUp", K.p8), fr(2)), fr(2), T.p8.y0)), "The curve was lifted to the top line as $8x$ before it was differentiated. Crossing the line changes the sign of the index.", 1, src("2024-summer", 1)),
      constantSlipError(T.p8.m, fr(2), T.p8.y0, "Gradient and point are both right.", 3, src("2023-summer", 10)),
    ],
    sources: [src("2019-summer", 11)],
    program: `tangent to ${plain(K.p8)} at x = 2 -> ${linePlain(T.p8.line)}`,
  }),
);

questions.push(
  single("0009", {
    difficulty: 4,
    setting: "A normal to a curve with a negative power, the 2019 discriminator rebuilt",
    stem: `A curve has the equation ${M(latex(K.p9, { lhs: "y" }))}\nFind the equation of the normal to this curve at the point where ${M("x = 2")}.`,
    marks: 4,
    answer: ansLine(T.p9.line),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p9), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p9.m)}`)}`),
      Ws(1, 1, `normal gradient ${M(flatex(T.p9.g))}`, { ft: true }),
      Ms(1, 1, `the point ${M(pointLatex(fr(2), T.p9.y0))}`),
      Ws(2, 1, `${M(lineLatex(T.p9.line))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["Rewrite the fraction as $-12x^{-1}$ before differentiating.", "Two negatives make the second term of the derivative positive.", "Then the negative reciprocal, then the point."],
    worked: `Rewrite: ${M(latex(K.p9, { lhs: "y", style: "index" }))}, so ${M(latex(deriv(K.p9), { lhs: "\\frac{dy}{dx}" }))}.\nAt ${M("x = 2")}: ${M(`2 + 3 = ${fplain(T.p9.m)}`)}, so the normal's gradient is ${M(flatex(T.p9.g))}.\nFrom the curve, ${M(`4 - 6 = ${fplain(T.p9.y0)}`)}.\n${M(`${fplain(T.p9.y0)} = ${flatex(T.p9.g)}(2) + c`)} gives ${M(`c = ${flatex(T.p9.line.c)}`)}, so ${M(lineLatex(T.p9.line))}.`,
    errors: [
      errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(normalRoutes.notReciprocated(T.p9.m), fr(2), T.p9.y0)), "The derivative, the substitution and the point are all right. The normal's gradient needs the number turned over as well as the sign changed.", 2, src("2019-summer", 11)),
      errAlg("fm.calc.negative-power-differentiation", lineLatex(lineThrough(perp(at(route("negPowerSignKept", K.p9), fr(2))), fr(2), T.p9.y0)), "The reciprocal and the point are right. In the derivative, $-12$ multiplied by the power $-1$ gives $+12$, so that term is added.", 1, src("2019-summer", 11)),
      constantSlipError(T.p9.g, fr(2), T.p9.y0, "Everything up to the last line is right.", 3, src("2023-summer", 10)),
    ],
    sources: [src("2019-summer", 11)],
    program: `normal to ${plain(K.p9)} at x = 2 -> ${linePlain(T.p9.line)}`,
  }),
);

questions.push(
  single("0010", {
    difficulty: 3,
    setting: "A stated tangent gradient, so the derivative becomes an equation",
    stem: `A curve has the equation ${M(latex(K.p10, { lhs: "y" }))}\nAt the point ${M("B")} on this curve the tangent has gradient ${M("5")}.\nFind the coordinates of ${M("B")}.`,
    marks: 3,
    answer: ansPoint(P10_P),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p10), { lhs: "\\frac{dy}{dx}" }))}`),
      Ms(1, 1, `setting ${M(`${latex(deriv(K.p10))} = 5`)}`),
      Ws(1, 1, `${M(pointLatex(P10_P.x, P10_P.y))} as a coordinate pair`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["The gradient is given, so it belongs on the right of an equation.", "Solve for $x$.", "Then find $y$ from the curve and write the pair."],
    worked: `${M(latex(deriv(K.p10), { lhs: "\\frac{dy}{dx}" }))}.\nSet it equal to the given gradient: ${M("2x - 3 = 5")}, so ${M(`x = ${fplain(P10_P.x)}`)}.\nFrom the curve, ${M(`y = 16 - 12 + 4 = ${fplain(P10_P.y)}`)}.\nSo ${M("B")} is ${M(pointLatex(P10_P.x, P10_P.y))}.`,
    errors: [
      errAlg("fm.calc.default-to-derivative-zero", pointLatex(P10_ZERO.x, P10_ZERO.y), "That is the point where the gradient is zero. The question stated a gradient of 5, so the equation to solve is $\\frac{dy}{dx} = 5$.", 1, src("2025-summer", 13)),
      errAlg("fm.calc.stationary-y-from-derivative", pointLatex(P10_P.x, fr(5)), "The $x$-coordinate is right, so two of the three marks stand. The second coordinate is the height of the curve there, not the gradient you were given.", 2, src("2025-summer", 11)),
    ],
    sources: [src("2025-summer", 13)],
    program: `solve ${plain(deriv(K.p10))} = 5 -> ${pointPlain(P10_P.x, P10_P.y)}`,
  }),
);

questions.push(
  single("0011", {
    difficulty: 4,
    setting: "A stated normal gradient, so the negative reciprocal has to be taken backwards",
    stem: `A curve has the equation ${M(latex(K.p11, { lhs: "y" }))}\nAt the point ${M("A")} on this curve the normal has gradient ${M(flatex(P11_G))}.\nFind the coordinates of ${M("A")}.`,
    marks: 3,
    answer: ansPoint(P11_P),
    scheme: [
      Ws(1, 1, `the tangent gradient ${M(fplain(P11_M))} from the negative reciprocal`),
      Ms(1, 1, `setting ${M(`${latex(deriv(K.p11))} = ${fplain(P11_M)}`)}`),
      Ws(2, 1, `${M(pointLatex(P11_P.x, P11_P.y))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["The relationship works both ways: turn the normal's gradient over and change its sign.", "That gives $\\frac{dy}{dx}$ at $A$.", "Solve, then find $y$ from the curve."],
    worked: `The normal has gradient ${M(flatex(P11_G))}, so the tangent has gradient ${M(fplain(P11_M))}.\n${M(latex(deriv(K.p11), { lhs: "\\frac{dy}{dx}" }))}, so ${M(`4x - 1 = ${fplain(P11_M)}`)} and ${M(`x = ${fplain(P11_P.x)}`)}.\nFrom the curve, ${M(P11_SUBST)}.\nSo ${M("A")} is ${M(pointLatex(P11_P.x, P11_P.y))}.`,
    errors: [
      errAlg("fm.calc.normal-gradient-not-reciprocated", pointLatex(P11_WRONG.x, P11_WRONG.y), "The method is right, so the structure of the answer is sound. The tangent gradient was taken as the normal's with the sign changed; it also has to be turned over.", 1, src("2024-summer", 9)),
      errAlg("fm.calc.normal-sign-not-flipped", pointLatex(P11_FLIP.x, P11_FLIP.y), "The reciprocal was taken but the sign was left alone. The two gradients must multiply to $-1$.", 1, src("2024-summer", 9)),
      errAlg("fm.calc.stationary-y-from-derivative", pointLatex(P11_P.x, P11_M), "The $x$-coordinate is right. The second coordinate comes from substituting into the curve, not from the gradient.", 2, src("2025-summer", 11)),
    ],
    sources: [src("2024-summer", 9)],
    program: `perp(${fplain(P11_G)}) = ${fplain(P11_M)}; solve ${plain(deriv(K.p11))} = ${fplain(P11_M)} -> ${pointPlain(P11_P.x, P11_P.y)}`,
  }),
);

questions.push(
  single("0012", {
    difficulty: 4,
    setting: "A tangent to a cubic that crosses the curve a second time",
    stem: `The tangent to ${M(latex(K.p12, { lhs: "y" }))} at the point where ${M("x = -1")} meets that curve a second time, at the point ${M("C")}.\nFind the coordinates of ${M("C")}.`,
    marks: 4,
    answer: ansPoint(MEET.p12),
    scheme: [
      MWs(1, 1, `${M(latex(deriv(K.p12), { lhs: "\\frac{dy}{dx}" }))} and ${M(`m = ${fplain(T.p12.m)}`)}`),
      Ws(1, 1, `the tangent ${M(lineLatex(T.p12.line))}`, { ft: true }),
      Ms(1, 1, `setting the curve equal to the tangent and collecting to zero`),
      Ws(2, 1, `${M(pointLatex(MEET.p12.x, MEET.p12.y))}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["Find the tangent first, in the usual four steps.", "Then set the curve equal to the tangent.", "$x = -1$ is a repeated root, so $(x + 1)^{2}$ is a factor."],
    worked: `${M(latex(deriv(K.p12), { lhs: "\\frac{dy}{dx}" }))}, so at ${M("x = -1")} the gradient is ${M(fplain(T.p12.m))} and the point is ${M(pointLatex(fr(-1), T.p12.y0))}.\nThe tangent is ${M(lineLatex(T.p12.line))}.\nSetting the curve equal to it: ${M("x^{3} - 3x - 2 = 0")}, and since the line touches at ${M("x = -1")} that root repeats: ${M("(x + 1)^{2}(x - 2) = 0")}.\nSo ${M(`x = ${fplain(MEET.p12.x)}`)} and ${M(`y = ${fplain(MEET.p12.y)}`)}, giving ${M(pointLatex(MEET.p12.x, MEET.p12.y))}.`,
    errors: [
      errAlg("fm.calc.default-to-derivative-zero", pointLatex(fr(-1), T.p12.y0), "That is the point the tangent touches at, which the question already gave you. The second point is the other root of the equation where the two graphs meet.", 2, src("2025-summer", 13)),
      errAlg("fm.calc.equate-line-and-curve-instead-of-differentiate", pointLatex(fr(2), fr(0)).replace(pointLatex(fr(2), fr(0)), lineLatex(T.p12.line)), "That is the equation of the tangent, and it is correct. The question asked where that tangent meets the curve again, so it has to be set equal to the curve and solved.", 2, src("2024-summer", 9)),
    ],
    sources: [src("2024-summer", 9)],
    program: `tangent to ${plain(K.p12)} at x = -1 -> ${linePlain(T.p12.line)}; meets again at ${pointPlain(MEET.p12.x, MEET.p12.y)}`,
  }),
);

// --- depth pass, 23 Sep: new rungs with new ids (the first rung, a difficulty-5 rung, and the horizontal tangent) ---

questions.push(
  single("0017", {
    difficulty: 5,
    setting: "A stated normal gradient that fixes an unknown coefficient: the 2022 and 2024 findings in one part",
    stem: `A curve has the equation ${M(`y = ax^{2} - ${Math.abs(Q17.b.n)}x`)}, where ${M("a")} is a constant.\nThe normal to this curve at the point where ${M(`x = ${fplain(Q17.x0)}`)} has gradient ${M(flatex(Q17.g))}.\nFind the value of ${M("a")}.`,
    marks: 3,
    answer: ansNum(Q17_A),
    scheme: [
      Ws(1, 1, `the tangent gradient ${M(fplain(Q17_M))}, the negative reciprocal of ${M(flatex(Q17.g))}`),
      Ms(1, 1, `${M(`\\frac{dy}{dx} = 2ax - ${Math.abs(Q17.b.n)}`)} set equal to ${M(fplain(Q17_M))} at ${M(`x = ${fplain(Q17.x0)}`)}`),
      Ws(2, 1, `${M(`a = ${fplain(Q17_A)}`)}`, { dependsOn: ["M1"], ft: true }),
    ],
    hints: ["Turn the normal's gradient into the tangent's first.", `Differentiate with the letter in place: $\\frac{dy}{dx} = 2ax - ${Math.abs(Q17.b.n)}$.`, "Substitute $x = 1$ and solve for $a$."],
    worked: `The normal has gradient ${M(flatex(Q17.g))}, so the tangent has gradient ${M(fplain(Q17_M))}.\n${M(`\\frac{dy}{dx} = 2ax - ${Math.abs(Q17.b.n)}`)}, which is ${M(`2a - ${Math.abs(Q17.b.n)}`)} at ${M(`x = ${fplain(Q17.x0)}`)}.\n${M(`2a - ${Math.abs(Q17.b.n)} = ${fplain(Q17_M)}`)}, so ${M(`a = ${fplain(Q17_A)}`)}.`,
    errors: [
      errNum("fm.calc.normal-sign-not-flipped", Q17_ROUTES.flip, `The normal's gradient was turned over but kept its sign, so the tangent's gradient came out as ${M(flatex(normalRoutes.signNotFlipped(Q17.g)))}. The two gradients must multiply to ${M("-1")}, so it is ${M(fplain(Q17_M))}.`, 1, src("2022-summer", 8)),
      errNum("fm.calc.normal-gradient-not-reciprocated", Q17_ROUTES.notRecip, `The sign changed but the fraction never turned over. The tangent's gradient is the negative reciprocal of ${M(flatex(Q17.g))}, which is ${M(fplain(Q17_M))}.`, 1, src("2022-summer", 8)),
      errNum("fm.calc.normal-gradient-not-reciprocated", Q17_ROUTES.same, `The normal's own gradient was used for ${M("\\frac{dy}{dx}")}. The derivative gives the tangent's gradient, so turn ${M(flatex(Q17.g))} into ${M(fplain(Q17_M))} first.`, 1, src("2022-summer", 8)),
      errNum("fm.calc.default-to-derivative-zero", Q17_ROUTES.zero, `The derivative was set equal to zero. The question gave the normal's gradient, so ${M("\\frac{dy}{dx}")} equals the tangent's gradient, ${M(fplain(Q17_M))}.`, 0, src("2025-summer", 13)),
    ],
    sources: [src("2022-summer", 8), src("2024-summer", 9)],
    program: `perp(${fplain(Q17.g)}) = ${fplain(Q17_M)}; 2a - ${Math.abs(Q17.b.n)} = ${fplain(Q17_M)} -> a = ${fplain(Q17_A)}`,
  }),
);

questions.push(
  single("0018", {
    difficulty: 1,
    verb: "write",
    commandWords: ["Write down"],
    setting: "The tangent's gradient read straight from a gradient function, the first rung",
    stem: `A curve has gradient function ${M(latex(Q18_D, { lhs: "\\frac{dy}{dx}" }))}.\nWrite down the gradient of the tangent to this curve at the point where ${M("x = 4")}.`,
    marks: 1,
    answer: ansNum(Q18_M),
    scheme: [Ws(1, 1, `${M(fplain(Q18_M))}`)],
    hints: ["The tangent's gradient is the value of $\\frac{dy}{dx}$ at the point."],
    worked: `Substitute ${M("x = 4")} into the gradient function: ${M(`2(4) - 5 = ${fplain(Q18_M)}`)}.`,
    errors: [
      errNum("fm.calc.normal-gradient-not-reciprocated", perp(Q18_M), "That is the gradient of the normal. The tangent's gradient is the value of $\\frac{dy}{dx}$ itself, with no reciprocal taken.", 0, src("2019-summer", 11)),
    ],
    sources: [src("2019-summer", 11)],
    program: `${plain(Q18_D)} at x = 4 -> ${fplain(Q18_M)}`,
  }),
);

questions.push(
  single("0019", {
    difficulty: 4,
    setting: "A horizontal tangent on a curve with a power of x underneath, the Summer 2018 shape",
    stem: `A curve has the equation ${M(latex(K19, { lhs: "y" }))}, where ${M("x > 0")}.\nFind the coordinates of the point on the curve at which the tangent is horizontal.`,
    marks: 4,
    answer: ansPoint(Q19_P),
    scheme: [
      Ms(1, 1, `writing the curve as ${M(latex(K19, { lhs: "y", style: "index" }))}`),
      MWs(1, 1, `${M(latex(deriv(K19), { lhs: "\\frac{dy}{dx}" }))}`, { dependsOn: ["M1"] }),
      Ms(2, 1, `setting ${M("\\frac{dy}{dx} = 0")} and reaching ${M(`x^{2} = ${fplain(fmul(Q19_P.x, Q19_P.x))}`)}`),
      Ws(1, 1, `${M(pointLatex(Q19_P.x, Q19_P.y))}`, { dependsOn: ["M2"], ft: true }),
    ],
    hints: ["Horizontal means $\\frac{dy}{dx} = 0$.", "Rewrite $\\frac{8}{x}$ as $8x^{-1}$ before differentiating.", "Multiply through by $x^{2}$ to clear the negative power."],
    worked: `Rewrite: ${M(latex(K19, { lhs: "y", style: "index" }))}, so ${M(latex(deriv(K19), { lhs: "\\frac{dy}{dx}" }))}.\nHorizontal means ${M("\\frac{dy}{dx} = 0")}, so ${M(`x^{2} = ${fplain(fmul(Q19_P.x, Q19_P.x))}`)}.\nSince ${M("x > 0")}, ${M(`x = ${fplain(Q19_P.x)}`)}, and the curve gives ${M(`y = ${fplain(Q19_P.y)}`)}.\nSo the point is ${M(pointLatex(Q19_P.x, Q19_P.y))}.`,
    errors: [
      errAlg("fm.calc.stationary-y-from-derivative", pointLatex(Q19_P.x, fr(0)), "The $x$-coordinate is right, so three marks stand. The second coordinate is the height of the curve there, not the gradient of zero.", 3, src("2025-summer", 11)),
      errAlg("fm.qin.context-not-applied", pointLatex(Q19_NEG.x, Q19_NEG.y), `The working is right, and ${M("x^{2} = 4")} has two roots. The question says ${M("x > 0")}, so ${M(`x = ${fplain(Q19_NEG.x)}`)} is ruled out and the point is ${M(pointLatex(Q19_P.x, Q19_P.y))}.`, 3),
    ],
    sources: [src("2018-summer", 7)],
    program: `solve ${plain(deriv(K19))} = 0 with x > 0 -> ${pointPlain(Q19_P.x, Q19_P.y)}`,
  }),
);

// --- exam-style ------------------------------------------------------------

const exA = single("0013", {
  style: "exam-style",
  difficulty: 4,
  ao: ["AO1", "AO2", "AO3"],
  setting: "A single seven-mark normal on a cubic, the shape of Summer 2023 Question 10",
  emphasis: ["in the form $y = mx + c$"],
  stem: `A curve has the equation ${M(latex(K.exA, { lhs: "y" }))}\nFind the equation of the normal to this curve at the point ${M(pointLatex(fr(-1), T.exA.y0))}.\nGive your answer in the form ${M("y = mx + c")}.`,
  marks: 7,
  answer: ansLine(T.exA.line, true),
  scheme: [
    MWs(1, 1, `${M(latex(deriv(K.exA), { lhs: "\\frac{dy}{dx}" }))}`),
    Ms(1, 1, `substituting ${M("x = -1")} into ${M("\\frac{dy}{dx}")}`),
    Ws(1, 1, `the tangent gradient ${M(fplain(T.exA.m))}`, { dependsOn: ["M1"] }),
    Ws(2, 1, `the normal gradient ${M(flatex(T.exA.g))}`, { ft: true }),
    Ms(2, 1, `checking or using ${M(`y = ${fplain(T.exA.y0)}`)} at ${M("x = -1")}`),
    Ms(3, 1, `substituting the point into ${M("y - y_{1} = m(x - x_{1})")}`),
    Ws(3, 1, `${M(lineLatex(T.exA.line))}`, { dependsOn: ["M3"], ft: true }),
  ],
  hints: [
    "Differentiate the cubic first: the derivative is a quadratic.",
    "Substitute $-1$ carefully, with brackets.",
    "Turn the tangent gradient over and change its sign.",
    "The point is given, so go straight to $y - y_{1} = m(x - x_{1})$.",
  ],
  worked: `${M(latex(deriv(K.exA), { lhs: "\\frac{dy}{dx}" }))}.\nAt ${M("x = -1")}: ${M(`3(-1)^{2} + 4(-1) - 4 = 3 - 4 - 4 = ${fplain(T.exA.m)}`)}.\nThe normal's gradient is ${M(`-\\frac{1}{${fplain(T.exA.m)}} = ${flatex(T.exA.g)}`)}.\nThe point is ${M(pointLatex(fr(-1), T.exA.y0))}, which the curve confirms: ${M(`-1 + 2 + 4 + 1 = ${fplain(T.exA.y0)}`)}.\n${M(`${fplain(T.exA.y0)} = ${flatex(T.exA.g)}(-1) + c`)} gives ${M(`c = ${flatex(T.exA.line.c)}`)}, so ${M(lineLatex(T.exA.line))}.`,
  errors: [
    errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(normalRoutes.notReciprocated(T.exA.m), fr(-1), T.exA.y0)), "The derivative and the substitution are right, so four marks stand. The normal's gradient needs the number turned over as well as the sign changed.", 4, src("2019-summer", 11)),
    errAlg("fm.calc.normal-sign-not-flipped", lineLatex(lineThrough(normalRoutes.signNotFlipped(T.exA.m), fr(-1), T.exA.y0)), "The reciprocal is there and the point is right. The sign still has to change, because the two gradients multiply to $-1$.", 4, src("2024-summer", 9)),
    constantSlipError(T.exA.g, fr(-1), T.exA.y0, "Gradient, reciprocal and point are all right, so six marks stand.", 6, src("2023-summer", 10)),
    errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(T.exA.m, fr(-1), T.exA.y0)), "That is the tangent at the point, and the working behind it is sound. The question asked for the normal, which is perpendicular to it.", 4, src("2019-summer", 11)),
  ],
  sources: [src("2019-summer", 11), src("2023-summer", 10)],
  program: `normal to ${plain(K.exA)} at x = -1 -> ${linePlain(T.exA.line)}`,
  figures: [],
});

const exB = {
  id: id("q", "0014"),
  topic: TOPIC,
  specRefs: SPEC,
  tier: "untiered",
  paper: PAPER,
  style: "exam-style",
  difficulty: 5,
  ao: ["AO1", "AO2", "AO3"],
  commandWords: ["Find"],
  emphasis: ["parallel to the straight line"],
  context: { setting: "A gradient condition that fixes an unknown coefficient, then the tangent and normal that follow", original: true },
  figures: [dataFigure(givenSvg, "A curve drawn on axes with a dashed tangent parallel to a second dashed straight line, the point of contact marked P.")],
  parts: [
    {
      id: "a",
      stem: `At the point ${M("P")}, where ${M("x = -2")}, the tangent to ${M(latex(EXB_CURVE, { lhs: "y" }).replace(String(EXB_A.n), "a"))} runs parallel to the straight line ${M(lineLatex({ m: EXB.lineM, c: EXB.lineC }))}\nFind the value of ${M("a")}.`,
      marks: 4,
      answer: ansNum(EXB_A),
      scheme: [
        Ms(1, 1, `writing the curve as ${M("y = 3 + ax^{-2}")}`),
        MWs(1, 1, `${M("\\frac{dy}{dx} = -2ax^{-3}")}`, { dependsOn: ["M1"] }),
        Ms(2, 1, `setting ${M("\\frac{dy}{dx}")} at ${M("x = -2")} equal to ${M(fplain(EXB.lineM))}`),
        Ws(1, 1, `${M(`a = ${fplain(EXB_A)}`)}`, { dependsOn: ["M2"], ft: true }),
      ],
      hints: [
        "Parallel lines have equal gradients, so $\\frac{dy}{dx}$ at $P$ is the line's gradient.",
        "Write the curve with a negative index before differentiating.",
        "$\\frac{dy}{dx} = -2ax^{-3}$, and $(-2)^{3} = -8$.",
      ],
      workedSolution: `Write the curve as ${M("y = 3 + ax^{-2}")}, so ${M("\\frac{dy}{dx} = -2ax^{-3}")}.\nAt ${M("x = -2")}: ${M("\\frac{-2a}{-8} = \\frac{a}{4}")}.\nParallel to ${M(lineLatex({ m: EXB.lineM, c: EXB.lineC }))} means that gradient is ${M(fplain(EXB.lineM))}, so ${M(`\\frac{a}{4} = ${fplain(EXB.lineM)}`)} and ${M(`a = ${fplain(EXB_A)}`)}.`,
      commonErrors: [
        errNum("fm.calc.equate-line-and-curve-instead-of-differentiate", EXB_A_EQUATED, "The curve was set equal to the line instead of being differentiated. Parallel is a statement about gradients, so the derivative is what the line's gradient is compared with.", 0, src("2024-summer", 9)),
        errNum("fm.calc.negative-power-differentiation", EXB_A_SIGNKEPT, "The index stepped down correctly. Multiplying $a$ by the power $-2$ makes the derivative negative, which changes the sign of the answer.", 2, src("2025-summer", 8)),
        errNum("fm.calc.power-not-reduced", EXB_A_POWERKEPT, "The coefficient is handled correctly. The index still has to step down, from $-2$ to $-3$, before $-2$ is substituted.", 2, src("2025-summer", 8)),
      ],
      requiresWorking: true,
    },
    {
      id: "b",
      stem: `Find the equation of the tangent to this curve at ${M("P")}.`,
      marks: 3,
      answer: ansLine(EXB_T.line),
      scheme: [
        MWs(1, 1, `${M(`y = ${fplain(EXB_T.y0)}`)} at ${M("x = -2")}, from the curve`),
        Ms(1, 1, `substituting the point and ${M(`m = ${fplain(EXB_T.m)}`)} into the line formula`),
        Ws(1, 1, `${M(lineLatex(EXB_T.line))}`, { dependsOn: ["M1"], ft: true }),
      ],
      hints: ["The gradient is the one the question gave you.", "Find the height by substituting $-2$ into the curve with your value of $a$.", "Then build the line."],
      workedSolution: `With ${M(`a = ${fplain(EXB_A)}`)} the curve is ${M(latex(EXB_CURVE, { lhs: "y" }))}, so at ${M("x = -2")}, ${M(`y = 3 + \\frac{8}{4} = ${fplain(EXB_T.y0)}`)}.\nThe tangent's gradient is ${M(fplain(EXB_T.m))}, so ${M(`${fplain(EXB_T.y0)} = ${fplain(EXB_T.m)}(-2) + c`)} and ${M(`c = ${fplain(EXB_T.line.c)}`)}.\nThe tangent is ${M(lineLatex(EXB_T.line))}.`,
      commonErrors: [
        errAlg("fm.calc.y-from-line-not-curve", lineLatex({ m: EXB.lineM, c: EXB.lineC }), "The height of $P$ was taken from the given straight line rather than from the curve, which reproduces that line exactly. Substitute $-2$ into the curve instead.", 1, src("2024-summer", 9)),
        constantSlipError(EXB_T.m, EXB.x0, EXB_T.y0, "The gradient and the point are right.", 2, src("2023-summer", 10)),
      ],
      requiresWorking: true,
      followThrough: { fromPart: "a", rule: "use-candidate-value" },
    },
    {
      id: "c",
      stem: `Find the equation of the normal to this curve at ${M("P")}.\nGive your answer in the form ${M("y = mx + c")}.`,
      marks: 2,
      answer: ansLine(EXB_N.line, true),
      scheme: [
        Ws(1, 1, `the normal gradient ${M(flatex(EXB_N.g))}`, { ft: true }),
        Ws(2, 1, `${M(lineLatex(EXB_N.line))}`, { ft: true }),
      ],
      hints: ["Turn the tangent's gradient over and change the sign.", "The point is the same one you used in part (b)."],
      workedSolution: `The tangent's gradient is ${M(fplain(EXB_T.m))}, so the normal's is ${M(flatex(EXB_N.g))}.\nThrough ${M(pointLatex(EXB.x0, EXB_T.y0))}: ${M(`${fplain(EXB_T.y0)} = ${flatex(EXB_N.g)}(-2) + c`)} gives ${M(`c = ${fplain(EXB_N.line.c)}`)}.\nThe normal is ${M(lineLatex(EXB_N.line))}.`,
      commonErrors: [
        errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(normalRoutes.notReciprocated(EXB_T.m), EXB.x0, EXB_T.y0)), "The point is right. The normal's gradient needs the number turned over as well as the sign changed; here only the sign changed.", 1, src("2024-summer", 9)),
        errAlg("fm.calc.normal-sign-not-flipped", lineLatex(lineThrough(normalRoutes.signNotFlipped(EXB_T.m), EXB.x0, EXB_T.y0)), "The reciprocal is there. The sign still has to change for the two gradients to multiply to $-1$.", 1, src("2024-summer", 9)),
      ],
      requiresWorking: true,
      followThrough: { fromPart: "b", rule: "use-candidate-value" },
    },
  ],
  totalMarks: 9,
  timeAllowanceSec: timeFor(9),
  skeleton: "(a)find4|(b)find3|(c)find2",
  examinerSources: [src("2024-summer", 9)],
  solutionProgram: `a = ${fplain(EXB_A)}; tangent ${linePlain(EXB_T.line)}; normal ${linePlain(EXB_N.line)}`,
  verification: `ver.${id("q", "0014")}`,
  version: 1,
};

const exC = {
  id: id("q", "0015"),
  topic: TOPIC,
  specRefs: SPEC,
  tier: "untiered",
  paper: PAPER,
  style: "exam-style",
  difficulty: 4,
  ao: ["AO1", "AO2"],
  commandWords: ["Find"],
  emphasis: ["the gradient of the normal is"],
  context: { setting: "One curve, a tangent at a named point and a point found from a stated normal gradient", original: true },
  figures: [],
  parts: [
    {
      id: "a",
      stem: `A curve has the equation ${M(latex(K.exC, { lhs: "y" }))}\nFind the equation of the tangent to this curve at the point where ${M("x = 4")}.`,
      marks: 4,
      answer: ansLine(T.exC.line),
      scheme: [
        MWs(1, 1, `${M(latex(deriv(K.exC), { lhs: "\\frac{dy}{dx}" }))}`),
        Ws(1, 1, `${M(`m = ${fplain(T.exC.m)}`)}`, { ft: true }),
        Ms(1, 1, `the point ${M(pointLatex(fr(4), T.exC.y0))} substituted into the line formula`),
        Ws(2, 1, `${M(lineLatex(T.exC.line))}`, { dependsOn: ["M1"], ft: true }),
      ],
      hints: ["Differentiate, then substitute 4.", "Find the height from the curve.", "$y - y_{1} = m(x - x_{1})$."],
      workedSolution: `${M(latex(deriv(K.exC), { lhs: "\\frac{dy}{dx}" }))}, so at ${M("x = 4")} the gradient is ${M(fplain(T.exC.m))}.\nFrom the curve, ${M(`y = 16 - 8 + 5 = ${fplain(T.exC.y0)}`)}.\n${M(`y - ${fplain(T.exC.y0)} = ${fplain(T.exC.m)}(x - 4)`)} gives ${M(lineLatex(T.exC.line))}.`,
      commonErrors: [
        constantSlipError(T.exC.m, fr(4), T.exC.y0, "The gradient and the point are right, so three marks stand.", 3, src("2023-summer", 10)),
        errAlg("fm.calc.normal-gradient-not-reciprocated", lineLatex(lineThrough(perp(T.exC.m), fr(4), T.exC.y0)), "That is the normal at the same point. The question asked for the tangent, which keeps the gradient the derivative gave you.", 2, src("2019-summer", 11)),
      ],
      requiresWorking: true,
    },
    {
      id: "b",
      stem: `At the point ${M("A")} on this curve the normal has gradient ${M(flatex(EXC_G))}.\nFind the coordinates of ${M("A")}.`,
      marks: 3,
      answer: ansPoint(EXC_A),
      scheme: [
        Ws(1, 1, `the tangent gradient ${M(fplain(EXC_M))}`),
        Ms(1, 1, `setting ${M(`${latex(deriv(K.exC))} = ${fplain(EXC_M)}`)}`),
        Ws(2, 1, `${M(pointLatex(EXC_A.x, EXC_A.y))}`, { dependsOn: ["M1"], ft: true }),
      ],
      hints: ["Work the negative reciprocal backwards to get the tangent's gradient.", "Set $\\frac{dy}{dx}$ equal to it.", "Then find $y$ from the curve and write the coordinates."],
      workedSolution: `The normal has gradient ${M(flatex(EXC_G))}, so the tangent has gradient ${M(fplain(EXC_M))}.\n${M(`2x - 2 = ${fplain(EXC_M)}`)} gives ${M(`x = ${fplain(EXC_A.x)}`)}.\nFrom the curve, ${M(`y = 9 + 6 + 5 = ${fplain(EXC_A.y)}`)}.\nSo ${M("A")} is ${M(pointLatex(EXC_A.x, EXC_A.y))}.`,
