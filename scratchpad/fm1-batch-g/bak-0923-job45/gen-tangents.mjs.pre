/**
 * Depth pass, 23 Sep: the practice ladder runs rung by rung (difficulty 1 to 5), then the exam-style set. Ids are
 * unchanged; only the order in which the practice flow meets the questions moves.
 */
const LADDER = ["0018", "0001", "0002", "0004", "0003", "0005", "0006", "0007", "0010", "0008", "0009", "0011", "0012", "0019", "0017", "0013", "0015", "0014", "0016"];
const allQuestions = (() => {
  const all = [...questions, exA, exB, exC, exD];
  if (LADDER.length !== all.length || new Set(LADDER).size !== LADDER.length) throw new Error("the ladder must name every question once");
  const out = LADDER.map((n) => {
    const q = all.find((x) => x.id === id("q", n));
    if (!q) throw new Error(`the ladder names q ${n}, which does not exist`);
    return q;
  });
  const practice = out.filter((q) => q.style === "practice");
  practice.forEach((q, i) => {
    if (i > 0 && q.difficulty < practice[i - 1].difficulty) throw new Error(`the ladder steps down at ${q.id}`);
  });
  if (out.slice(out.findIndex((q) => q.style === "exam-style")).some((q) => q.style === "practice")) throw new Error("a practice question sits among the exam-style set");
  return out;
})();

