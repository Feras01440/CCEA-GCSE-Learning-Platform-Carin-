{
  "name": "ccea-gcse-top-learning-platform",
  "version": "0.1.0",
  "description": "CCEA GCSE study platform: Mathematics, Further Mathematics, Double Award Science",
  "scripts": {
    "dev": "next dev",
    "build": "tsx pipeline/build-content.mts && tsx pipeline/build-decks.mts && next build && node scripts/fix-export.mjs && node scripts/build-sw.mjs",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "spec:science": "node scripts/build-science-spec.mjs",
    "spec:extract": "node scripts/extract-spec-pdf.mjs",
    "papers:index": "node scripts/build-papers-index.mjs",
    "papers:corpus": "node scripts/download-papers-corpus.mjs",
    "papers:mine": "node scripts/mine-papers.mjs",
    "test": "vitest run",
    "schema:export": "tsx scripts/export-json-schema.mjs",
    "spec:fm": "node scripts/build-fm-spec.mjs",
    "spec:fm:validate": "node scripts/validate-fm-spec-json.mjs",
    "content:build": "tsx pipeline/build-content.mts",
    "packs:build": "node scripts/build-pack-manifests.mjs",
    "packs:validate": "tsx scripts/validate-packs.mjs",
    "insights:build": "node pipeline/mine/build-insights.mjs",
    "insights:validate": "tsx scripts/validate-insights.mjs",
    "insights:unregistered": "node scripts/find-unregistered-misconceptions.mjs",
    "decks:build": "tsx pipeline/build-decks.mts",
    "sw:build": "node scripts/build-sw.mjs",
    "e2e": "playwright test",
    "e2e:serve": "serve out -l 3200",
    "content:check": "tsx pipeline/build-content.mts --strict && node scripts/qa/lesson-v2.mjs && tsx scripts/qa/marking-guard.mts --quiet",
    "marking:guard": "tsx scripts/qa/marking-guard.mts",
    "export:fix": "node scripts/fix-export.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@cortex-js/compute-engine": "^0.120.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "jsxgraph": "1.13",
    "katex": "^0.18.5",
    "lucide-react": "^1.39.0",
    "mafs": "^0.21.0",
    "mathlive": "^0.110.0",
    "motion": "^13.1.1",
    "next": "^16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
